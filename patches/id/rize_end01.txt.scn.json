{
  "identity": "rize_end01.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "チノちゃん、\\nそろそろお店、開けちゃおっか。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "開店時間には少し早いですよ？\\nリゼさんも着替え終わっていません。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "でも、もう準備終わっちゃってるし。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "それは、ココアさんが珍しく早く起きてきて、\\n勝手に準備を始めていたからじゃないですか。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "てへへ～。\\nだって今日は早く目が覚めちゃったから、\\n寝てるのがもったいなくて。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "それにね、昨日のパーティーの余韻が残ってて\\nすっごくいい気分なんだ～。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "それは……私もですね。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "でしょ？\\nさあ！　お店を開けて、\\nこのいい気分をお客さんにもお届けしよう！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "だ、だから、リゼさんがまだ……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "ああ、そういえばリゼちゃん、\\n来た時すごく慌ててたよね。\\n何かあったのかな？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "とりあえず着替えてくると言ってましたが――",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "ココア、チノ！\\nおはよう！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "おはよう、リゼちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "おはようございます。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "ほ、本当にすまない！\\nまさか、こんな失態を犯すなんて！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "大丈夫ですよ。\\n確かにココアさんは起きてますが、\\nまだ遅刻ではありません。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "どういう意味！？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "リゼ",
          "original": "そうじゃないんだ！\\n昨日、すっかり忘れていて！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "昨日？　忘れてたって何を？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "リゼ",
          "original": "パーティーに夢中になって、\\nクリスマスプレゼントを渡すのを忘れていたんだ！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "ああ、そういえばもらってないね。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "確かに……。\\nですが、特に気にしていませんでしたし、\\nそんなに慌てることではないですよ。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "リゼ",
          "original": "だ、だが、サンタの格好まで\\nしていたのに、私は……！\\n本当にすまなかった！",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "今さらだが……受け取ってもらえるか？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "うん、もちろん！",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "はい、嬉しいです。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "リゼ",
          "original": "よかった。\\nじゃあ、これを。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "ありがと～！\\nねえ、開けていいかな？",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "リゼ",
          "original": "ああ。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "それじゃ、さっそく！",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "ココア",
          "original": "うわぁ～！　かわいいマフラー！",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "リゼ",
          "original": "欲しいと言っていたからな。\\nココアに似合う色で、\\n暖かそうなやつを選んでみたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ココア",
          "original": "うん！\\nこれ、すっごく温かいよ。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "チノ",
          "original": "私のは……ピンセットですね。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "リゼ",
          "original": "ああ。\\n詳しくないなりに調べてみたんだが、\\nそれでいいんだよな？",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "チノ",
          "original": "はい、ちゃんとボトルシップ作成用のものです。\\nこれで製作が捗ります、ありがとうございます。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "リゼ",
          "original": "いや、喜んでもらえて何よりだ。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "ココア",
          "original": "ところで、プレゼントって私たちにだけ？\\nシャロちゃんとか千夜ちゃんには？",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "リゼ",
          "original": "それなら、ここに来る前に渡してきたよ。\\nあと、マヤとメグの分もあるんだが……。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "チノ",
          "original": "マヤさんたちなら、\\n今日、ここに遊びにくると言ってました。\\nその時に渡してください。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "リゼ",
          "original": "そうか、よかった。",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "リゼ",
          "original": "いや、しかし、私は本当に何をやってるんだろうな。\\nあんなに張り切っていたのに、プレゼントを\\n渡し忘れてしまうなんて。",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "ココア",
          "original": "それだけパーティーを楽しんでたんだから、\\n気にすることないよ。",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "リゼ",
          "original": "だとしてもだ。\\n自分が抜けているということに変わりはない。\\nなんとも情けないよ。",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "リゼ",
          "original": "その……なんていうか……\\nこんな間抜けな私だが、\\nこれからもよろしく頼むな。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "ココア",
          "original": "そんなの、こっちこそだよ。\\nこれからもリゼちゃんに頼りっぱなしに\\nなるかもしれないけど、よろしくね。",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "チノ",
          "original": "私も頼りにしています。\\nよろしくお願いします、リゼさん。",
          "translation": "",
          "status": "untranslated"
        },
        "47": {
          "speaker": "リゼ",
          "original": "あ、ああ！\\n私なりに精一杯、やらせてもらうよ。",
          "translation": "",
          "status": "untranslated"
        },
        "48": {
          "speaker": "ココア",
          "original": "ねえ、チノちゃん、\\n今日はこのマフラーつけたまま仕事していいかな？",
          "translation": "",
          "status": "untranslated"
        },
        "49": {
          "speaker": "チノ",
          "original": "ええっ？\\nそれはちょっと……。",
          "translation": "",
          "status": "untranslated"
        },
        "50": {
          "speaker": "ココア",
          "original": "えー、だめかな？\\nせっかくのプレゼントなのに。",
          "translation": "",
          "status": "untranslated"
        },
        "51": {
          "speaker": "リゼ",
          "original": "だめというか、暑いだろ？\\nそれに何かに引っ掛けたりしたら大変だ。",
          "translation": "",
          "status": "untranslated"
        },
        "52": {
          "speaker": "リゼ",
          "original": "気に入ってくれたのは嬉しいが、\\n外に出かける時に使ってくれ。",
          "translation": "",
          "status": "untranslated"
        },
        "53": {
          "speaker": "ココア",
          "original": "うん！\\nじゃあ、さっそく外出の予定を作らないとね。",
          "translation": "",
          "status": "untranslated"
        },
        "54": {
          "speaker": "リゼ",
          "original": "おっと！\\nお客さんが来たみたいだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "55": {
          "speaker": "チノ",
          "original": "もう開店時間になっていたんですね。\\n準備はできていますし、大丈夫です。",
          "translation": "",
          "status": "untranslated"
        },
        "56": {
          "speaker": "ココア",
          "original": "うん！\\nじゃあ、せーの！",
          "translation": "",
          "status": "untranslated"
        },
        "57": {
          "speaker": "リゼ＆ココア＆チノ",
          "original": "いらっしゃいませ！\\nラビットハウスへようこそ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}