{
  "identity": "flyer_syaro_f3.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はシャロちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "シャロちゃん？\\n大きなため息だけど、どうしたの？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "サンタ……。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "うん、今着てるのは\\nサンタさんっぽい服だよね。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "クリスマス……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "うん、サンタさんと言えばクリスマスだよね。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "はああ……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "それがどうして溜息になるの？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "……クリスマスって、\\nあまりいい思い出がないの。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "え？\\nクリスマスって、楽しいものじゃないの？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ツリーを飾って、ご馳走を食べて、\\nケーキも食べて、プレゼントもらって。\\nほら、楽しいことばかりだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "そういう『普通の』クリスマスが\\nできれば、楽しいんでしょうけどね。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "あ、ごめん！\\n悪いこと言っちゃった……？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "気にしないでいいわ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "それに、逆に考えてみたら\\nクリスマスの時期は時給がよくなるし、\\n私にとってはかき入れ時なの。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "年末まで、時間を上手くやりくりすれば\\n普段よりずっとバイト代が溜まるはず。\\nきっちり予定を組まなくちゃ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "ねえ、シャロちゃん！\\n今年のクリスマスは一緒に楽しもうよ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "ココアサンタが、シャロちゃんに\\n素敵なクリスマスをプレゼントするよ！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "そう、シャロちゃんが楽しいって思えるような\\nクリスマスを。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "ココア……。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "あ、嘘だと思ってる？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "ふぉっふぉっふぉ～。\\n安心せい、ココアサンタは嘘をつかぬのじゃ～。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "あ、もちろんシャロちゃんだけじゃなくて\\nチノちゃんたちにも素敵なクリスマスを\\nプレゼントしないとね！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "ふぉっふぉっふぉ～。\\nココアサンタは大忙しじゃの～。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "シャロ",
          "original": "ふふっ！\\nあんたって子は……。\\nまあ、期待しないで待ってるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "あ、シャロちゃん、笑った！",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "シャロ",
          "original": "わ、笑ってないわ！\\nほら、喋ってたら時間が過ぎちゃった。\\n急いでチラシを配るわよ。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "はーい！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}