{
  "identity": "flyerhap_rize_h.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "リゼちゃん！\\nチラシ配り、一緒にやらない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "ああ、それなんだが、\\n今日はみんな揃って配ることができそうだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "じゃあ、せっかくだし、みんなでやろうか。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "うっ、くっしゅん！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "あれ？\\nリゼちゃん、もしかして風邪？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "いや、特に不調は感じてないんだが。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "念のため、帰った方がいいんじゃないですか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "はい。\\n無理をしてもいいことはありません。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "大丈夫、ちょっと冷えただけだよ。\\n家に帰ったら、風邪を引かないように\\n温かい物を飲んで、ちゃんとしておくから。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "じゃあ、それまでのあいだは私に任せて？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "は？　任せろって何がだ？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "いつもリゼちゃんには\\nお店を守ってもらってるから、\\nこんな時ぐらい私がリゼちゃんを守るよ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "リゼさんはガードマンじゃないです。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "そうだ！\\n私は普通の店員だ！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "とにかく！\\n私はこの北風からリゼちゃんを守ってみせるよ！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "千夜",
          "original": "具体的には何をするの？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "具体的には、えーっと……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "考えてなかったんですね。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "あ、そうだ！\\n押しくらまんじゅうをしよう！\\nこれならみんなで温まれるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "ここでそんなことしてたら\\n周りの人に変な目で見られるわよ？\\nお店の評判にも関わるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "そ、それはだめー！\\nラビットハウスは真面目なお店なんだから！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "うーん……。\\nじゃあ、私が風よけになるのはどうかな？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "リゼ",
          "original": "風よけ？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "風は……こっちから吹いてるね。\\nさあ、リゼちゃん私の背中で風をよけて！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "あ、ああ。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "どう？　風から守られてる？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "あ、風向きが変わったわね。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "今度はこっちだね！\\nリゼちゃんに冷たい風は当てさせないよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "千夜",
          "original": "今度はこっちね。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "私が必ず守るんだから～！",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "チノ",
          "original": "こっちからも吹いてきます。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "ええええっ！？\\nさすがに分身はできないよ！",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "じゃあ、こうなったら……\\nリゼちゃん、ちょっと屈んでみて？",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "リゼ",
          "original": "ん？　こうか？",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "ココア",
          "original": "そうそう。\\nじゃあ、えいっ！",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "リゼ",
          "original": "うわ！？\\n急に何するんだ、ココア！",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "どう？\\nこれなら、どこから風が吹いても守れるし\\nすごく温かいでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "リゼ",
          "original": "確かに温かいが、\\nこれはちょっと……はずかしいだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "ココア",
          "original": "ちょっとだけ我慢だよ、リゼちゃん。\\n温かいのとはずかしいのを\\n交換するつもりになろう。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "リゼ",
          "original": "ど、どういう交換だ。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "ココア",
          "original": "えへへ、こうしていると私も温かいなぁ。\\n２人とも仲良くぽかぽかになれる、いい方法だね。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "リゼ",
          "original": "お前、実は自分が温まりたいだけじゃないか？",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "ココア",
          "original": "偶然だよ、偶然。\\nじゃあ、これをココアカイロと名付けよっかな。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "シャロ",
          "original": "ココアってば先輩とあんなに近づいて……！\\nうらやましい～！",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "千夜",
          "original": "シャロちゃん、私のマントに入る？",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "シャロ",
          "original": "入らないわよー！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}