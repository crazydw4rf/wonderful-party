{
  "identity": "syaro_a04.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "はぁ～、どうしよう……。\\nこんなはずじゃなかったのに……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "（とりあえず、休み時間に試験勉強をするのは\\n　無理があるわね……）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "（頭を切り替えるのが難しいし、\\n　次の授業の準備とか、場合によっては\\n　移動教室だったりするわけだし）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "（それに、当然と言えば当然だけど、\\n　毎日の課題、予習や復習だってあるから、\\n　家に帰ってからも勉強しないわけにはいかない）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "（これは、思ってた以上に\\n　パーティーのことを考える余裕がないわね）",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "（このままじゃ、期末試験が終わっても\\n　パーティーの準備を始められそうも\\n　ないじゃない）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "（こうなったら、睡眠時間を削るしかないかしら。\\n　徹夜は無理でも、少しくらい寝る時間が\\n　短くなっても――）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "（でも、それで次の日に眠くなったりしたら\\n　本末転倒よね……）",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "（授業中に居眠りなんてできない。\\n　バイト中にうとうとしてるわけにもいかない）",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "（うう……。\\n　いっそ割り切って、期末試験が終わるまで\\n　パーティーのことを忘れて――）",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "（だめ、それもできないわ。\\n　私に主催を任せてくれたみんなを\\n　裏切ることになっちゃうみたいで……）",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "（でも、このままじゃ\\n　何もかもが中途半端になる……）",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "おーい、シャロ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "あ、先輩、こんにちは――",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "って、リゼ先輩！\\nどうしてこんなところに！？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "なんだ、そんなに驚くことないだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "だって、先輩の家は\\nこっちの方向じゃないですよね？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "ああ、いや、その……\\nちょっとシャロに用があってさ。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "えっ！？　私に？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "今、バイトの帰りだよな。\\nこのあと何か用事があるのか？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "いえ、今日はもう家に帰るだけです。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "リゼ",
          "original": "よかった。\\nなら、私に付き合ってくれないか？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "こ、これからですか！？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "リゼ",
          "original": "もちろん、時間があればで構わない。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "シャロ",
          "original": "ありますっ！\\nなかったとしても、先輩のためなら\\nいくらでも作ります！",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "リゼ",
          "original": "いや、別に無理にとは言わないんだが。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "シャロ",
          "original": "大丈夫です、無理なんてちっともしてませんから！\\nどこにでも付き合います！\\nさあ、行きましょう！",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "リゼ",
          "original": "あ、ああ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}