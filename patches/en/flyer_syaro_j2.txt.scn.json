{
  "identity": "flyer_syaro_j2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はシャロちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "あうう……。\\n私……もうだめ……。\\nもう、いっそ一息に……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "ちょっと、ココア！？\\n急にどうしちゃったのよ？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "お、おいしそうな匂いがする……。\\n周りのおうちから、夕飯の支度をする\\nおいしそうな匂いが……！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "ああ……。\\n気にしちゃだめよ。\\n家に帰れば夕飯が待ってるでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "あっちのおうちからはバターの香りが……\\n何を焼いてるのかな……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "だから、そんな話やめてよ。\\n私までお腹が空いてくるじゃない。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "こっちの匂いはドミグラスソースかな？\\nということは、きっとビーフシチューだね。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "ドミグラスソースなら、\\n煮込みハンバーグってことも\\nあるかもしれないわよ？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "煮込みハンバーグ！\\nいいなぁ、おいしそう～。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "近いうちに作ろうっと。\\nチノちゃんと一緒に、ハンバーグの生地を\\nコネコネするんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "この時間だと、どこのお家でも夕飯の準備中よね。\\n匂いが混じって何が何だかわからなくなってきた。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "でも、これなら食欲そそられなくて、\\nもうひと頑張りできるかも。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "それじゃ、さっさとやっちゃいましょ。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "……は！？　これは！！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "ううっ！\\nこのお腹にダイレクトにくる香辛料の匂いは……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア＆シャロ",
          "original": "カレー！？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "今までの匂いを掻き消して、\\nすべてをカレーが支配してるよ！？\\nこのあたり、全部カレーフィールドだよ！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "カレーの匂いって最強よね。\\nこれは勝てないわ……。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "うわーん、お腹空いたよー！\\nカレー食べたーい！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "シャロ",
          "original": "私だってそうよー！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}