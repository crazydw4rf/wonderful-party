{
  "identity": "flyerhap_rize_c.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "リゼちゃん！\\nチラシ配り、一緒にやらない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "ああ、それなんだが、\\n今日はみんな揃って配ることができそうだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "じゃあ、せっかくだし、みんなでやろうか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "きゃあっ！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "シャロちゃん！？\\n大丈夫？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "いたたた……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "転んだのか？\\n大丈夫か、シャロ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "あっ、だ、大丈夫です。\\nすみません、驚かせちゃって。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "謝ることないって。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "もしかして、慣れない和服で\\n裾さばきがうまくいかなかったの？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "それもあるけど……\\nあいつにびっくりしちゃって。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "不良野良うさぎね。\\nまさか噛みつかれたりしたの？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "ううん、いつの間にか足元に\\nいただけなんだけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "千夜",
          "original": "大丈夫？　立てる？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "待て、無理に立とうとするな。\\nケガしてたら大変だろ。\\nまずは確認だ、ちょっと触るぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "えっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "どうだ、痛むか？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "だだだだ、大丈夫です！\\n痛くないし、せ、せ、先輩の手が、手が、\\nありがとうございます！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "おいおい、落ち着け。\\nじゃあ、軽く曲げてみてくれ。\\n痛かったらすぐに言うんだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "はひっ！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "……うん、骨に異常がある様子はないな。\\n大ケガじゃないみたいだ。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "は、はい。\\nそれほど痛くないし、軽い打ち身だと思います。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "でも心配だわ。\\n今日はもう、安静にした方がいいわね。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "大丈夫よ。\\n千夜ったら大げさなんだから。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "でも、痛いんでしょ？\\n体は大事にしなくちゃだめだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "リゼ",
          "original": "ああ、とりあえず\\nチラシ配りが終わるまではじっとしてろ。\\n休めるところまで運んでやるから。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "運ぶっ！？\\nせ、先輩にそんなことさせられません！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "気にするなって。\\nじゃあ、しっかり掴まれよ。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "シャロ",
          "original": "え、そんな、リゼ先輩！？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "よっと！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "シャロ",
          "original": "ほああああ～……。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア＆チノ",
          "original": "まさかのお姫様抱っこ！？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "千夜",
          "original": "まあまあ！\\nさすがはリゼちゃんねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "リゼ",
          "original": "ん？　どういう意味だ？",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "だって、普通の女の子にはなかなかできないよ。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "リゼ",
          "original": "なっ！？　できないのか！？\\nそりゃ、チノは無理だろうけど\\nココアと千夜なら……。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "千夜",
          "original": "私も無理ねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "ココア",
          "original": "うん、私も。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "リゼ",
          "original": "わ、わあ！　重いなー！\\nいや、シャロが重いっていう意味じゃなくて\\n女の細腕には余るよな～！",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア＆チノ",
          "original": "とってつけたようだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "リゼ",
          "original": "そういうわけだからな？\\n急いで運ぶからじっとしててくれよ、シャロ。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "シャロ",
          "original": "あ、はい……。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "リゼ",
          "original": "ちゃんと抱えてるから安心しろ。\\nシャロを落っことしたりなんてしないからな。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "シャロ",
          "original": "ありがとうございます、先輩‥…！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}