        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ラビットハウスの開店記念日！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "違います。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "あれっ！？\\n結構、自信があったんだけどな～。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "どうして自信が持てるのか、\\nさっぱりわかりません……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "でも、ラビットハウスの開店記念日には\\n何かやりたいね。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "ラビットハウスが生まれた、\\n特別な日なんだから！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "はい、そうですね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "もふもふ記念日！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "も、もふもふ記念日？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そう！\\nこの世のすべてのもふもふに感謝する日だよ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "それは、確かに必要な日かもしれません！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "でしょでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "じゃあ、ラビットハウスでは、１２月４日は\\nティッピーをもふもふし放題にして\\nもふもふに感謝するのはどうかな？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "え？　それって感謝してることになるんですか？\\nむしろ、大変な目にあわせてますよ？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "妹記念日！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "言うと思いました。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "えっ！？\\nなんでわかったの！？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "あ、でも、妹記念日がどうなるかは\\nこれからのチノちゃん次第なんだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "どういうことですか？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "この１２月４日に\\nチノちゃんが私に何かしてくれたら\\n『妹がお姉ちゃんのために記念日』で――",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "私がチノちゃんのために何かしたら、\\n『お姉ちゃんが妹のために記念日』！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "……なんとしても\\n記念日にするつもりじゃないですか。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "あれ？　だめ？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "だめです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "タカヒロ",
          "original": "お邪魔するよ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "あれっ！？\\nおじさん、どうしたんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "タカヒロ",
          "original": "部屋に物を取りに来ただけだよ。\\nすぐに戻るさ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "あ、そうだ！\\n聞きたいことがあるんです。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "タカヒロ",
          "original": "ん？　何かな？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "あっ……！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "あのカレンダー、１２月４日に\\nマルが書いてあるのはなんでですか？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "タカヒロ",
          "original": "ああ、それは――",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "ま、待って……！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "タカヒロ",
          "original": "１２月４日は、チノの誕生日なんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "ああ……言っちゃった……。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "ええええええええ～！！\\nチノちゃんのお誕生日～！？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "チノちゃんっ！！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "な、なんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "どうしてそんな大切な日を、\\nお姉ちゃんに教えてくれなかったの！？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "だって、自分から誕生日のことを言い出すなんて、\\nプレゼントをねだってるみたいで……\\nあつかましいです。",
          "translation": "",
          "status": "untranslated"
