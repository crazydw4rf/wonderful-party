{
  "identity": "rize_a04.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "すまない、遅くなった。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "あ、リゼちゃん。\\n大丈夫だよ、そこまで大変じゃなかったし。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "そう言ってもらえると助かるよ。\\nけど、ずいぶん席が埋まってるな。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "うん！\\nえへへ～、チラシ配りの効果は\\nまだまだ続いているみたいだね。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "ココアさんのアイディアも、\\nたまには役に立ちますね。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "おお！？\\nチノちゃんに褒められた！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "いや待て、今のは褒められたのか？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "だって、役に立つって言ってくれたよ？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "……まあ、お前がそれで納得してるなら\\n構わないけどな？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "ココアさん、オーダー上がりました。\\nブルーマウンテンを２つ、\\n２番テーブルのお客さんにお願いします。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "はーい。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "チノ",
          "original": "……はあ。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "あんな風に喜ばれてしまっては、\\nなんだか申し訳ない。\\n――そんな感じか？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "え、ええ、その……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "だったら、皮肉なんかじゃなくて\\n素直に褒めてやればいいじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "それはそれで……\\n調子に乗られそうで嫌ですから。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "（なるほど、素直には言えないってことか。\\n　チノらしいな）",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "ん？　２人でなんの話してたの？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "別に、なんでもありません。\\nそれよりも、お客さんに何か言われてましたよね。\\n追加オーダーですか？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "あ、ううん、違うの。\\n今年も、クリスマスに特別なメニューを\\n出したりするんですかって聞かれて。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "ああ、毎年出してるから\\n探りを入れてきたわけか。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "まだ決まってませんって答えたら、\\n楽しみにしてますよって言われちゃった。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "ねえねえ、今年は何を作るの？\\n私、決めるのに協力するよ！",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "大丈夫です。\\nそれについては、私と父で決めました。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "えー、いつの間に！？\\n私、アイディア出したかった……。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "すみません。\\nクリスマスまでの仕入れ期間を考えると、\\n早めに決めなくてはならなかったので。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "そっかぁ、なら仕方ないね。\\nそれで、なんにしたの？",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "チノ",
          "original": "見てもらった方が早いですね。\\n試作品を写真に撮っておいたので……。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "チノ",
          "original": "はい、これです。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "うわぁ～！\\nすっごくおいしそうなパンケーキ！",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "リゼ",
          "original": "へえ。\\nこれはまた、豪華だな。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "チノ",
          "original": "当日のフルーツの仕入れ次第で\\n盛り付けは変わると思いますが、\\nだいたいの見た目はこんな感じです。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "チノ",
          "original": "……あの、お２人とも、\\n気に入ってもらえましたか？",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "もちろんだよ！\\nこれなら、お客さんにも絶対喜んでもらえるね。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "リゼ",
          "original": "ああ、間違いない。\\nきっと街でも評判になるぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "ココア",
          "original": "ねえ、味見はした？\\nおじさんに頼んだら試食させてもらえるかな？",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "リゼ",
          "original": "ココア、目が輝いてるぞ？\\n試食というか、ただ食べたいだけだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "ココア",
          "original": "そ、それは……\\nでも試食は大事なんだからね？",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "ココア",
          "original": "お客さんに勧める時、\\n実際に食べたことがある方が\\n説得力のある説明ができるし。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "チノ",
          "original": "なるほど、一理ありますね。\\nあとで父に頼んでみます。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "ココア",
          "original": "ホントに！？　やったぁ！",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "リゼ",
          "original": "やっぱり、自分が食べたいだけだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "ココア",
          "original": "ねえねえ、当日は表に特製の看板出そうよ。\\n限定パンケーキ、おすすめです！　とか。",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "チノ",
          "original": "そうですね、考えておきます。",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "リゼ",
          "original": "……うーん。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "チノ",
          "original": "リゼさん？\\nどうかしましたか？",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "リゼ",
          "original": "いや、少し心配になったんだ。\\nこうして限定メニューを考えたり、\\n他にも店のためにクリスマスの準備をしてるだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "47": {
          "speaker": "リゼ",
          "original": "なのに、私たちのパーティーのために\\n夜は貸し切りにしてしまっていいのか？",
          "translation": "",
          "status": "untranslated"
        },
        "48": {
          "speaker": "チノ",
          "original": "大丈夫ですよ。\\nちゃんと父の許可はもらっていますから。",
          "translation": "",
          "status": "untranslated"
        },
        "49": {
          "speaker": "チノ",
          "original": "それに父自身も――\\nいつもなら、クリスマスは\\n家族で静かに過ごすだけでしたが……。",
          "translation": "",
          "status": "untranslated"
        },
        "50": {
          "speaker": "チノ",
          "original": "今年は、私たちがパーティーを開くと知って\\n楽しみにしているみたいです。\\nだから、遠慮せずに使ってください。",
          "translation": "",
          "status": "untranslated"
        },
        "51": {
          "speaker": "リゼ",
          "original": "そうか、ありがとう。",
          "translation": "",
          "status": "untranslated"
        },
        "52": {
          "speaker": "チノ",
          "original": "いえ、そんな。\\n私だって……楽しみなんですから。",
          "translation": "",
          "status": "untranslated"
        },
        "53": {
          "speaker": "ココア",
          "original": "ち、チノちゃんが素直だ！？\\nそんな、お姉ちゃんには\\nあんなにツンツンなのに～！",
          "translation": "",
          "status": "untranslated"
        },
        "54": {
          "speaker": "チノ",
          "original": "ココアさんは姉じゃないです。",
          "translation": "",
          "status": "untranslated"
        },
        "55": {
          "speaker": "ココア",
          "original": "……そうだ！\\nリゼちゃん、今度のお泊まり会で、\\n一緒にお風呂入ろう！",
          "translation": "",
          "status": "untranslated"
        },
        "56": {
          "speaker": "リゼ",
          "original": "いきなりなんだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "57": {
          "speaker": "ココア",
          "original": "そして私に、チノちゃんに\\nツンツンされないコツを教えて～！",
          "translation": "",
          "status": "untranslated"
        },
        "58": {
          "speaker": "リゼ",
          "original": "いや、そんなことを言われてもな？",
          "translation": "",
          "status": "untranslated"
        },
        "59": {
          "speaker": "ココア",
          "original": "あ、そういえば……。",
          "translation": "",
          "status": "untranslated"
        },
        "60": {
          "speaker": "ココア",
          "original": "チノちゃんやシャロちゃんとは\\n一緒に入ったことあるけど、\\nリゼちゃんとはお風呂、入ったことないね。",
          "translation": "",
          "status": "untranslated"
        },
        "61": {
          "speaker": "リゼ",
          "original": "前に、一緒に温泉に入ったじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "62": {
          "speaker": "ココア",
          "original": "あれは温泉プールだから、お風呂とは別だよ。",
          "translation": "",
          "status": "untranslated"
        },
        "63": {
          "speaker": "リゼ",
          "original": "でも、わざわざ一緒に入る必要はないだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "64": {
          "speaker": "ココア",
          "original": "ううん、裸の付き合いって大事だよ！\\nリゼちゃんともっと仲良くなるには\\n必要なことだよ、裸の付き合い！",
          "translation": "",
          "status": "untranslated"
        },
        "65": {
          "speaker": "リゼ",
          "original": "も、もっと仲良く、か。",
          "translation": "",
          "status": "untranslated"
        },
        "66": {
          "speaker": "チノ",
          "original": "ココアさん、声が大きいです。\\nお客さんがこっち見てます。",
          "translation": "",
          "status": "untranslated"
        },
        "67": {
          "speaker": "ココア",
          "original": "あ、ごめん。",
          "translation": "",
          "status": "untranslated"
        },
        "68": {
          "speaker": "リゼ",
          "original": "やれやれ、仕方ないな。\\nじゃあ、今度、一緒に入ってやるよ。\\nだからもう大声を出すな。",
          "translation": "",
          "status": "untranslated"
        },
        "69": {
          "speaker": "ココア",
          "original": "ホント！？\\nやったぁ、リゼちゃんと裸の付き合いだ～！",
          "translation": "",
          "status": "untranslated"
        },
        "70": {
          "speaker": "チノ",
          "original": "だから、ココアさん！",
          "translation": "",
          "status": "untranslated"
        },
        "71": {
          "speaker": "ココア",
          "original": "はうっ！\\nごめんなさい……。",
          "translation": "",
          "status": "untranslated"
        },
        "72": {
          "speaker": "リゼ",
          "original": "あははっ！\\nそんなにはしゃぐことじゃないだろ、まったく。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}