{
  "identity": "rize_c04.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ふう～。\\n今日もよく働いたねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "お客さんも途切れましたし、\\n今日はこれで閉店にしましょう。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "あ、ああ、そうだな。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "（しまった、タイミングをうかがっているうちに\\n　こんな時間に……！\\n　今日中に欲しい物を聞き出すつもりだったのに）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "（いや、まだ時間はある。\\n　店を片付けてるあいだに話を聞いて――）",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "マヤ",
          "original": "やっほー！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "メグ",
          "original": "お邪魔しまーす。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "マヤちゃん、それにメグちゃん？\\nどうしたの？　もうお店は終わりの時間だよ？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "あっ！？\\nまさかバーに来たの？\\nだめだよ、子どもがバーなんて！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "マヤ",
          "original": "あはは！\\nそんなわけないじゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "メグ",
          "original": "私たち、今日はチノちゃんのところに\\nお泊まりに来たんだよ～。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "そうだったの？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "すみません。\\n急に決まったことだったので、\\nなかなか話すタイミングがなくて。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "そんな、謝ることなんてないよ。\\nびっくりしただけだから。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "でも、そういうことなら\\nチノちゃんはもう上がっていいよ？\\n片付けは私たちがやっておくから。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "ね、リゼちゃん？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "ああ、それくらいのことならまかせておけ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "ありがとうございます。\\nでは、おまかせします。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "マヤ",
          "original": "じゃあな！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "メグ",
          "original": "失礼しまーす。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "いいな～、お泊まり会かぁ。\\n私もまたやりたいな。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "なら、ココアも加わったらどうだ？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "あ、そっか！",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "いや、冗談だぞ？\\n邪魔したら悪いだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "リゼ",
          "original": "（……ん？\\n　もしかして、これはチャンスなんじゃないか？）",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "リゼ",
          "original": "（店の片づけをしながら\\n　たわいない世間話をしてるこの流れなら、\\n　怪しまれることもないはず！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "リゼ",
        "original": "（店の片づけをしながら\\n　たわいない世間話をしてるこの流れなら、\\n　怪しまれることもないはず！）",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "（まずは世間話を引き延ばそう）",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "（よし、さっそく聞き出すぞ！）",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "（さりげなく話を変えよう）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "（まずは世間話を引き延ばそう。\\n　もっと自然な感じにしないとな）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "きょ、今日はいい天気だったな！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "うん、そうだねぇ。\\n明日はどうだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "確か予報は晴れだったな。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "そっか～。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "（ここからどうやって\\n　欲しい物の話に持っていけばいいんだ？\\n　何か、さりげない切り口は……）",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "（だめだ！\\n　どうやって話を変えたらいいか思いつかない！）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "冬だと晴れてても寒いよね。\\n新しいマフラー、買おうかな。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "リゼ",
          "original": "え！？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ん？　どうかした？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "いや、その、ココアはマフラーが欲しいのか？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "うん、今使ってるのもいいけど、\\n温かくてかわいいのがあったら\\n買いたいなぁって。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "そ、そうか！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "（よーし、結果オーライだ。\\n　見事に欲しい物を聞き出すことができたぞ！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "（よし、さっそく聞き出すぞ！）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "なあココア。\\n最近、欲しいと思ってる物は何かないか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "え？　欲しいもの？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "（し、しまった！\\n　さりげなく尋ねるつもりだったのに、\\n　思いきりストレートに聞いてしまった！？）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "あ、それってもしかして、\\nクリスマスプレゼントに欲しい物ってこと？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "いいい、いや！\\nだ、だ、断じてそういうわけじゃないぞ！\\nごく普通の一般論とでも言うかだな！？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "（って、ますます怪しまれるじゃないか！\\n　何をやってるんだ私は、\\n　これでは極秘任務が……）",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "欲しい物……。\\n最近寒いし、新しいマフラーが欲しいなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "ん？　なに？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "いや……マフラーが欲しいのか。\\nそ、そうか。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "（もしかして、今のがリサーチだと\\n　気づかれてないのか？）",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "（さすがはココアだな。\\n　誤魔化そうとした私の言葉を\\n　疑いもしないなんて……）",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "（なんだか悪い気がするが、なんにせよ助かった。\\n　おまけに欲しい物まで聞くことができたし）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "（さりげなく話を変えよう）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "なあココア、例えばの話なんだが、\\n食べ物と服のどちらかがもらえるとしたら\\nどっちがいい？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "え？　うーん……\\nお腹は減ってるけど、もうすぐ晩ご飯だから、\\nもらえるとしたら服かな？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "じゃあ、服と本だったら？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "ううーん、難しい選択だね。\\n……服かなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "なるほど、なら次は――",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "何だかよくわかんないけど、\\n欲しい物の話をしてるの？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "（なっ！？\\n　しまった、質問が露骨すぎてバレたか！？）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "この例え話が欲しい物のことなんだったら、\\n今はマフラーかな～。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "リゼ",
          "original": "……マフラー？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "うん。\\n最近、すっかり寒くなっちゃったからね。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "そ、そうか！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "（もしかして、私の意図に気づいていないのか？\\n　例え話だと言ったからか？）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "（さすがココアと言うべきか……。\\n　まあ、なんにせよ、ココアが欲しいのは\\n　マフラーということか）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "……あっ！　そうだ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "ん？\\nせっかく片付けたのに\\nまたカップを出したりして、どうした？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "外は寒かったと思うし、\\nマヤちゃんとメグちゃんに\\n温かい飲み物を持っていってあげようかなって。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "ああ、なるほど。\\nココアは気が利くな。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "まあ、かわいい妹たちのことですからね！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "（差し入れか……）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "（まだチノからは何も聞けてないし、\\n　マヤもメグもパーティーに来るんだ。\\n　欲しい物を聞いておくべきだな）",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "よし！　差し入れには私が行こう。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "え？　なんで――",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "ああっ！\\nリゼちゃん、妹たちの感謝を独占する気なの！？\\nそうはさせないよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "そうじゃない！\\nええとだな……。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "ほ、ほら！\\n帰る前に声をかけるついでにさ。\\nココアは、あとでいくらでも話せるだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "そういうわけだから、私にまかせておけ！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "えええ～！\\nリゼちゃん、ずるいー！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "（すまない、ココア。\\n　これもクリスマスプレゼントの\\n　ためなんだ……！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}