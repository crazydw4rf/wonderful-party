{
  "identity": "all_b02.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "みんな、ちゃんとついてきてるな！？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "いるよー！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "大丈夫です。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "わ、私も何とか。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "ええ、ちゃんといるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "よし、じゃあ少し休憩するとしよう。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "ずいぶん歩いた気がするけど……\\n景色が全然変わらないね。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "この雪だからな。\\n目印になるものもないし、\\n同じに見えても仕方ないさ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "あ、あの……今更気がついたんですけど、\\nここって雪山なんですよね？\\nもしかしたら……その……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "熊や狼が出るんじゃないかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "あっさり言うなー！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "安心しろ、銃があるからな。\\nこの威力じゃ野生動物には非力だが、\\nみんなを逃がす時間稼ぎぐらいはできると思う。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "ええっ！？\\nどうしてそんなものが……。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "万が一のことを考え、\\n寝る時も銃を仕込んでおく習慣を\\n身に付けていたんだが、役に立つ日が来るとは。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "リゼちゃん、格好いい……！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "さすが先輩ですっ！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "本当に頼りになるわねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "リゼ",
          "original": "ふっ！\\nよせ、礼は助かってからだ。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "万が一のために銃を持って寝る……。\\n普通の女子高生って一体……。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "どうしたのチノちゃん、ボーっとして。\\n雪山で眠ったら命取りだよ！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "あ、いえ、大丈夫です。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "ともかく身の安全の確保が最優先だ。\\nみんな、そろそろ前進するぞ！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "チノ",
          "original": "景色、全然変わりませんね。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "同じ所をぐるぐる回ってる気がしてきた……。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "リゼ",
          "original": "それはない。\\n戻っていたら、私たちの足跡があるはずだ。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "……あれ？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "どうかしましたか、ココアさん？",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "ねえ、あっちに何か見えなかった？",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "千夜",
          "original": "えっ！？\\n何かあったの？",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "あったって言うか、何か光ったような……。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "シャロ",
          "original": "本当！？",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "チノ",
          "original": "あっ！\\n確かに何か光ってます！",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "千夜",
          "original": "あれは……もしかして、山小屋じゃないかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "うん、そうだよ！\\n山小屋だ！",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "シャロ",
          "original": "助かるの？\\n私たち、助かったの？",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "千夜",
          "original": "ええ！\\n頑張ったわね、シャロちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "リゼ",
          "original": "よくやった、ココア！\\nお手柄だ！",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "ココア",
          "original": "えへへ……。\\nよかった、これでみんな助かるんだね。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "シャロ",
          "original": "早く行きましょう、先輩！",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "リゼ",
          "original": "待て！\\nシャロ、走るな！　落ち着け！",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "シャロ",
          "original": "えっ？　どうしてですか？\\nあそこに山小屋があるんですよ？",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "リゼ",
          "original": "焦りは禁物だ。\\n途中に危険なものがないとも限らないんだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "リゼ",
          "original": "緊張が緩んだ時が最も危険なんだ。\\nここは慎重に進むぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "シャロ",
          "original": "は、はい！　すみません！",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "リゼ",
          "original": "謝ることはないさ。\\n山小屋は逃げたりしないんだ、じっくりいこう。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "ココア",
          "original": "うん。\\n何か温かいものがあればいいねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "千夜",
          "original": "ふう……。\\nやっと山小屋が\\nちゃんと見えるところまで来たわね。",
          "translation": "",
          "status": "untranslated"
        },
        "47": {
          "speaker": "チノ",
          "original": "明かりがついてますし、誰かいるみたいです。",
          "translation": "",
          "status": "untranslated"
        },
        "48": {
          "speaker": "シャロ",
          "original": "よかったぁ……。\\nこれで本当に助かるのね。",
          "translation": "",
          "status": "untranslated"
        },
        "49": {
          "speaker": "ココア",
          "original": "じゃあ、さっそくお邪魔させてもらおう！\\nすみませ――",
          "translation": "",
          "status": "untranslated"
        },
        "50": {
          "speaker": "リゼ",
          "original": "待て、ココア。\\nまずは偵察だ。",
          "translation": "",
          "status": "untranslated"
        },
        "51": {
          "speaker": "チノ",
          "original": "そうですね。\\nどんな時でも、危険がないとは\\n限らないんですから。",
          "translation": "",
          "status": "untranslated"
        },
        "52": {
          "speaker": "リゼ",
          "original": "その通り。\\nわかってきたじゃないか、チノ。",
          "translation": "",
          "status": "untranslated"
        },
        "53": {
          "speaker": "千夜",
          "original": "ええ、ここに潜んでいるのが人とは限らないもの。\\nもしかしたら、雪女の家かもしれないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "54": {
          "speaker": "シャロ",
          "original": "ええっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "55": {
          "speaker": "リゼ",
          "original": "そっちか！？\\nち、千夜、こんな時に\\nシャレにならないことを言うのは勘弁してくれ！",
          "translation": "",
          "status": "untranslated"
        },
        "56": {
          "speaker": "千夜",
          "original": "うふふふ、ごめんなさい。\\nもちろん冗談よ。",
          "translation": "",
          "status": "untranslated"
        },
        "57": {
          "speaker": "リゼ",
          "original": "と、とにかく、みんなはここにいてくれ。\\n私が１人で行ってくる。",
          "translation": "",
          "status": "untranslated"
        },
        "58": {
          "speaker": "リゼ",
          "original": "こんな場所に小屋がぽつんとあるのも怪しい。\\n銀行強盗がここを隠れ家にして、夜な夜な\\n札束を数えているかもしれない。",
          "translation": "",
          "status": "untranslated"
        },
        "59": {
          "speaker": "シャロ",
          "original": "そ、そんな危ないところに\\n先輩１人で行くなんて、大丈夫なんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "60": {
          "speaker": "リゼ",
          "original": "大丈夫だ。\\n万が一の時には、この相棒が助けてくれるさ。",
          "translation": "",
          "status": "untranslated"
        },
        "61": {
          "speaker": "シャロ",
          "original": "……はい。\\nお気をつけて、先輩。",
          "translation": "",
          "status": "untranslated"
        },
        "62": {
          "speaker": "千夜",
          "original": "油断しないで……\\nなんて、言うまでもないわね。",
          "translation": "",
          "status": "untranslated"
        },
        "63": {
          "speaker": "ココア",
          "original": "何かあったら大声出してね。\\nすぐに駆けつけるから。",
          "translation": "",
          "status": "untranslated"
        },
        "64": {
          "speaker": "リゼ",
          "original": "わかった。\\nじゃあ、行ってくる！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}