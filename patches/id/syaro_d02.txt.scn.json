{
  "identity": "syaro_d02.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "いらっしゃいませ！\\nフルール・ド・ラパンへようこそ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "さすが、リゼ先輩ですね。\\n制服姿も挨拶もばっちりです。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "ここでのバイトは、前にもやってるからな。\\n接客は全部、私に任せてくれていいぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "あ、いえ！\\nそういうわけにはいきません！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "あっと！\\nあのテーブル、注文が決まったみたいですね。\\nこっちを呼んでます。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "よし、私が行ってくる！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "ご注文はお決まりでしょうか？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "ローズマリーとレモングラスですね。\\nかしこまりました、少々お待ちください。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "（流れるような接客、さすがです先輩！\\n　私も負けてられない……！）",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "ありがとうございました！\\nまたのお越しをお待ちしてます！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "……ふう。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "大丈夫か、シャロ。\\n疲れたのか？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "あ、いえ！\\nそんなことないです。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "まだ病み上がりなんだから無理するな。\\n今日はもう上がったらどうだ？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "え？　でも……。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "リゼ",
          "original": "心配するな。\\nそのために私がいるんだ、\\n残りの時間は任せておけ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "先輩がそうおっしゃるなら……。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "でも、先輩が上がる時間まで\\nお店で待っているのは構いませんよね？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "まあ、そうだな。\\n大人しくしてるんだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "はい！\\nそれじゃ、店長に言って着替えてきますね。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "（もう、リゼ先輩ったら過保護すぎ！\\n　う、嬉しいけどっ！）",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "うーん……。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "シャロ",
          "original": "先輩？　どうかしたんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "ああ、シャロ。\\n実はな、さっき店長から、\\n本気でうちで働く気はないかって聞かれてさ。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "シャロ",
          "original": "……え？",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "シャロ",
          "original": "（それって、つまり、私よりも\\n　リゼ先輩の方が役に立つから？\\n　私はもういらないってこと？　クビ！？）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "シャロ",
        "original": "（それって、つまり、私よりも\\n　リゼ先輩の方が役に立つから？\\n　私はもういらないってこと？　クビ！？）",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "私、先輩のためなら身を引きます！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "引き受けるつもりなんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "私、どうすれば……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "私、先輩のためなら身を引きます！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "は？　身を引くって？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "店長に認められたってことは\\nきっと待遇もいいと思いますし、\\nそれが先輩のためになるなら私は……！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "ああ、そういうことか。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "別に、お前の代わりに、なんて話じゃない。\\nただ誘われただけだ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "……そうなんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "それに、どんなに待遇がよくても断るよ。\\n前みたいに一時的ならともかく、\\nこことラビットハウスの両立は難しいし。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "なんにせよ、気を遣わせて悪かったな。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "いえ、別に私は……すみません……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "引き受けるつもりなんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "いや、断るよ。\\nラビットハウスを辞める気はないし、\\nだからといって両立は無理だし。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "で、ですよね！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "（よかったぁ。\\n　私、クビにならなくてすむのね）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "私、どうすれば……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "どうすればって、何がだ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "先輩が入るってことは、\\n私、クビになっちゃうのかなって。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "なんだ、そんな心配をしてたのか。\\n大丈夫だよ、私は断るつもりだし、\\nそもそもお前の代わりなんて話じゃない。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "……そうなんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "ああ。\\n仮にそんな話だったとしたら、\\nその場で断ってるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "先輩……！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "そうだ。\\n何かおごってやるから、\\n飲みたい物があったら言ってくれ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "えっ！？\\n悪いです、そんな。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "私を待ってるんだから、それくらいいいだろ？\\nほら、早く決めないと勝手に持ってくるぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "そ、それでもいいです！\\n先輩が私に合うハーブティーを\\n選んでくれたら、すっごく嬉しいです！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "そうか？\\nよし、じゃあ待っていてくれ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "はいっ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}