{
  "identity": "main_c01.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "（今日は、１２月４日。\\n　私の誕生日）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "（そして、ココアさんが\\n　世界で１番素敵な日にすると\\n　約束してくれた日――）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "すみません、おじさん。\\n今日、ラビットハウスを貸し切りにしちゃって。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "タカヒロ",
          "original": "気にしなくていいよ。\\n今日は特別な日なんだから。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "タカヒロ",
          "original": "それよりも、お礼を言わせてくれ。\\n今日はチノのためにありがとう。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "あ、だめです！\\n誕生会のこと、\\nまだチノちゃんには秘密にしてるので。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "タカヒロ",
          "original": "おっと、そうだったな。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "うう……。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "落ち着けって、チノ。\\nお前が今日の主役なんだから、\\nもっとどっしりしていていいんだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "す、すみません。\\nその、家族以外との誕生日会の経験が\\nあまりなくて、どうしたらいいのか……。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "どうしたの？　何話してるの？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "ああ、なんでもないぞ？\\nそれよりも、千夜やシャロやマメ、\\n青山さんまで集めて何をするつもりなんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "マヤ＆メグ",
          "original": "マメはやだー！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "ふふふふ～。\\nじゃあ、そろそろ種明かしをしよっか！\\nねえ、みんな？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "はいはい、そうね。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "千夜",
          "original": "ええ、そうしましょうか。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ティッピー",
          "original": "やれやれ。\\nココアはまだ秘密にできていると\\n思っとるんじゃな。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "みたいですね。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "ごほん！\\nでは……。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "集まってくれたみんなを代表して、\\n私から挨拶をさせて頂きます。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "実は、今日は……。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "（ごくり……）",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "チノ",
          "original": "！？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "うわっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "チノちゃん、お誕生日おめでと～！\\nただいまより、チノちゃんのお誕生会を\\n始めまーす！",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "ねえねえ、チノちゃん！\\nびっくりしてくれた？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "それは、驚きますよ。\\nいきなりこんなことをされたら。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "リゼ",
          "original": "ホントだな。\\nまったく、はりきりすぎじゃないか？",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "やったね！\\nチノちゃんの誕生日お祝い、サプライズ成功！",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "ふっふっふ～。\\n実はね、今日までのコスプレチラシ配りは\\n壮大な計画の元に実行されていたんだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "ココア",
          "original": "ラビットハウスでやるのは\\nあくまで実験だって言ったけど、実は――",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "ココア",
          "original": "すべてが、チノちゃんのお誕生日を祝うための\\n作戦だったのだ～っ！",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "チノ",
          "original": "はい、知ってます。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "……え？　知ってたの？",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "チノ",
          "original": "正確に言うと、気がついていました。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "マヤ",
          "original": "っていうか、バレバレだったもんな。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "メグ",
          "original": "う、うん、そうかも。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "ココア",
          "original": "ええええ～！？\\nそんなぁ、サプライズで\\n驚かそうと思ってたのに知られてたなんて。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "チノ",
          "original": "……ココアさん。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "ココア",
          "original": "うう……。\\nごめんね、チノちゃん。\\n世界で１番素敵な日にするって言ったのに。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "チノ",
          "original": "いいえ、謝らないでください。\\nだって……。",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "チノ",
          "original": "ココアさんのおかげで、こんなにたくさんの人が\\n私の誕生日のために集まってくれたんですよ？\\nこの、ラビットハウスに。",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "リゼ",
          "original": "ああ、そうだ。\\nココアの想いがみんなをたきつけたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "チノ",
          "original": "それだけじゃないです。\\n私だけでなく、ラビットハウスのことも思って\\n色々な準備をしてくれて……本当に嬉しかったです。",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "チノ",
          "original": "ココアさん。\\n今日、この時間を私をプレゼントしてくださって、\\nありがとうございます。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "ココア",
          "original": "チノちゃん……！",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "リゼ",
          "original": "よし、じゃあ、改めてみんなでお祝い、行くぞ！\\nせーの！",
          "translation": "",
          "status": "untranslated"
        },
        "47": {
          "speaker": "みんな",
          "original": "お誕生日おめでとう！",
          "translation": "",
          "status": "untranslated"
        },
        "48": {
          "speaker": "チノ",
          "original": "あ、ありがとうございます……！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_0101": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "（それから……\\n　ケーキを食べて、プレゼントを頂いて、\\n　誕生日会はあっという間に過ぎていきました）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "（こんなにも楽しい時間を過ごしたのは、\\n　生まれて初めてだったかもしれません）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "（これも、ココアさんのおかげ……。\\n　本当にありがとうございます）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_0102": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "さあ、それじゃ、次は誕生日ケーキの出番ね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "うん！\\nやっぱり、お誕生会の始まりは\\nケーキのろうそくを消してこそだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "お約束ってやつか。\\nケーキは、シャロと千夜が\\n用意してくれたんだよな？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "はい。\\n千夜と一緒に、チノちゃんによく似合う\\nケーキと紅茶を見つけてきたんです。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "はい、ケーキはこれよ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "わあ……！\\nか、かわいいです！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "メグ",
          "original": "ほんと、かわいいね～！\\nタルトの上に飾りがいっぱーい！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "マヤ",
          "original": "これ、クッキーなんだ！\\n色んな形で……おお、\\nチノちゃんハッピーバースデーって書いてある！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "特別に作ってもらったの。\\nどうかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "ありがとうございます……！\\nすごく素敵です！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "こっちは、チノちゃんをイメージした紅茶よ。\\n私と千夜でブレンドを選んでみたの。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "チノ",
          "original": "私のイメージ、ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "ええ。\\n控えめだけどしっかりした味わいで、\\nさわやかな香りのものよ。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "でも、残る味は少し甘めなのよ？\\nお姉ちゃんへの本当の気持ちを隠しちゃう感じね。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "う……。\\nべ、別に、その、隠してるわけでは……。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "えっ！？\\nなになに？　お姉ちゃんってどういうこと？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "な、なんでもないです！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "それじゃ、歳の分だけろうそくを立てましょうか。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "まかせて。\\n１つ、２つ――",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "チノ",
          "original": "（歳の数だけのろうそく……。\\n　ティッピーの場合は、何本立てなくちゃ\\n　いけないのでしょうか？）",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "千夜",
          "original": "はい、準備完了。\\nチノちゃん、どうぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "あ、はい。\\nそれでは……ふーっ！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "おめでとう、チノちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "おめでとう！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_0201": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "（それから……\\n　プレゼントを頂いて、誕生日会は\\n　あっという間に過ぎていきました）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_0202": {
      "texts": {
        "0": {
          "speaker": "マヤ",
          "original": "よーし、じゃあ次はプレゼントだね。\\nまずは私とメグからだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "メグ",
          "original": "気に入ってもらえるといいんだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "これは……！\\nまさか、ボトルシップ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "メグ",
          "original": "うん！\\nマヤちゃんと一緒に、頑張って作ってみたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "マヤ",
          "original": "ていうかさ、\\nあとになって気がついたんだけど――",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "マヤ",
          "original": "チノは作るのが好きだから、\\nできあがってるのをプレゼントしても\\n意味ないかな？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "そんなことありません！\\nとても、とっても嬉しいです……大切にします。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "メグ",
          "original": "えへへ、私、不器用だから\\nちょっと変な形になっちゃったんだ。\\n飾ってくれたら、嬉しいけど恥ずかしいかも。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "マヤ",
          "original": "まあ、それも味ってことで！\\nな、チノ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "はい！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "タカヒロ",
          "original": "さあ、チノ、これを。\\nお誕生日おめでとう。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "青山",
          "original": "私からも。\\nお誕生日おめでとうございます、チノさん。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "ありがとうございます。\\n開けてみてもいいですか？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "タカヒロ",
          "original": "ああ、もちろん。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "これは……かわいいうさぎのぬいぐるみ！\\n青山さんのは、素敵なエプロン！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "青山",
          "original": "このお店には制服がありますから、\\n使う機会はないかもしれませんけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "いえ、ありがとうございます。\\n家事をする時に使わせてもらいますね。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "タカヒロ",
          "original": "ああ、それからもう１つ\\nプレゼントがあるんだ。\\nほら。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "えっ？\\nこのマグカップは……。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "わあ、これ、かわいい～っ！\\nティッピーがデザインしてあるよ！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "本当です……！\\nこんなものがあったなんて。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "きっと、デザインから起こして作ったのね。\\nすごく手が込んでるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "タカヒロ",
          "original": "これは、ある人からの誕生日プレゼントだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "ある人？\\nそれって誰ですか、おじさん。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "タカヒロ",
          "original": "それは言えないんだ。\\n秘密にしておくという約束でね。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "秘密なんですか！？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "千夜",
          "original": "まあ、謎の人から誕生日プレゼントなんて、\\nなんだかロマンチックねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "ま、まさか、チノちゃん、\\n私以外に秘密のお姉ちゃんがいるの！？",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "チノ",
          "original": "そんな人、いません。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "えええ～！？\\nそれじゃ、一体誰からのプレゼントなの～！？",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "チノ",
          "original": "（……もしかして）",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "チノ",
          "original": "ティッピー、ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ティッピー",
          "original": "誕生日おめでとう、チノ。",
