  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "ココアちゃんっ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "千夜ちゃん！？\\nどうしたの、そんなに慌てて。\\n何かあったの？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "あんこが、あんこがいなくなっちゃったの！\\nここには来てない？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "あんこが行方不明！？\\nそれは一大事だ！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "うちには来ていませんが……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "そう。\\n愛しのティッピーを求めて\\nここまで来ちゃったのかなと思ったんだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ティッピー",
          "original": "なぬぅ！？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "千夜",
          "original": "はっ！？\\nもしかして、ティッピーを探して\\n街中を走り回っているのかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "ああ……。\\n数々の苦難を乗り越え\\nやがて２羽は結ばれるのね！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "全うさぎが泣く、\\n感動のクライマックスだよ……！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ティッピー",
          "original": "断じて結ばれんわ！！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "いや、そんな壮大な話じゃなくて、\\nいつもみたいにカラスに\\nさらわれただけじゃないか？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
