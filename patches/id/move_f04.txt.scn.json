{
  "identity": "move_f04.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア（Ｍ）",
          "original": "（……あれ？　チノちゃんだ。\\n　チノちゃんもお散歩かな？）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "チーノちゃーん！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "ココアさん。\\nどうしたんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "お散歩してたの。\\nチノちゃんもそうなの？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "いえ、私はウォーキングをしていました。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "ウォーキング？\\nお散歩じゃないの？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "立ち仕事のバリスタには、体力も必要なんです。\\nだから少しでも鍛えようと思いまして。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "そっか。\\nじゃあ、私も一緒に散歩していい？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "散歩じゃないです、ウォーキングです。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア（Ｍ）",
          "original": "（でも、歩き方もすごくゆっくりだし、\\n　どう見ても散歩してるようにしか……）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア（Ｍ）",
          "original": "（でも、チノちゃんがウォーキングって\\n　言ってるし、それでいっか！）",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "じゃあ、一緒にウォーキングしよう！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "いいですよ。\\n行きましょう。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "ねー、チノちゃん？\\n私たち、こうしてると本当の姉妹みたいだね。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "……一緒に歩いているだけですよ？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "よーし！\\nじゃあ、もっと仲良しな姉妹らしくしよう。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "どうしてですか。\\n別に姉妹らしく振る舞う必要はありませんよね。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "う～ん、仲良し、仲良し……。\\n手を繋ぐ、とか？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "……嫌です。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "即答！？\\nどうして嫌なの？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "ココアさんは、その……\\nはずかしいとは思わないんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "全然。\\nお姉ちゃんなんだから、\\n妹の手を取って導いてあげないとね。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "だから、妹じゃないです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "チノ",
        "original": "だから、妹じゃないです。",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "そう言わないで、繋いでください！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "そんなことを言う妹は、こうだ！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "チノちゃんはツンデレだな～。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "そう言わないで、繋いでください！\\nでないとお姉ちゃん、泣いちゃうよ！？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "な、泣くんですか！？\\nお姉さんなのに！？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "お姉ちゃんだって人間だもん！\\n寂しくなっちゃうことだってあるんだよ……。\\nうるうる……。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "そ、そんな涙目で訴えるほど寂しいんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "うん……。\\n隣にいるはずのチノちゃんが\\nずっと遠くに感じられるほどだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "……わかりました。\\nちょっとだけ……ですよ？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "やったぁ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "そんなことを言う妹は、こうだ！\\nえいっ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "あっ……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "チノちゃんの手、奪っちゃった～！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "そんな、無理矢理……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "もう放さないよ！\\nさ、行こう！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "もう……お姉さんって言ってるけど、\\n全然じゃないですか。\\n仕方のないココアさんです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "チノちゃんはツンデレだな～。\\nお姉ちゃんの前では、\\nもっと素直になっていいんだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "私はいつだって素直です。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "うんうん、お姉ちゃんはわかってるよ？\\nホントは手を繋ぎたいけど、\\n認めちゃうのがはずかしいんだよね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "そうじゃなくて……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "だったら、お姉ちゃんから手を繋いじゃえば\\nはずかしくないよね。\\nえいっ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "あっ……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "あ、チノちゃん、手、冷えちゃってるね。\\nもしかして寒い？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "いえ、寒くはないです。\\n外の空気に当たっていたから\\n冷たくなっただけです。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "あ、そういえば、手が冷たい人は\\n心が温かいって言うよね。\\nじゃあ、チノちゃんはすっごく温かい人なんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "……あれ？\\nねえ、私の手、チノちゃんより温かい？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "はい、温かいです。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "じゃあ、私は心が冷たいってこと！？\\nガーン……。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "いえ、そんなことありません。\\nココアさんは手も心も温かいです。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "え！？　本当？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "こ、こんな時に嘘を言ったりしません。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "そっか！\\nチノちゃんにとって私は、温かい心の持ち主で、\\n信頼できるお姉ちゃんってことだね？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "そこまでは言ってませんが。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "あうっ！\\nで、でも、心が温かいのは間違いないよね？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "……はい。\\nそこは間違いないですよ、ココアさん。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}