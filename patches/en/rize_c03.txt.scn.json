{
  "identity": "rize_c03.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "よーし！\\n今日もはりきって働くぞ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア＆チノ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "ん？　どうした、２人とも？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "う、ううん！\\nなんでもないよ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "少し気が抜けていただけです。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "そうか。\\n今のうちに気持ちを切り替えておけよ？\\nきっと今日も忙しくなるからな。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "う、うん。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "リゼさん、妙に機嫌がいいですね。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "そうだね。\\n最近、元気ない感じだったのに。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "でも、元気になってくれてよかったね。\\nやっぱり明るい笑顔が１番だもん。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "（ふっふっふ！\\n　今日の私は、昨日までとは一味違うぞ？\\n　何しろ極秘任務中なんだからな）",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "（みんなの笑顔のために、\\n　この任務、必ず成功させなければ！）",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "いらっしゃいませ！\\n２名様ですね、こちらのお席にどうぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "（おっと。\\n　任務も大事だが、仕事もきちんとしないと）",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "チノちゃん、オーダーだよ。\\nオリジナルブレンドとケーキを２つずつ、\\nお願いしまーす。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "リゼ",
          "original": "じゃあ、ケーキはこっちでやるよ。\\nチノはコーヒーを頼む。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "はい、お願いします。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "リゼ",
          "original": "（今はまだタイミングが悪いな。\\n　さりげなく話題を振って、\\n　欲しい物を聞き出すんだ！）",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "ありがとうございました。\\nまたのお越しをお待ちしています。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "リゼ",
          "original": "（ふう！\\n　今日も、思った以上にお客が来るな）",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "女性客Ａ",
          "original": "すみませーん。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "はい、注文ですね。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "リゼ",
          "original": "チノ、オーダーだ。\\nアイスコーヒーを１つ。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "アイスコーヒーですね。\\nわかりました。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "今日は混んでるね。\\n昨日、チラシを配ったおかげかな。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "リゼ",
          "original": "そうだな、昨日のチラシは\\nクリスマス限定メニューのお知らせだったが――",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "リゼ",
          "original": "それでラビットハウスに興味を持って、\\n下見に来てくれたのかもしれない。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "うん、きっとそうだね！\\nこれは当日も大忙しになりそうだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "女性客Ｂ",
          "original": "すみません、お会計をお願いします。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "あ、はーい！",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "リゼ",
          "original": "（うーん……。\\n　今みたいなちょっとした話はできても、\\n　欲しい物の話題にまでは持っていけないな）",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "リゼ",
          "original": "（脈略なく話を振ったら怪しまれてしまうし……\\n　さて、どうしたものだろう？）",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}