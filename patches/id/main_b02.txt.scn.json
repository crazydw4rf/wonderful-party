{
  "identity": "main_b02.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ふんふんふん、ふふふ～ん♪",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "ココアさん、どうかしたんですか？\\nすごく楽しそうですが。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "えへへ～、だって楽しみじゃない？\\nどれくらいお客さんが増えるかなーって。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "もしかして、チラシ配りの効果を期待してるのか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "うん！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "それは、さすがに気が早すぎるだろ。\\nまだ始めたばかりなんだし。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "でも――",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "いらっしゃいませ！\\nこちらのお席へどうぞ～。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "では、ご注文がお決まりになったら\\nお呼びください。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "ほら！\\nさっそく来たよ、お客さん。\\nこの調子でどんどん来てくれるといいな～。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "いや、まだバイトを始めて１人目だぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "ありがとうございました！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ＆リゼ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "お客さん、いなくなっちゃったね。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "リゼ",
          "original": "そうだな。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "いつも通りですね。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "うーん、おかしいな？\\nどうしてなんだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "どうしてと言われましても……。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "リゼ",
          "original": "気が早すぎるって言っただろ？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア（Ｍ）",
          "original": "（うーん……）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "ココア",
        "original": "（うーん……）",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "まだ、これからだよね！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "何がいけなかったのかな？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "他のやり方を考えた方がいいのかな？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "まだこれからだよね！\\nいつも通りなのは残念だけど、\\nチラシ配りは始めたばかりなんだし。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "うん！　そう考えたら\\nますますやる気が出てきちゃった。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "ココアさんは前向きですね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "まあ、ココアらしいとは思うけどな。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "えへへ、そんなに褒めないでよ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "別に褒めてるわけではありませんが。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "何がいけなかったのかな？\\nちゃんと反省しなくちゃ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "まだそういう問題ではありません。\\nこういうことは、結果が出るまでに\\n時間がかかりますから。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "でも、そうやって反省点を\\n見出そうとするのはいいことだな。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy4": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "……そうですね。\\nココアさんも本気なんだって伝わってきます。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "もちろん本気だよ！\\nだからこそ、これでいいのかなって……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "他のやり方を考えた方がいいのかな？\\nチラシ配りじゃない方法を。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "そんなに焦っても仕方ありません。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "チノの言う通りだ。\\nまだ始めたばかりじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "でも……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "あ、そうだ！\\nいいこと思いついちゃった。\\nチノちゃん、ちょっとキッチン借りるね！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "え？　いいですけど、何を……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "じゃあ、お店はよろしくー！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "キッチンって……\\nココア、何を思いついたんだろうな？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "さあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "遅いな、本当に何してるんだ？\\nちょっと様子を見に行ってみるか。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "……あれ、すごくいい匂いがしてきました。\\nこれってパンが焼き上がった匂いでしょうか？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "お待たせ～！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "ココア。\\n一体、何をしてたんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "じゃーん！\\nこれを作ってたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "それは……\\nパンでできたラビットハウスの看板？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "へえ、こいつはすごいな。\\nよくこんなにそっくりに作れたもんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "えへへ～。\\nパン作りには自信があるからね。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "ねえ、これを毎日作って表に飾ったら、\\nいい匂いがするし目立つし、\\nお店の宣伝になるんじゃないかな？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "それは……目立つとは思いますが、\\nうちがパン屋さんだと誤解されたら\\nどうするんです？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "あ……。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "確かに、こんな立派な看板があったら、\\n誤解されても仕方ないな。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "で、でも、お客さんが増えてくれるなら\\n問題ないんじゃないかな？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "そんな騙すみたいなことはだめです。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "リゼ",
          "original": "パン屋だと思って入ってきた人が\\n喫茶店だと知ったら、がっかりするだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "……そうだね。\\nいいアイディアだと思ったんだけどなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "あの……あまり気を落とさないでください。\\nココアさんがラビットハウスのことを\\n考えてくれているのは、わかってますから。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "え？　もしかしてチノちゃん、\\n私のこと慰めてくれてる？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "ち、違います。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "いいんだよ、照れなくても！\\nお姉ちゃんはもっとチノちゃんに\\n慰められたいな～。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "もう、知りません！",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "あ、ああ、チノちゃん！？\\nごめんね、怒らないでー！",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "リゼ",
          "original": "やれやれ。\\nこっちもいつも通りだな。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}