{
  "identity": "flyer_rize_c2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はリゼちゃんとチラシ配りをしよう！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "はうっ！\\nか、髪の毛が～！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "大丈夫か？\\n今日は風が強いな。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "あうう、前髪がぐちゃぐちゃだ～！\\nねえ、変じゃない？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "変じゃないぞ、いつも通りだ。\\nしかしこれじゃ、そのうち\\n髪がバサバサになりそうだな。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "そうなっちゃう前に、\\nおさげにでもしようかなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "リゼちゃんは、みつあみにしたらどうかな？\\nそれならバサバサにならないよ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "みつあみか。\\nなるほど、いいかもしれないな――",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "ひゃあ！？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "あ、ああああ～！！\\nチラシがぁ～！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "リゼ",
          "original": "む！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "え？　リゼちゃん、どこから銃出して？\\nていうか何で出したの！？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "はっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "すまん！　射撃訓練のクセが出てしまったんだ。\\nこう、不意を突いて飛んでくる的を\\n狙う訓練があって……。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "か、かっこいい……！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "かっこいいよ、リゼちゃん！！\\n着物に銃！　モダンだよ、モダン！！\\nモダンでロマンだよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "おい、ココア。\\nモダンの意味をわかって言ってるのか？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "え？　それはその……\\nも、もちろんわかってるよ！\\nモダンっていうのは――",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "うわっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "あああああ～！\\nリゼちゃん、チラシがまたー！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "というか、最初に飛ばされた分のことを忘れてた！\\n急いで拾いに行くぞ、ココア！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "うん！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}