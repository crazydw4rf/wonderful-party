{
  "identity": "syaro_c01.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "ん～～っ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "（よし、今日は起きられそうね。\\n　みんなが看病をしてくれたおかげかしら）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "（……ん？\\n　でも、まだちょっと熱っぽい？\\n　バイトに行くのは難しいかしら？）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "（でも、昨日はフルールだったから\\n　まだよかったけど、飛び込みで入れた仕事を\\n　急に休むっていうのも……）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "（かと言って、ちゃんと風邪が治りきらないまま\\n　今までと同じペースで働いてたら、\\n　また体調を崩しちゃいそうね）",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "（それに、クリスマスパーティーのことだって\\n　まだ何も進んでない）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "（みんなにさんざん心配かけて、\\n　こんなにも助けてもらってるのに……）",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "うーん……。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "シャロちゃーん！\\n起きてる～？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "（……千夜？）",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "千夜",
          "original": "おはようシャロちゃん。\\nよかった、だいぶ顔色がよくなったわね。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "おはよ、千夜。\\nええ、おかげさまでね。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "千夜",
          "original": "朝食を作ってきたの。\\n食べられそう？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "うん、ありがと。\\nところで、どうしてまだ着替えてないの？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "千夜",
          "original": "え？　着替え？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "そろそろ家を出ないと、学校に遅刻するでしょ。\\nなのに、なんで制服に着替えてないのよ？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "なんでって、\\n今日もシャロちゃんの看病を――",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "いらないわ。\\n見ての通り、もう普通に起きられるのよ？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "でも……。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "大丈夫だから。\\nほら、さっさと着替えて学校に行きなさい。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "千夜",
          "original": "ああ、待って！\\nわかったから、ちょっとだけ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "何よ？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "はい、これ。\\nお昼の分のお弁当よ。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "千夜",
          "original": "こうなるんじゃないかと思って、\\nお昼の分も包んできたの。\\nちゃんと食べてね。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "シャロ",
          "original": "う、うん……。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "千夜",
          "original": "ふふっ！\\n私って、気の利くよくできた通い妻ねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "シャロ",
          "original": "な、何言ってるのよ……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "シャロ",
        "original": "な、何言ってるのよ……。",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "妻の役は私じゃなかった？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "そのフレーズ、気に入ったの？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "気遣いはありがたいんだけど……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "妻の役は私じゃなかった？\\n前に、そんなこと言ってたじゃない。\\n生活に困った新妻がどうのこうのって。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "まあ、覚えててくれたの？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "別に、覚えてたわけじゃ……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "正しくは、生活に困っても\\n愛があれば大丈夫な新妻役、ね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "シャロちゃんって、\\nどこかそういう雰囲気があるし、\\n私としてはぜひやってほしいわ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "どういう雰囲気なのよ！\\nあんたは私に何を求めてるの！？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "そのフレーズ、気に入ったの？\\n最近よく言うけど。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "なんだか健気な感じがしていいでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "……何がいいのかさっぱりだわ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "あら、そう？\\nシャロちゃんなら\\nわかってくれると思ったのに。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "そんな期待をされても困るわよ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "気遣いはありがたいんだけど……\\nどうして余計な一言を付け加えるのよ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "余計な一言って？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "だから……通い妻とか……。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "何かおかしいかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "おかしいっていうか、\\nなんだか……いかがわしいわ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "あらやだ。\\nシャロちゃんたら、どんな想像をしてるの？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "う、うるさいわねっ！\\n用が済んだなら、さっさと学校に行きなさい！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "それじゃ、ちゃんと食べてしっかり休んでね。\\n無理してバイトに行ったりしちゃだめよ？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "わかった。\\n今日１日くらいは大人しくしてるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "約束よ？\\n夜はまた温かいご飯を用意してくるわね。\\nそれじゃ、行ってきます。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "行ってらっしゃい。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "（はあ……。\\n　本当に、どうしたらいいのかしら）",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}