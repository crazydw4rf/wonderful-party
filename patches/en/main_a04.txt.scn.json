{
  "identity": "main_a04.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ありがとうございましたー！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "今のお客さんが最後ですね。\\n今日はこれで閉店です。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "ああ、お疲れ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "お疲れ様、チノちゃん、リゼちゃん！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "お疲れ様です。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "さて、それじゃ片付けをするか。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "私は食器などを片付けます。\\nフロア側はお２人におまかせします。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "ああ、まかされた！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "では私がテーブルを拭く！\\nココアは床の掃除だ！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "はーい！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "返事はイエスだ！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "イエッサー！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "よしっ！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "……いつもながら、暑苦しいです。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "タカヒロ",
          "original": "やあ、もう閉店かな？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "あ、はい！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "今、片付けをしてるところです。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア（Ｍ）",
          "original": "（この人は、チノちゃんのお父さん）",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア（Ｍ）",
          "original": "（喫茶店にはあまりいないけど、\\n　夜になると、ティッピーと一緒に\\n　バーのマスターとして働いています）",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "タカヒロ",
          "original": "みんな、ご苦労様。\\n今日もよく頑張ってくれたね。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "いえ、雇われている身として当然のことですから。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "私も、お世話になっている分、\\nちゃんと頑張ります！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "でも、まだまだ失敗も多いですけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "タカヒロ",
          "original": "いや、そんなことはないさ。\\nココアくんもずいぶん成長しているよ。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "えっ？",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "タカヒロ",
          "original": "それじゃ。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "あ、はいっ！",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "リゼ",
          "original": "へえ、よかったじゃないか。\\n親父さんに褒められるなんて。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "う、うん！\\nびっくりしちゃったけど嬉しい！",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "リゼ",
          "original": "でも確かに、今日のココアは\\nかなり頑張ってたよな。\\nミスもほとんどなかったし。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "ココア",
          "original": "えへへ、そうかな～？\\nここでのお仕事に慣れてきたからかな？",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "チノ",
          "original": "やっと慣れてきたんですか。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ココア",
          "original": "はう、やっとって言われた……。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "リゼ",
          "original": "はははは。\\n親父さんと違ってチノは厳しいな。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "チノ",
          "original": "ココアさんは、\\n甘やかすとすぐに調子に乗りますから。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "ココア",
          "original": "さすがチノちゃん、\\n私のことをよくわかってるね！\\n妹だからかな？",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "チノ",
          "original": "だから、妹じゃないです。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "チノ",
          "original": "それよりも手を動かしてください。\\n片付けが終わりません。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "ココア",
          "original": "あっ、そうだったね！\\nごめんごめん、掃除道具持ってくる！",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "リゼ",
          "original": "どうした、チノ。\\nなんだか元気がないぞ？　疲れたのか？",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "チノ",
          "original": "いえ、疲れていません。\\n最近はココアさんのフォローを\\nしなければいけない機会も減ってますから。",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "リゼ",
          "original": "ん？\\nさては、フォローする機会が減って寂しいのか？",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "チノ",
          "original": "そ、そんなわけないです。\\nリゼさんも早く片付けしてください。",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "リゼ",
          "original": "了解。",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "チノ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "ティッピー",
          "original": "チノ、どうした？",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "チノ",
          "original": "大丈夫です。\\n別に、なんともないです。",
          "translation": "",
          "status": "untranslated"
        },
        "47": {
          "speaker": "ティッピー",
          "original": "ふむ、そうか。",
          "translation": "",
          "status": "untranslated"
        },
        "48": {
          "speaker": "リゼ",
          "original": "じゃあ、またな。",
          "translation": "",
          "status": "untranslated"
        },
        "49": {
          "speaker": "ココア",
          "original": "うん！\\nまたね、リゼちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "50": {
          "speaker": "チノ",
          "original": "お疲れ様でした。",
          "translation": "",
          "status": "untranslated"
        },
        "51": {
          "speaker": "ココア",
          "original": "さて！\\nそれじゃ、一緒に夕飯の支度をしよっか。",
          "translation": "",
          "status": "untranslated"
        },
        "52": {
          "speaker": "チノ",
          "original": "一緒に、ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "53": {
          "speaker": "ココア",
          "original": "うん、一緒に！",
          "translation": "",
          "status": "untranslated"
        },
        "54": {
          "speaker": "チノ",
          "original": "はい、わかりました。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}