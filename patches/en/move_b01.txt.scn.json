{
  "identity": "move_b01.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "リーゼちゃん！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "何だ、どうした？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "何って、コーヒーを飲みに来たんだよ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_0101": {
      "texts": {
        "0": {
          "speaker": "ココア（Ｍ）",
          "original": "（チノちゃんは……\\n　そっか、市場で買い出し中なんだった。\\n　まだ戻っていないんだね）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "あれ？　チノちゃんは？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "ああ、市場まで買い出しに行ってるよ。\\n足りないものがあってさ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "あ、そうなんだ。\\nじゃあ、今はリゼちゃん１人なんだね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "じゃあ、今日は私、お客さんしてるね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "ああ、空いてる席に適当に座っていいぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "もー、リゼちゃん！\\n今日の私はお客さんなんだからね？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "私だからってそんな接客してると、\\nラビットハウスは無礼なお店だって\\n思われちゃうよ？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "いや、見ての通り、今のお客はココアだけだし。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "それでも、普段からきちんとしないと、\\nいざという時にボロが出たりするんだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "う……ココアらしくもなく正論を……。\\nわかった、ちゃんと接客するよ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "いらっしゃいませ。\\n１名様ですね？\\nお席はこちらでよろしいですか？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "はい、いいですよ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "リゼ",
          "original": "ご注文、お決まりの頃にお伺いいたします。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "もう決まってまーす！\\nオリジナルブレンドと、\\n今日のケーキをお願いします。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "かしこまりました。\\nオリジナルブレンドと本日のケーキですね。\\nそれでは、少々お待ちください。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "……違う。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "お客様？　どうかなさいましたか？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "何か違う！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "リゼ",
          "original": "は？　違うってなんだ？\\n普通にいつもどおりに接客してるだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "その、いつもどおりが違うんだよ。\\nちっともラビットハウスぽくないよね？\\nなんか普通！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "フルール・ド・ラパンも甘兎庵も独自のカラーを\\n出してるのに、ラビットハウスは普通だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "いや、まあ、そうかもしれないけど……\\nじゃあ、ココアの思うラビットハウスっぽい\\n接客ってどんなものなんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "もちろん、ラビットハウスなんだから\\nうさぎっぽさを前面に出すべきだね。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "でも、制服にうさ耳をつけると\\nフルールとかぶるな。\\n他に何かあるのか？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "リゼ",
        "original": "でも、制服にうさ耳をつけると\\nフルールとかぶるな。\\n他に何かあるのか？",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "手でうさぎの耳を作るとか？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "もふもふになるとか？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "ぴょんぴょん跳ぶとか？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "手でうさぎの耳を作るとか？\\nこう、ぴょんぴょんって感じで。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "お、おお……。\\nそれは、なんだ、うん、かわいいかもな。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "じゃあ、さっそくやってみて？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "って、本当にやる気なのか！？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "そうだよ？\\nほら、リゼちゃんカモン！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "ま、待て！\\n普段はメニュー表とかお盆を持ってるから\\nその場でやるのは難しいだろ、これ！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "あ、そっか。\\n手ぶらになる時って、案外ないもんね。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "ああ、そうだろ？\\nだからこれは却下だな。ああ、却下だ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "もふもふになるとか？\\nほら、ティッピーみたいに。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "つまりコスチュームでの差別化か。\\nまあ、悪くない考えだな。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "しかし、もふもふってなんだ？\\n具体的にはどんな服を着るんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "それは……えーっと……\\nティッピーみたいなまんまるの着ぐるみ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "おいおい、それで働くのは\\nいくらなんでも無理だろ。\\nていうか、もはや服ですらないぞ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ぴょんぴょん跳ぶとか？\\nうさぎみたいに、ぴょんぴょんって。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "まあ、コンセプトとしてはわかりやすいな。\\nうさぎだってすぐにわかるし。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "でもなぁ、喫茶店で\\nドタバタするのはよくないだろ。\\n静かにコーヒーを楽しみたい人だっているんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "それに、ぴょんぴょんしながら\\nコーヒーを運ぶのは無理だし。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "そ、そうだね……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "んー、じゃあ、\\n語尾にぴょんってつけるのはどう？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "語尾に……ぴょん！？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そうだぴょん！\\nって、こんな感じね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "ぴょんって言うだけなら、\\n何の準備もいらないし、誰でもできるし\\nすっごくうさぎっぽいぴょん。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "いや、うさぎっぽいか？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "ちょっと練習してみるぴょん。\\nいらっしゃいませぴょん！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "う……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "ほら、リゼちゃんも言うぴょん。\\nいらっしゃいませぴょん！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "いらっしゃいませ、ぴょん……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "もっと大きな声でぴょん！\\nいらっしゃいませぴょん！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "い、いらっしゃいませぴょんっ！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "青山",
          "original": "いらっしゃいましたぴょん。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "あ、あああ、青山さん！？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "青山",
          "original": "特殊な語尾……ですか。\\n使い古されてはいますが、実際に聞くと\\n案外、創作意欲をかき立てられますね。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "ちち、ち、違うんだ！\\n今のは、その、とにかく違う！！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "青山",
          "original": "ぴょんを忘れていますよ？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "うわあああああ～！\\n頼む、忘れてくれ～！！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}