          "original": "……あ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア（Ｍ）",
          "original": "（野良うさぎ、逃げちゃった。\\n　チノちゃん、やっぱりティッピーや\\n　あんこ以外の動物が懐かないんだ）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "チノちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "ココアさん。\\n……もしかして見てましたか？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "ご、ごめんね。\\nそういうつもりじゃなかったんだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "いいんですよ、私にはティッピーがいますし\\nそれで充分です。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア（Ｍ）",
          "original": "（そう言ってるけど\\n　チノちゃん、寂しそうだよ……）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
