{
  "identity": "flyer_syaro_i3.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はシャロちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "フルール・ド・ラパンでーす。\\nお願いしまーす。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "あ……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア（Ｍ）",
          "original": "（シャロちゃん、背中が無防備だ。\\n　よーし……）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア（Ｍ）",
          "original": "（そっと、そっと――\\n　こっそり、こっそり――\\n　ぬきあしさしあしで――）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "シャーロちゃん！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "ひゃあ！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "大成功～！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "何するのよ！\\nいきなり触ったら冷たいでしょ！？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "えへへ～。\\n背中が無防備だったから、つい。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "もう、ホントびっくりしたんだから！\\nココアにもやっちゃうわよ！\\nえいっ！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ひゃあ！　冷たいよー！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "ふふふ、冷たさがわかったようね。\\nこれに懲りたら――",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "やり返しちゃうぞっ！\\nえい！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "きゃあ！？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "やったわねー！\\nこっちも仕返しよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "じゃあ、仕返しの仕返しだー！\\nえいっ！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "なら、仕返しの仕返しの仕返しよっ！\\nほらっ！　どう！？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "あははははっ！\\nま、参りました～！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "シャロ",
          "original": "ふふん、思い知ったわね？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "うん！\\nこういうの楽しいね、シャロちゃん！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "え、ええ、そうね。\\nまあ、楽しくないこともないわね。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "すっかりココアにのせられちゃったわ。\\n周りの人に、わ、笑われてる～！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}