{
  "identity": "flyer_rize_h1.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はリゼちゃんとチラシ配りをしよう！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "なあ、ココア。\\n聞きそびれてたんだけど、\\nこれってなんの衣装なんだ？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "なあ、ココア。\\nこれってなんの衣装なんだ？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "あれ？　リゼちゃん、知らない？\\nこれは怪盗ラパンだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "怪盗！？\\nそんなやつが現代にいるのか、それは驚きだ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "あはは、実際にいるんじゃないよ。\\n今人気の、子ども向けアニメなんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "ふうん、そんなものが流行ってるのか。\\n子ども向けなのに楽しめるのか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "うん！　泣かせるお話とか\\n考えさせられるお話も多くて、\\n毎週、楽しみにしてるんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "へえ……。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "じ、自分が何の格好をしているかは\\nきちんと知るべきだな。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "というわけで、\\n怪盗ラパンについてもっと教えてくれ。\\nまず、どんな怪盗なんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "えーっとね……\\nとってもかわいくて可憐な女の子なんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "リゼ",
          "original": "女の子なのか！\\nって、まあ、この服を着てるのなら当然か。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "毎週、予告通りに華麗に活躍！\\nラパンに盗めないものはないのだ！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "ほう、つまり有能なのか。\\n察するに、百戦錬磨、戦場経験豊富な\\nキャプテンといった人物か。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "なんで戦場なの！？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "それで、他にはどんな特徴があるんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "えーっと……。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "あ、そうそう！\\nラパンには、リゼちゃんっぽい感じの\\n格好いい台詞があるんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "こう、敵に向かってトランプを構えて――",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "怪盗ラパン、参上！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "おお……！\\n確かにかっこいいな！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "リゼちゃんも真似してみて。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "よし。\\n敵に向かって構えて――",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "怪盗ラパン、参上！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "ラパンは銃、使わないよ！？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "観念しろ！　怪盗！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "ていうか怪盗はリゼちゃんだよ～！？",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}