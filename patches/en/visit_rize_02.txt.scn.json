{
  "identity": "visit_rize_02.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "こんにちは……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "千夜ちゃん！？\\nどうしたの？　なんかヘロヘロだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "ええ、ちょっと……。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "もしかして……\\n別の喫茶店からの刺客に追われているのか！？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "甘兎庵の跡取り娘に迫る魔の手……！\\nハードボイルドな展開だね！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "次々と襲われていく喫茶店の看板娘……。\\n次に狙われるのは……チノかもしれない！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "チノちゃん、大丈夫だよ！\\nお姉ちゃんが守ってあげるからね！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "大丈夫です。\\nそもそも、リゼさんの冗談ですから。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "冗談だったの！？\\n喫茶店ガール連続殺人事件かと思ったのに。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "勝手に殺さないでください。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "千夜",
          "original": "ふふふっ！\\nラビットハウスさんはいつも楽しそうね。\\nさっそく元気をもらっちゃった。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "でも、どうしてそんなに疲れてるんだ？\\n何かあったのか？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "千夜",
          "original": "それが……配達で疲れちゃって。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "配達で？\\nそれは体力なさすぎじゃないか？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "千夜",
          "original": "お届け先に行くまで、上り坂や階段が多かったの。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "千夜",
          "original": "でも、確かに体力不足は感じているのよ。\\n体力づくりのために何か始めた方がいいかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "ああ、体力はあって損はない。\\nなんなら私が特別レッスンをしてやるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "千夜",
          "original": "本当？\\nそれはありがたいわ。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア（Ｍ）",
          "original": "（リゼちゃんの特別レッスン……？）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "ココア",
        "original": "（リゼちゃんの特別レッスン……？）",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "特別レッスンってどんなことするの？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "（ここはそっとしておこう！）",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "間違いなく効果があるよね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ねえ、リゼちゃん。\\n特別レッスンってどんなことするの？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "おっ、ココアも興味あるのか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "聞いて驚け、泣く子も黙る軍隊式訓練だ。\\nどんなやつでも１週間で一人前の軍人になれるぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "な、泣く子も黙る？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "必要なのは途中で投げ出さない根性だけ。\\nそれだけで、見違えるほど体力がつくんだ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア（Ｍ）",
          "original": "（ここはそっとしておこう！\\n　触らぬ神に祟りなし、って言うし）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "リゼさん、\\nどんなレッスンをするつもりなんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア（Ｍ）",
          "original": "（ああ～！\\n　チノちゃんが触っちゃった！？）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "聞いて驚け、泣く子も黙る軍隊式訓練だ。\\nどんなやつでも１週間で一人前の軍人になれるぞ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "間違いなく効果があるよね。\\nリゼちゃんの特別レッスンだもん。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "ああ、泣く子も黙る軍隊式訓練だからな。\\n１週間で鋼の体が手に入るぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "鋼の体！？\\nなんだかすごそう！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "これは、途中で脱落さえしなければ\\n目覚ましい効果がある訓練なんだ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "ね、ねえ、リゼちゃん。\\nそれって具体的にはどんな訓練なのかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "うーん、細かい部分は\\n千夜の今のレベルに合わせて\\n考えることになりそうだけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "例えば、１日に８０回程度の腕立てと腹筋。\\n３キロ程度の持久走。\\nこれが基本コースだな。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "ええっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "本当の軍隊なら、部隊のミスの連帯責任で\\nさらに何百回も腕立てを加算される場合もあるけど\\n今回はそれはないから安心だな。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "もっと高度になると、\\n最低限の食事で３６時間の野外行軍。\\nその途中で数学の問題を出したりするんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "そんな……！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "まあ、今回はそこまでする必要はないし、\\n大したことはない――",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "ん？　どうしたんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "殺す気なのね？\\n私を……殺すのね？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "あれっ！　千夜ちゃん！？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "助けてっ！\\n殺されてしまうわ～！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "お、おい！\\n何を大声で言ってるんだ！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "これではお店の評判にも大ダメージです！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ティッピー",
          "original": "リゼェェェェェェ！\\nなんてことをぉぉぉ！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "おお！\\nこれぞまさに喫茶店ガール殺人事件だね！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}