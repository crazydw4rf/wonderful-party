{
  "identity": "visit_rize_01.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "あの、先輩。\\n何も言わずに来ちゃって、大丈夫でしたか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "そんなの気にしなくていいよ。\\nここは喫茶店なんだから。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そうだよ。\\n暇だったし、大歓迎だよ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "ココアさん、仕事がないなら\\nコーヒーの味の違いでも覚えてください。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "バリスタを目指すのなら、\\nコーヒーの判別ぐらいできて当然です。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "はーい……。\\n街の国際バリスタ弁護士への道は険しいね。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "はは、美しい師弟愛だな。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "えっ！？\\n何か私がチノちゃんの弟子ってことにされてない？\\n私はチノちゃんのお姉さんなんだからね！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "いや、それ、並べるものじゃないだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "それに、どちらかといえば\\nココアさんよりリゼさんの方が\\nお姉さんって感じがします。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "そんなっ！　ライバルが増えちゃった！？\\nよーし、だったら――",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "ねえねえ、シャロちゃん！\\nシャロちゃんは、リゼちゃんと\\n同じ学校に通ってるんだよね？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "なに、今更。\\nそれがどうしたの？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "学校でのリゼちゃんってどんな感じなの？\\nライバルの情報は少しでも仕入れておかなくちゃ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "本人を目の前にしてスパイ活動をするな！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "というか、学年が違うから\\nリゼ先輩の学校での様子なんてわからないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "私だって、本当は\\nリゼ先輩と一緒の学年がよかったけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "あ、そうだった。\\nリゼちゃんって私たちより年上だったね。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "忘れてたのか！？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "リゼちゃんって年上って感じがしないから。\\n話しやすいからかな？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "え？　そうか？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "はい！\\nリゼ先輩、気さくに話してくれますから\\nそういうところ、安心します。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "じゃあ、逆に\\nリゼちゃんの年上っぽい部分ってどこだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "おい！？\\nなんでそんな話題になるんだ！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "リゼさんは頼りがいがあります。\\nそこは年上っぽいです。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "そうだよね！\\n私が思うリゼちゃんはね……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "ココア",
        "original": "そうだよね！\\n私が思うリゼちゃんはね……。",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "年上の色気があるね。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "軍人らしくてかっこいいよ！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "すごくかわいいよね！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "年上の色気があるね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "色気！？\\nそんなことないだろ、私に色気なんて。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "だ、大体、さっきまで年上って感じがしないとか\\n言ってたのに、ココアは調子がよすぎるだろ。\\nまったくもう。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "年上の魅力……色気……。\\n私も、早く成長したいです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "軍人らしくてかっこいいよ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "わ、私は軍人じゃない！\\n普通の女子高生だ！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "普通の……女子高生……？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "チノまで！？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "で、でも！　先輩はかっこいいと思います！\\n野良うさぎから助けてくれて、\\nいつも感謝してますっ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "すごくかわいいよね！\\nツインテールも似合ってるし！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "かわいい！？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "わ、私がかわいいなんて、そ、そんなこと……。\\nそれに、かわいいと年上らしさなんて\\n関係ないじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "今のリゼちゃんも、すごくかわいいよ～。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "だから、関係ないだろ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "あ、あの！　リゼ先輩！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "私から見て、先輩は優しいですし、\\nいつも堂々としてて立派で……\\nとにかく素敵ですっ！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "なんだ、シャロは大げさだな。\\n私は別に、普通にしてるだけだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "私もリゼちゃんのこと、尊敬してるよ。\\nお仕事だってバリバリできるし\\nついつい頼っちゃう。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "ま、まあ、ココアもチノも\\nいつでも私に頼っていいからな！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "あ、お客さんだ！\\nリゼちゃんの接客、見せてほしいな～。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "よし、任せろ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "いらっしゃいませ。\\n何名様ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "はい。\\nでは、お席へご案内します。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "すごいよ、リゼちゃん。\\n完璧でかっこいい接客だよ！\\nじゃあ、次は……。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "先輩っ！\\nココアに仕事を押し付けられてます！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "はっ！？\\nまさか、ココアにしてやられるとは……。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "てへへ、バレちゃった。\\nごめんね、すごくキビキビ動いてくれるからつい。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "罰として、今日の掃除は\\nココアさん１人にやってもらいましょう。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "ええ～っ！　そんな～！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "自業自得でしょ……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}