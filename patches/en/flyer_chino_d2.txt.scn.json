{
  "identity": "flyer_chino_d2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "ココアさん……。\\n私の格好、どこかおかしくありませんか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "え？　どこもおかしくないよ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "そうですか。\\nならどうして……？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "何かあったの？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "その……チラシを受け取っていく人たちが、\\n私を見て、妙な顔をするように思えたので。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "にやけた顔というか……\\nチラシを受け取っただけなのに\\n頬が緩んでいるんです。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "ああ、なんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "大丈夫だよ、チノちゃん。\\nそれはね、チノちゃんを見て\\nにこにこしてただけだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "今のチノちゃんの格好\\nすごくほほえましいんだもん。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "ラパンの制服のおかげでうさぎみたいなのに、\\n頭にティッピーまで乗せちゃってるでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "それがかわいらしくて、\\nみんな、にこにこしちゃったんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "そうだ、これで私がチノちゃんをおんぶしたら、\\nうさぎさんの上のうさぎさんの上に\\nうさぎさんだね！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "早口言葉！？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "ちょっとやってみようか？\\nヘイ、カモン！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "嫌です。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "あ、チノちゃんが私をおんぶしたかった？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "どうしてそうなるんですか！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "肩車でもいいよ？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "しません。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "なら、ティッピーが私をおんぶして――",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ティッピー",
          "original": "できるか！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "ティッピーを押しつぶすつもりですか！？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "えー？\\n私、そんなに重くないよ。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "ココアさんの重さの問題でなく、\\n体の大きさを考えてください！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "……それにしても、\\n自分がそんな風に見られているなんて\\n思ってもみませんでした。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "自分で自分の姿は見られないもんね。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "……おかしいわけではないんですよね？",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "うん、すっごくかわいい♪",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "チノ",
          "original": "……そうですか。\\nでは、とりあえずよしとしておきます。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}