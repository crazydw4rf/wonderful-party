{
  "identity": "flyerhap_chiya_i.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "千夜ちゃん！\\nチラシ配り、一緒にやろっか。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "もちろんいいのだけど、\\n今日はみんな揃って\\n配ることができそうだから、そうしない？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そうなんだ！\\nじゃあ、せっかくだしみんな揃ってやろう。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "少し冷えてきましたね。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "もう、チノちゃんは甘えん坊だね。\\nいいよ、お姉ちゃんがだっこして温めてあげる！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "結構です。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "め、明確な拒絶だ！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "でも、確かに冷えるわね。\\n温かいものが食べたくなるわ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "温かい物……。\\nお鍋なんていいわよね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "そうだわ、甘兎庵の冬メニューに\\nお鍋料理を加えようかしら。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "ああ、また千夜の暴走が始まる予感が。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "というか、甘味処でお鍋ってありなのか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "深く考えない方がいいです……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "お鍋っぽいメニューかぁ。\\nじゃあ、具の形のお菓子はどうかな？\\nしいたけ型の羊羹とか。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "練り切りだったら、\\n人参やネギや大根も作れるわね。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "ほたて、鶏、魚の切り身も和菓子で作って、\\n土鍋に盛り付けて出すの。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "いいわね。\\n見て楽しくて、食べて満足できそう。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "でも土鍋はちょっと大きすぎるし、\\nお汁粉用の器を使って、お鍋から取りわけた風に\\n見せるのがよさそうね。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "でもそれって、結局、お菓子の盛り合わせよね？\\n鍋なら温まるメニューじゃないとだめじゃない？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "あら、そうだったわ。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "まあ、普通にお汁粉を食べた方がよさそうだな。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "お汁粉……。\\n熱々のお汁粉……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "……ごくり。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "千夜",
          "original": "じゃあ、このあと、みんなでうちに来て\\n温まっていかない？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "えっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "やったー！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "正直、ありがたいよ。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "でも、いいの？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "千夜",
          "original": "実は、こうしてみんなを招いて、\\nこっそりお鍋メニューの試作を作って\\n試食してもらおうかなー、なんて。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "普通のお汁粉がいい！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "うふふ、冗談よ。\\nさあ、温かいお汁粉を楽しみに\\nみんな、頑張りましょ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}