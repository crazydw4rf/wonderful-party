    "*sel_03_join": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "そろそろ焼けたはずですね。\\nオーブンを開けてみましょう。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "マヤ",
          "original": "どうなったかなぁ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "メグ",
          "original": "どきどきする～！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "それでは、出します。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "あ……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "メグ",
          "original": "……ふくらんでないね。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "マヤ",
          "original": "あれ？　おっかしいなぁ？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "（ココアさんが作るパンみたいに、\\n　ふんわり焼けたスポンジを\\n　期待していたのに……）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "マヤ",
          "original": "なんだか入道雲みたいな、\\nもこもこしたスポンジだなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "メグ",
          "original": "生焼けな部分もあるみたいだね。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "……どうしてでしょうか？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "マヤ",
          "original": "じゃ、じゃあ、今度は違う本のを試してみよう。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "メグ",
          "original": "うん、そうだね。\\n最初だし、失敗することもあるよね。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "はい……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "マヤ",
          "original": "この本なんてどうかな？\\nイラスト付きで簡単そうじゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "メグ",
          "original": "うん、それがいいかも。\\nチノちゃん、これを参考にやってみようよ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "……そうですね。\\n１回の失敗で落ち込んでいる場合ではありません。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "マヤ",
          "original": "そうそう！\\n失敗を活かして、今度は成功させようぜ！",
          "translation": "",
          "status": "untranslated"
        }
      }
