{
  "identity": "all_d05.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "（確か、待ち合わせは\\n　この公園でよかったわよね？\\n　ココアちゃんは……あ、いたわ！）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "ココアちゃーん、お待たせー！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "あ！　千夜ちゃんっ！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "私の担当分は終わったから、\\nココアちゃんのお手伝いをするわね。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "ありがとう！\\n千夜ちゃん、本当にごめんね。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "ううん、いいのよ。\\n困った時はお互い様。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "それに、ココアちゃんは\\nまだこの街に慣れていないところもあるし、\\n迷っても仕方ないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "それもそうなんだけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "夜って出歩かないし、暗くて道がよくわからないし、\\n方向感覚まで変な感じになっちゃって……うう……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "うんうん、つらかったわね。\\nでも私が来たから、もう大丈夫よ。\\n２人で頑張って終わらせましょうね。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "千夜ちゃん……！\\n今、私には千夜ちゃんが女神様に見えるよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "ふふ、懐かしいわねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "えっ？　何が？\\n女神様が？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "ううん、違うわ。\\nココアちゃん、私と初めて出会った時も\\n道に迷っていたわよね。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "あ、そういえばそうだったね。\\nあの時も、千夜ちゃんが\\n学校まで案内してくれたっけ。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "そう考えると……千夜ちゃんとのあいだには\\n運命みたいなものを感じるなぁ。\\n私が困った時は、必ず助けてくれるし。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "私も感じてるわよ？\\nだって、ココアちゃんと出会ったことで――",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "千夜",
          "original": "楽しいことや不思議なことを\\nたくさん体験できたから。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "今日のことだってそう。\\nココアちゃんがいなかったら、\\nこんな経験、できなかったもの。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "千夜",
          "original": "だから、私もココアちゃんにお礼を言うわね。\\nありがとう、私の友達になってくれて。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "千夜ちゃん……！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "あ、いた！\\nココアー！　千夜ー！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "あら？\\nココアちゃんを助けに、\\nみんなも来てくれたみたいよ？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "あ、ホントだ。\\n来てくれたんだ……！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "ココアさん、大丈夫ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "うん、大丈夫。\\nごめんね、お姉ちゃんなのに\\n情けない姿を見せちゃって……。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "リゼ",
          "original": "すまなかったな。\\nココアが街に不慣れなのを考慮すべきだったよ。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "ううん、そんな！\\nこっちこそ、迷惑かけちゃってごめんね。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "シャロ",
          "original": "もういいわよ。\\nココアに迷惑かけられるのには慣れてるもの。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "わ、私、そんなに迷惑かけてる！？",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "シャロ",
          "original": "別に気にしなくていいわよ。\\nみんなでフォローしていくから。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "シャロ",
          "original": "そ、そうですよね、先輩。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "リゼ",
          "original": "ああ、そうだ。\\nだからそんな顔しなくていい。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "う、うんっ！\\nありがとう、みんなっ！",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "リゼ",
          "original": "さあ、時間が止まっているとはいえ急がないとな。\\n行くぞ、ココア！",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "千夜",
          "original": "さあ、ココアちゃん？",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "シャロ",
          "original": "ココア！",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "チノ",
          "original": "ココアさん。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "ココア",
          "original": "うん、行こう！！\\nみんなで、最高のクリスマスにするために！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}