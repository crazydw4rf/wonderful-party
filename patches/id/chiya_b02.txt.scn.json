{
  "identity": "chiya_b02.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "じゃあ、ココアちゃん。\\nもう１度、地図の確認をしておきましょ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "あれから２人で考えたけど、\\nこの地図が示してる場所はこの公園で\\n間違いないよね。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "ええ、場所的に見て、ここしか考えられないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "この地図には、\\n方角と木の本数が記されているわね。\\nそれが鍵になっているんじゃないかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "この地図に書かれていることを分析すると――",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "ちょうど、この広場から東の方向に歩いて\\n５本目の木の根本に宝箱が埋まっている。\\nそう読み解けるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "ここから５本目……あの木だね！\\nじゃあさっそく、掘り起こしてみよう！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "ふう～。\\nかなり掘ったと思うんだけど……\\n宝箱、出てこないね。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "おかしいわね。\\n地図によると、確かにこの場所にあるはずなのに。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "うーん、じゃあ、どうして出てこないのかな？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "千夜",
          "original": "……もしかしたら、だけど。\\nこの地図は昔に書かれたものみたいだから――",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "倒れたり、枯れたりして\\n木の本数が変わっているのかもしれないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "それだっ！\\n千夜ちゃん、冴えてるね！\\nさすがは私の相棒だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "うふふ、ありがとう。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "千夜",
          "original": "でも、そうなると困ったわね。\\n手がかりがなくなっちゃったわ。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "ううん、木の下に埋められたことは\\n間違いないんだから、この辺りの木を\\n全部掘ってみよう。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "相棒の正しさを証明するのが、今の私の役目！\\n絶対に宝箱を見つけてみせるよ！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "千夜",
          "original": "ココアちゃん……！\\nそうね、頑張ってみましょう！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "うん！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "これで６本目かぁ。\\nさすがに私も限界が近いかも……。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "千夜",
          "original": "そうね……。\\n私も……もう腕が……。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "で、でも、ここで諦めるわけにはいかないよ！\\nあとひと踏ん張り、もうひと踏ん張り！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "きっと、この下に宝箱があるはず……。\\nそう信じて、頑張りましょう……。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "よいしょ、よいしょ……！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "あれ！？\\n今、何かに当たった！",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "千夜",
          "original": "ほ、本当！？\\nどうしましょう、ココアちゃん！？\\nおお、お、落ち着いてっ！",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "千夜ちゃんこそ落ち着いて！？",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "千夜",
          "original": "そ、そうね。\\n宝物が見つかると思ったらつい。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "うん、そのどきどきする気持ちは\\nすっごくわかる！　ついに……だね！",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "千夜",
          "original": "それじゃ……。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "千夜",
          "original": "ああ、見えてきたわ！\\n間違いなく宝箱よ！",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "ココア",
          "original": "やったぁ～！\\nトレジャーハント、大成功だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "千夜",
          "original": "苦労した甲斐があったわね、ココアちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "うんっ！\\nじゃあ、さっそく開けてみよう。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "千夜",
          "original": "ええ！\\nもう、どきどきして心臓がうるさいくらいだわ。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "ココア",
          "original": "んしょ……！\\nあ、開いたよっ！",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "千夜",
          "original": "中に紙が入ってるわね。\\nこれが秘密のレシピかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "ココア",
          "original": "さあ、スペシャルレシピのご開帳だよっ！",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "ココア",
          "original": "……あれ？\\nこれって……。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "千夜",
          "original": "地図、よね。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "ココア",
          "original": "どういうこと？\\nレシピはどこにいっちゃったの！？",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "千夜",
          "original": "シストだと、宝箱の中に次のポイントを示す\\n新しい地図が入っていることもあるのだけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "ココア",
          "original": "なるほど！\\nそうやって宝物に導かれていくんだね。",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "千夜",
          "original": "もしかしたら、これもそうなのかもしれないわ。\\nどうする？　続けてみる？",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "ココア",
          "original": "当然だよ！\\nここまで来て引き返すなんて、\\nトレジャーハンターの名が泣くよ！",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "千夜",
          "original": "ええ！\\nそれじゃ、もう少し宝探しを続けましょう。",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "ココア",
          "original": "うん！\\nじゃあ、次の宝箱までレッツゴー！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}