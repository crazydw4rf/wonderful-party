{
  "identity": "flyer_chino_f1.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "メリークリスマース♪",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "ココアさん、はしゃぎすぎですよ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "えへへ～。\\nこういう服を着ると、いやでも\\nテンション上がっちゃって。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "それは……わからなくもないですけど。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "でも、この衣装には、\\nまだ足りないものがあるって思わない？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "え？　足りないものですか？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "うん、それは――",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "じゃーん、おひげです！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア（Ｍ）",
          "original": "（あれ？\\n　わざわざ見つけてきたのに、\\n　なんだかチノちゃんの反応が薄い？）",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "出かける前に\\n何かごそごそしていると思ったら……\\nそんなものを探していたんですか。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "だって、サンタさんていったら\\nやっぱり白いおひげでしょ？\\nチノちゃんの分もあるけど、つける？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "いえ、結構です。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "そう？\\nつけたら雰囲気が出ていいと思うんだけどな～。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "あの……ココアさんにそのおひげは\\n似合わないと思いますよ？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "えっ！？　どうして？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "スカート姿の女性に、\\nひげが似合うとは思えません。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "……うん、そうかも。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "それに、それを付けたら\\nおひげが口の中に入ってきて\\nすごく邪魔そうです。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "むむむ、サンタさんは大変だね。\\nこんなおひげを生やさなくちゃいけないなんて。\\nご飯を食べるのも大変そうだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "いえ、別にひげを生やすのは\\nサンタさんの義務ではないと思いますが。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "えー、でもサンタさんていったら\\n白いおひげじゃない？\\nチノちゃんだって、生えててほしいよね？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "チノ",
          "original": "……正直言えば、そうです。\\nサンタさんには申し訳ないですけど、\\nひげは大事にして欲しいですね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}