{
  "identity": "flyerhap_syaro_a.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "シャロちゃん！\\nチラシ配り、一緒にやらない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "いいけど、今日はリゼ先輩達も一緒に\\n配ることができるって聞いたわよ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そうなんだ！\\nじゃあ、みんな揃ってやろっか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "ちょっと休憩しましょうか。\\nみんな、ずいぶん頑張ったものね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "さすがに疲れたわね……。\\nふう……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "おおー！\\nシャロちゃん、今の言い方とかポーズ、\\n愁いを含んでお嬢様っぽいね。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "え？　どこが？\\n普通にしてるだけよ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "いいえ、どこか魔性を感じさせるほどだったわ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "千夜まで……からかわないでよ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "魔性！？\\nなにを、魔性なら私も負けてないよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "大声出してなんだ？\\n魔性がどうしたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "前にね、千夜ちゃんに手相を見てもらった時、\\n『魔性の相がある』って言われたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "というわけで！\\nシャロちゃん、どっちが魔性か私と勝負だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "どういうわけなのよ。\\nなんで私がそんな勝負しなきゃならないの？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ではでは、魔性対決始まりまーす！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "人の話、聞いてない！？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "勝負方法は……\\nチノちゃんを口説き落とした方の勝ち！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "はい？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "それって魔性か！？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "じゃあ、私が先攻ね。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "こほん！\\nお嬢さん、ハンカチを落としましたよ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "え？　えっと……。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "ありがとうございます。\\n助かりました。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "いいえ、どういたしまして。\\nきちんとお礼が言えるなんて、\\n礼儀正しく素敵な人ですね。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "もっとお話したいな。\\nよかったらお茶でもいかがですか？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "意外に自然な流れで持っていった……！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "こんな感じかな。\\nどうチノちゃん、魔性を感じた？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "魔性はともかく、ハンカチ拾ってくれた\\nわけですし、悪い人ではなさそうです。\\nでも、見ず知らずの人についていきはしません。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "くうっ！\\n魅力が足りなかったか！",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "じゃあ、次はシャロちゃんの番だよ。\\nはい、チノちゃんを口説いてみて。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "シャロ",
          "original": "あ、ええと……じゃあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "シャロ",
          "original": "す、素敵なお嬢さんね。\\nあの……なんて言ったらいいのか……。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "シャロ",
          "original": "わ、私のアルバイトしているお店に\\nお茶を飲みに来てくださいっ！",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "チノ",
          "original": "は、はい！",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "千夜",
          "original": "あらあら。\\nこれじゃ、フルールの宣伝ね。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "チノ",
          "original": "あ、はい……。\\n何というか、あまりの必死さに\\n思わず返事をしてしまいました。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "シャロ",
          "original": "だ、だから、私には無理なのよっ！\\n魔性なんてないんだから！",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "リゼ",
          "original": "いや、これは魔性なんて関係ない\\nただのナンパだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "ココア",
          "original": "そんなこと言うなら、リゼちゃんもやってみてよ。\\nお手並み拝見だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "リゼ",
          "original": "なんでだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "シャロ",
          "original": "あ、あの、私も……\\n先輩の魔性、見てみたいような……。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "リゼ",
          "original": "まったく、仕方ないな。\\nじゃあ、うーん……。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "リゼ",
          "original": "射撃訓練場に行かないかっていうのは変だよな？\\nこういう時に誘うべき場所は……いや、場所に\\nこだわらなくても楽しいと伝わればいいはずで……。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "リゼ",
          "original": "よし、チノ。\\n私と一緒に――楽しいことをしないか？",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "チノ",
          "original": "！！",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "シャロ",
          "original": "ほああああ～……。\\nリゼ先輩、素敵……！",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "ココア",
          "original": "これは……１番の魔性はリゼちゃんだぁ！",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "リゼ",
          "original": "だから、これって魔性か？",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}