{
  "identity": "flyer_chiya_i1.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日は千夜ちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "ココアちゃん。\\n私、大変なことに気がついたの。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "えっ！？\\nど、どうしたの千夜ちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア（Ｍ）",
          "original": "（なんだか深刻そう？\\n　これは、ホントのホントに大ごとかも？）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "千夜ちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "何があったかわかんないけど、\\n私、千夜ちゃんのこと、\\n１番の親友だって思ってる。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "だから、遠慮はいらないからね？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "千夜",
          "original": "ココアちゃん……！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "なんでも話して。\\nどんなことでも受け止めるから。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "……！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "千夜",
          "original": "ああ、私、ココアちゃんと友達になれて\\n本当によかったわ。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "じゃあ、聞いてくれる？\\n私、もう、どうしていいのかわからなくて……。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "そんなに悩まないで。\\nまずは相談することが大切だよ。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "それじゃ……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "千夜",
          "original": "あのね、ココアちゃん。\\n私たち、間違ってるんじゃないかしら。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "え？　間違ってるって、何を？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "私、ずーっと考えていたの。\\nこのバニーガールの衣装、\\n足はこれでいいのかしらって。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "う、うん？　足？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "バニーガールって――\\n足は、網タイツじゃないと\\nいけないんじゃないかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "……網タイツ？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "千夜",
          "original": "ええ。\\nそこを間違えている気がするの。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "えーっと……確かに網タイツの\\nイメージはあるけど、別に、絶対にそうだって\\n決まってはいないんじゃないかな？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "そうなの？\\n網タイツとは限らないの？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "うん、多分。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "千夜",
          "original": "はあ……！\\nよかったぁ……！",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "千夜",
          "original": "バニーガールの規則に\\n違反していないか心配だったの。\\nこれで、心置きなくチラシ配りができるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "そ、そう……。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア（Ｍ）",
          "original": "（私、千夜ちゃんのこだわりが\\n　時々、わからないよ……）",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}