    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はシャロちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "ん～……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "どうしたの？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "音楽、いいなーって思って。\\nこの街だと、街角の演奏も様になるね。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "ふーん……。\\n確かに、心がわき立つようないい曲ね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "ねえ、シャロちゃん。\\nちょっと踊ってみない？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "はっ！？\\nな、なんで急に！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "時代は、歌って踊れる怪盗だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "時代っていつの時代よ。\\nまた勝手なこと言い出して……\\n第一、ここで踊るなんてはずかしいじゃない。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "そんなことないよ。\\nこんな格好なんだし、\\n踊るくらいでちょうどいいよ、きっと。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "ほらほら！\\nシャロちゃん、お手をどうぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "引っ張らないでよ～！\\nやーだー、はずかしい～！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "はい、アン、ドゥ、トロワ！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "え？　え？　こ、こう？\\nアン、ドゥ、トロワ！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "いいねいいね～。\\nシャロちゃん、上手だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "別に、大したことないわよ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "はいっ、ここでターン！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "ターン！？\\nちょ、え、こう！？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "最初に戻って、アン、ドゥ、トロワ！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "アン、ドゥ、トロワ！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "シャロちゃん、のってきたね！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "のってないわよ。\\nココアが振り回してるだけでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "あははっ！\\nでも楽しいね、\\nいつまでも踊り続けられそう。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "まったくもう。\\n付き合わされる身にもなりなさいよね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}