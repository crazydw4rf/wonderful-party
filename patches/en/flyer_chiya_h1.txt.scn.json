{
  "identity": "flyer_chiya_h1.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日は千夜ちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "ふんふん、ふんふ～ん。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "なんだかご機嫌だね、千夜ちゃん。\\nこっちまで楽しくなってくるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "だって、この衣装なんだもの。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_0102": {
      "texts": {
        "0": {
          "speaker": "ココア（Ｍ）",
          "original": "（そう言っている千夜ちゃんや私が着てるのは\\n　『怪盗ラパン』の衣装！）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア（Ｍ）",
          "original": "（『怪盗ラパン』は、今人気のアニメ。\\n　子ども向けだけど、すっごく面白いの。\\n　私やチノちゃんも大好きなんだ）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*branch_01_join": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "前から思っていたけれど、\\n怪盗ラパンの服、かわいいわよね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "だよね！\\nこのコスプレ、１度してみたかったんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "ねえ、もし千夜ちゃんが\\n本物の怪盗だったのなら、何を盗んじゃう？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "うーん、そうねぇ。\\nラパンのような怪盗だったのなら……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "ティッピーかしら。\\nあんこのお嫁さんになってほしいの。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "りゃ、略奪愛はだめだよ！？\\n勝手にお嫁さんにしたらチノちゃんが悲しむよ！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "大丈夫、冗談よ。\\nチノちゃんを悲しませるようなことはしないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "ほっ……。\\nよかったぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "人の想いはままならないもの。\\nやっぱり、結婚は相思相愛でなくっちゃね。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "そうだよね。\\nもう、びっくりしちゃったよ。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "千夜",
          "original": "あとね、ココアちゃん？\\nこの場合は略奪愛とは言わないわよ？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "だってティッピー、\\nお付き合いしてる相手、いないでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "あ、そっか。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "うーん、でも実はモテモテだったりするのかな？\\nあんなに尋常でないもふもふなんだし……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "千夜",
          "original": "さあ、どうかしらね。\\nティッピーって秘密がたくさんありそうだわ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}