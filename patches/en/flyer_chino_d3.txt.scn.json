{
  "identity": "flyer_chino_d3.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "あれ？\\nなんだろう、この匂い？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "……いい匂いです。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "わかった！\\nこれ、シチューの匂いだ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "そろそろ夕飯の時間ですから。\\nどこか近くで作っているんでしょう。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "そっかー。\\nもうそんな時間なんだぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "……お腹減ったかも。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "……まあ、わからなくはありませんけど。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "でしょ？\\n今日の夕ご飯はシチューにしよっか。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "シチューですか――",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "そうですね。\\nこの匂いをかいでいたら、\\n私もシチューを食べたくなってきました。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ところで……ニンジンは抜きでいいよね？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "チノ",
          "original": "好き嫌いはだめです。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "そんな～。\\nチノちゃんだってニンジンは残すのに。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "それはそれです。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "んー、ニンジンかー……。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "ねえ、チノちゃん！\\n今日だけは２人で、頑張って食べてみない？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "どうしたんです、いきなり？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "だって、今日の私たち、\\nこんなふうにうさ耳をつけてるんだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "いわば、うさぎになってるわけ。\\nだったらニンジンくらい食べられないと！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "チノ",
          "original": "どういう理屈ですか……。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "何事も形からだよ！\\n今の私たちならきっと食べられるよ！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "形から……。\\nなんだか、千夜さんみたいです。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "チノ",
          "original": "でも、確かに、いいきっかけかもしれません。\\n好き嫌いは直さないといけませんし。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "うん！\\nチノちゃん、一緒に頑張ろうね！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "はい。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}