    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア（Ｍ）",
          "original": "（今日のお休みは\\n　思いっきり野良うさぎをもふもふするよっ！\\n　さて、うさぎはどこかな～？）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア（Ｍ）",
          "original": "（……あれ？\\n　あそこにいるのはチノちゃん？）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
