{
  "identity": "move_b04.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア（Ｍ）",
          "original": "（うーん……。\\n　さっきから背中に視線を感じる）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア（Ｍ）",
          "original": "（誰が私を見てるの？\\n　まさか、私、狙われてるの！？）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア（Ｍ）",
          "original": "（あ！　もしかして、私をお姉ちゃんだと思って\\n　遠くから見つめている誰かがいるのかも）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア（Ｍ）",
          "original": "（お姉ちゃんって呼びたくて、でも呼べなくて\\n　切ない想いを抱いてるの？）",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア（Ｍ）",
          "original": "（そんな……！\\n　遠慮なんていらないよ！\\n　さあ、私をお姉ちゃんと呼んで――）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "青山",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "青山さんだった！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "青山",
          "original": "驚かせてしまって申し訳ありません。\\n実は、小説のヒントになるかと\\nココアさんを尾行していました。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "尾行を堂々と告白！？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "青山",
          "original": "ですが、あっさり見つかってしまいましたね。\\n残念です。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "青山",
        "original": "ですが、あっさり見つかってしまいましたね。\\n残念です。",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "尾行をするのならサングラスです！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "もっとかわいい服を着ていればよかったなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "私ってそんなにヒロインっぽいですか？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "尾行をするのならサングラスです！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "青山",
          "original": "え？　サングラス？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "サングラスと帽子、\\nそれにマントで正体を隠さないと。\\n尾行はそこから始まるんです！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "青山",
          "original": "な、なるほど……！\\n確かに、正体を隠すことは重要ですね。\\n次に尾行する時は気をつけます。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "もっとかわいい服を着ていればよかったなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "青山",
          "original": "あら、どうしてですか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "かわいい服を着ていれば、私の何気ない行動が\\n素敵に見えるかもしれませんよね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "素敵に見える方が、きっと、\\n尾行していて楽しいんじゃないかなって。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "青山",
          "original": "尾行している人の楽しさのため、ですか。\\nココアさんは変わったことを仰るのですね。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "青山",
          "original": "そのような反応をしてくださったのは\\nココアさんが初めてで……興味深いです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "私ってそんなにヒロインっぽいですか？\\n尾行したくなるほどに！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "青山",
          "original": "ええ、ココアさんはとても個性的ですから。\\nその行動を観察していると、\\nはっとさせられることも多いです。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "青山",
          "original": "ヒロインとしても大変魅力的ですし、\\n主人公を支える役でも輝くでしょうね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "そ、そうなんですか～。\\nえへへ、なんか照れちゃいます。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "それで、私を尾行した結果、\\nどんなネタが浮かんだんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "青山",
          "original": "そうですね。\\nココアさんを尾行して――",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "あ、わかった！\\n華麗な街の国際バリスタ弁護士の\\n波瀾万丈な冒険小説ですね！？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "青山",
          "original": "いえ、違います。\\n実は――",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "じゃあ、キュートな街の国際バリスタ弁護士の\\n優雅な日々を描くミステリー？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "青山",
          "original": "それも違います。\\n実はですね――",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "あっ！　そうだ！\\n才気溢れる街の国際バリスタ弁護士の\\n斬新な発想を描くＳＦですね！？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "青山",
          "original": "い、いえ、そうではなく――",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "あれれ？\\nじゃあ、なんなんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "青山",
          "original": "何も思いつかなかったんです。\\n困りました……。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ええー！\\n私がモデルの小説のアイディアは\\n一体どこへ行っちゃったんですか！？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "青山",
          "original": "さあ……。\\nしかし、ココアさんでもだめとなると、\\nどうしたらいいのやら。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "……わかりました！\\nじゃあ、これからも私を尾行してください！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "青山",
          "original": "えっ？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "今度はちゃんと小説のネタに\\nなるようなことをしますから。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "青山",
          "original": "まあ、それは大変助かります。\\nありがとうございます、ココアさん。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "……ところで、青山さん。\\n小説のネタになるようなことってなんでしょう？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "青山",
          "original": "ええっと……\\nそれがわかったら苦労しないのですが。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "あはは……そうですね……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}