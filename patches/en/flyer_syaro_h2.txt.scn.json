{
  "identity": "flyer_syaro_h2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はシャロちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ふう～。\\nちょっと疲れたね、シャロちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "そう？\\n私はまだいけるけど。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "またまた、シャロちゃんってば\\n頑張り屋さんなんだから。\\nたまには休憩しなくちゃだめだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "別に頑張り屋でもないし、\\n休憩もまだいらないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "そんなこと言わないで～、\\n温かい飲み物でも飲まない？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "……仕方ないわね。\\nじゃ、休憩にしましょうか。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "わーい！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "やっぱり、ココアが休憩したかっただけじゃない。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "そ、そんなことないよ？\\nそれよりも、さっそく\\n温かい飲み物を買ってこないとね～。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "ふう～、あったまるねえ。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "そうね。\\n思ったよりも冷えてたみたい、\\n温かさが身に染みるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "あー。\\nココア、甘くておいし～い。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "ふふっ！\\nなんだかおかしい。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "ん？　何が？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "ココアがココア飲んでる。\\nふふふっ。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "じゃあ、シャロちゃんも\\n私を飲むといいよ～、はい。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "別にいいわよ。\\n自分で買った分があるし。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "なっ、なんで断るの？\\n私じゃいけないの？　私のこと嫌いなの！？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "シャロ",
          "original": "ご、誤解を招く発言はやめてよ！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "私はシャロちゃんにも\\nココアを味わって欲しいのに、\\nシャロちゃんは嫌なんだ～！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "ちょ、ちょっと！\\nココア！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "そうだよ、私はココアなのに\\nココアがいらないなんて！\\nシャロちゃんはココアを愛してないのね～！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "シャロ",
          "original": "ストップ、ストップ！\\n周りの人が聞いたら\\nどう思うかわからないでしょ！？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "じゃあ、はい。\\nどうぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "シャロ",
          "original": "まったくもう。\\nじゃあ、ちょっとだけもらうわね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}