{
  "identity": "flyer_syaro_j1.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はシャロちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "ううう……。\\nなんで私がこんな格好を……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "どうしたの、シャロちゃん？\\n何かあった？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "な、何もないわよ。\\nただはずかしいだけ……。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "はずかしい？　何が？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "こんな格好でチラシを配ってるのよ？\\nはずかしくないわけないじゃない。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "えー？　はずかしいかな？\\nすごくかわいいと思うんだけど？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "確かにかわいいけど、\\n普通、こういう格好しないでしょ？\\n目立って仕方ないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "でも、これ、コスプレで目立って\\nチラシをたくさん配る作戦だよ？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "そうかもしれないけど～！\\nうう……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "うーん。\\nちょっと不思議なんだけど、\\nシャロちゃん、この格好がはずかしいの？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "だから、はずかしいって言ってるじゃない……。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "せっかくよく似合ってるのになー。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "そうかしら？\\nこういうかわいい服、\\nチノちゃんならいいけど私は……。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "あれ？\\nじゃあ、シャロちゃんって\\nフルールの制服を着ててはずかしいの？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "あれは制服だもの。\\n制服をはずかしいと思うわけないでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "じゃあ、大丈夫だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "どういう理屈なの！？\\nさっぱりわかんないんだけど！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "だから、シャロちゃんは普段、\\nあんなにかわいいフルールの制服を\\n着こなしてるんだから――",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "チラシ配りの制服なこの服でも、\\nはずかしがる必要ないってこと。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "はっ……。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "そ、そうだわ！\\n確かに初めはフルールの制服だって\\nはずかしかったはず……。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "私、いつの間にか\\nそこまでフルールに染まってたの！？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "この服もずっと着てたら、\\nフルールの制服みたいになじんじゃうよ、きっと。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "それはそれでどうなのかしら……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}