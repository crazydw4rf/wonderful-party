{
  "identity": "visit_chiya_02.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "こんにちは。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "あ、千夜ちゃん！\\nらっしゃい、いいネタ入ってるよ！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "なんで寿司屋みたいになってるんだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "じゃあ、このティッピー握りをもらおうかしら。\\nあんこへのお土産にお持ち帰りするわ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "お客さん、お目が高いね！\\nこいつはとれたて新鮮ピチピチの\\nティッピー握りだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ティッピー",
          "original": "わ、わしを売り渡すつもりかっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "うふふ、ごめんなさい。\\nティッピーってご飯みたいだから\\n間違えちゃったの。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "私もだよ～。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "どう考えてもわざとだろ。\\nしかし、千夜もよくココアの無茶ぶりに\\nついていけるな。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "だって私たち、親友だもの。\\nねー？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ねー！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "チノ",
          "original": "ココアさんと千夜さんは波長が合うんですね。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "あ、そういえば、お寿司で思い出したけど、\\n甘兎庵って配達もやってるんだよね？\\nラビットハウスに配達を頼むこともできるの？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "ええ、もちろん大丈夫よ。\\n自信作の和菓子をいつでもお届けするわ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "だったら、甘兎庵から配達してもらったお菓子を\\nうちで販売するってのはどうかな？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "な、なにか、さりげなくとんでもないことを……。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "コーヒーを飲みながら\\nおいしい和菓子を食べられる店って、\\nきっと評判になるよ！　ねえ、どうかな？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "千夜",
          "original": "そうねぇ、ラビットハウスさんの商品を\\nうちでも出させてくれるなら、考えてもいいわよ？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "まあ、条件としてはフェアだな。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "チノ",
          "original": "そういうことなら、\\nうちの商品を甘兎庵に配達するのは\\n全部ココアさんにやってもらいます。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "ええええっ！？\\nわ、私１人で？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "言い出したのはココアなんだしなぁ。\\nそれでもやるのか？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "リゼ",
        "original": "言い出したのはココアなんだしなぁ。\\nそれでもやるのか？",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "も、もちろんやるよ！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "ごめんなさい……！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "２人ともひどいよ～！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "も、もちろんやるよ！\\nラビットハウスと甘兎庵のためなら、\\n私、パンとコーヒーを抱えて何往復でもするよ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "ココアちゃん……！\\nその気持ちは嬉しいけど、無理しないでっ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "ココアちゃんのアイディアは難しいとしても、\\nラビットハウスさんとうちで\\nコラボはしてみたいわね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ごめんなさい……！\\nやっぱり難しかったね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "でも、夢のある素敵なお話だったわ。\\nいつかどこかで合同出店なんてできたら素敵ね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "いいですね。\\n街のイベントに出店するのも楽しそうです。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "ココアちゃんのアイディアは難しいとしても、\\nラビットハウスさんとうちで\\nコラボはしてみたいわね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "２人ともひどいよ～！\\nだめな理由ばかり探していたら、\\n未来は何も変わらないんだよ！？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "変わらないままでいいこともあります。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "ああ、そうだな。\\n耳当たりのいい言葉で押し切ろうとするな。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "素敵なアイディアだとは思うけど、\\n実現するのは難しいと思うわ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "そっかー……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "ココアちゃんのアイディアは難しいとしても、\\nラビットハウスさんとうちで\\nコラボはしてみたいわね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "それでしたら、こちらも大歓迎です。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "じゃあ私、今度、抹茶パン作ってみようかな。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "私も、もっと自然に和菓子にコーヒーを\\n取り入れるための研究を始めるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "うん！　お互い頑張ろうね！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "ええ、頑張りましょう！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "なんだかんだ言って丸く収まってるし、\\n本当に、ココアと千夜は波長が合うんだな。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "……なんだか少しだけ、羨ましいです。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "チノちゃん？　どうかした？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "な、なんでもありません。\\n気にしないでください。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
