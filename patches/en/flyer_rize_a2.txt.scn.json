{
  "identity": "flyer_rize_a2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はリゼちゃんとチラシ配りをしよう！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "……ふう。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "リゼちゃん、どうしたの？\\n疲れちゃった？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "いや、その逆だ。\\nただチラシを配ってるだけじゃ、\\n体がなまりそうでさ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "じゃあ、訓練をしながら、\\nチラシを配ったらいいんじゃないかな？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "そうだな、チラシ配りと両立できる\\n訓練があればいいんだが……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "よし、じゃあ、チラシ配りの間は\\nココアの影を踏んでいることにしよう。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "影を踏む！？　どうして！？\\n私に何をする気なの～！？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "いや、何もしない。\\n影を踏むだけだ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "ココアは面白い動きをするからな。\\n動きを予測して、先手を取る訓練になりそうだ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "何を～！？\\nそう簡単に私の影は踏ませないよっ！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "よっと。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "そんな、あっさり！？\\nけど、まだまだー！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "はっ！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "ささっ！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "ほっ！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "これでどうだ！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "えい！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "やーらーれーたー！\\n……ぱたり。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "おい、こんな所で倒れるなよ。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "だ、だって……\\nリゼちゃんがこんなに影踏みが上手いなんて。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "ココアの場合、意識すると\\n動きが大げさになってわかりやすくなるんだ。\\n普段の動きの方がトリッキーでつかみづらいぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "そうなの？\\nどうやったら、意識しないで\\nうまく逃げられるようになるのかな？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "リゼ",
          "original": "まあ、訓練あるのみだな。\\nココアが逃げる、私が追う、これを続けてみるか。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "うん！\\n影を踏まれない訓練、頑張る！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "あ、訓練のついでに\\nチラシ配りもやらないとね。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "リゼ",
          "original": "いや、訓練がついでだからな？",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}