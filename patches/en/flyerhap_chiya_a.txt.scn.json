{
  "identity": "flyerhap_chiya_a.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "千夜ちゃん！\\nチラシ配り、一緒にやろっか。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "もちろんいいのだけど、\\n今日はみんな揃って\\n配ることができそうだから、そうしない？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そうなんだ！\\nじゃあ、せっかくだしみんな揃ってやろう。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "はあ～。\\n暖かな日の光が身に染みるなぁ。\\nここにお茶とお菓子があれば、もう天国だよ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "おいおい。\\n休憩中とはいえ、あまりふぬけるなよ？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "ふぬけてもいいんだよ～。\\n何かしないといけないのなら、\\nそれはもう休憩じゃないよ～。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "ああ言えばこう言う……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "ん？　言う？\\n言うといえば……伝言ゲームしてみない？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "……いきなり話が飛んだわね。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "ココアさんはもう少し\\n考えてからしゃべった方がいいです。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "でも思いついちゃったから。\\nねー、やってみない？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "別に構わないけど、この人数じゃ\\n簡単すぎるんじゃないか？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "それじゃ、少しルールを複雑にしてみない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "同じ言葉を伝えるんじゃなくて、\\n相手が何を伝えたいのかを推理して\\n自分なりの言葉で次の人に伝える――",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "なんて、どう？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "それは難易度が跳ね上がりすぎだろ！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "ううん、大丈夫。\\n私たちは以心伝心、それくらいのことは\\nこなせちゃうはずだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "特に、私とチノちゃんなら！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "マヤさんとメグさんならともかく、\\n私とココアさんでは無理です。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "そ、そんなことないよ！\\n証明してみせるから、伝言ゲームやろう！\\nやろうったらやろう！！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "わかったわかった、\\nそんなに前のめりにならなくていい。\\nじゃあ、じゃんけんで順番を決めるか。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "私が最初ね。\\nお題を決めるなんて責任重大だわ。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "千夜が最初って、\\n成功する未来が見えないんだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "チノ",
          "original": "私も、正直、そう思います。\\n千夜さんの発想には翻訳が必要です。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "いや、２番目がココアだから、あるいは……\\nココアは予備知識なしで\\n甘兎庵のメニューを読み解くからな。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "じゃあ、始めるよー！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "千夜",
          "original": "そうね。\\nお題は……なんにしようかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "なんでもいいんだよ。\\nあ、でも、ちょっと長くした方が\\n連想ゲームとしては面白いかも。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "ちょっと長く……じゃあ、こうしましょ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "千夜",
          "original": "お題は……。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "ふ～。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "ひゃああ！？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "ど、どうしたんですか！？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "敵襲か！？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "千夜ちゃんが耳に息を吹き込んできたー！\\nくすぐったかったよー！",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "千夜",
          "original": "そんなに驚くなんて。\\nココアちゃん、耳が弱いのね。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "弱くなくたってびっくりするよ！\\nまだゾクゾクしてる～。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "千夜",
          "original": "ふふふ、ごめんなさい。\\nそれじゃ、改めて――",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "千夜",
          "original": "暗き海に清廉な白き星を眺め、\\n甘美な誘惑に翼を休めましょう。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア（Ｍ）",
          "original": "（ふむふむ。\\n　千夜ちゃんの言いたいことを推理すると……）",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア（Ｍ）",
          "original": "（暗き海は黒い水？\\n　清廉な白き星は真っ白なもの……。\\n　黒い水に白いものが浮いている……）",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア（Ｍ）",
          "original": "（あっ！　つまり、お汁粉を食べようってこと？\\n　うん、きっとそうだよ！）",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "ココア",
          "original": "よーし、わかったよ！\\nそれじゃ、チノちゃんに伝えるね。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "チノ",
          "original": "耳に息を吹きかけるのはなしですよ。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ココア",
          "original": "そ、そんなことしないよ？",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア（Ｍ）",
          "original": "（やろうと思ってたけどバレちゃってる！\\n　ここは普通に伝えよう……）",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "ココア",
          "original": "あとで、お汁粉を食べようね。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "チノ",
          "original": "……なるほど、わかりました。\\nじゃあ、次のリゼさんには……。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "チノ",
          "original": "ごにょごにょごにょごにょ……。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "リゼ",
          "original": "なるほど。\\nじゃあ、最後のシャロに回すぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "シャロ",
          "original": "あ、はいっ！",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "リゼ",
          "original": "えーっと……。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "シャロ",
          "original": "はうっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "リゼ",
          "original": "ん？　どうした？",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "シャロ",
          "original": "ななな、なんでもありませんっ！\\nき、気にしないでください！",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "千夜",
          "original": "それじゃ、シャロちゃん。\\n答えは何？",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "シャロ",
          "original": "え、えーと……チラシ配りが終わったら\\n甘兎でお汁粉を食べよう、かしら。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "千夜",
          "original": "まあ、すごい！\\nぴったり正解よ！",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "ココア",
          "original": "やったぁ！",
          "translation": "",
          "status": "untranslated"
        },
        "47": {
          "speaker": "チノ",
          "original": "なんとかなるものですね。",
          "translation": "",
          "status": "untranslated"
        },
        "48": {
          "speaker": "リゼ",
          "original": "千夜、最初になんて言ったんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "49": {
          "speaker": "千夜",
          "original": "暗き海に清廉な白き星を眺め、\\n甘美な誘惑に翼を休めましょう、よ。",
          "translation": "",
          "status": "untranslated"
        },
        "50": {
          "speaker": "リゼ",
          "original": "……なるほど。\\nこのゲームの功労者は\\nココアだということがよくわかるな。",
          "translation": "",
          "status": "untranslated"
        },
        "51": {
          "speaker": "チノ",
          "original": "はい、間違いないと思います。",
          "translation": "",
          "status": "untranslated"
        },
        "52": {
          "speaker": "千夜",
          "original": "ココアちゃんと私は\\n心が通じ合っているんだものね。",
          "translation": "",
          "status": "untranslated"
        },
        "53": {
          "speaker": "ココア",
          "original": "ねー！",
          "translation": "",
          "status": "untranslated"
        },
        "54": {
          "speaker": "シャロ",
          "original": "チノちゃんとの以心伝心を\\n証明するんじゃなかったの？",
          "translation": "",
          "status": "untranslated"
        },
        "55": {
          "speaker": "チノ",
          "original": "そもそも以心伝心ではないので。\\nこれでいいんです。",
          "translation": "",
          "status": "untranslated"
        },
        "56": {
          "speaker": "リゼ",
          "original": "まあ、ココアからチノにも\\n正しく伝わってはいたしな。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}