{
  "identity": "flyerhap_chino_g.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "チノちゃん！\\nチラシ配り、一緒にやろう？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "構いませんが……\\n今日はみんな揃って\\n配ることができそうですし、そうしませんか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そうなの？\\nじゃあ、みんな揃ってやろうか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "うう……苦しいよぉ……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "ココアさん、どうしました！？\\nお腹を押さえて……痛いんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "ううん、違うの。\\nスカートを締めすぎて……お腹が苦しくて……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "え？　スカート？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "お願い、誰かスカート緩めて～！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "ココアちゃん、\\n結構キツく締めてたものね。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "仕方ないわね。\\nちょっとじっとしてなさい。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "……あれ？\\nんっ……えいっ……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "だめ、開かないわ。\\nこれ以上引っ張ると布が破れちゃいそう。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "苦しいよー！\\n誰か、誰でもいいから助けてぇー！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "リゼ",
          "original": "大げさだなぁ。\\n私がやってやるから、少し落ち着け。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "ん？　んん……？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "ココア、どんな締め方したんだ？\\nこれ、ファスナーが\\n布を噛んじゃってるじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "ああ、それで下がらないんですね。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "うーん、これは……布を切るしかないかもな。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "ええ？\\nそんな、服を切るなんてできないよ！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "千夜",
          "original": "じゃあ、私がやってみるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "ん……えいっ……！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "ああ、だめよ千夜。\\n力任せじゃ、余計に噛んじゃうだけだわ。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "これは困ったわね……。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "ええええ～！\\n私、この格好のまま過ごすことになるの！？\\n１年中、ハロウィンの服しか着れないの！？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "あの……私もやってみます。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "チノちゃん……！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "チノ",
          "original": "しばらくじっとしてください。\\n何とか外してみます。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "チノちゃん、無理しなくてもいいよ？\\n私が諦めて、一生、この服を\\n着てればいいだけなんだから。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "仕事中もその服ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "そ、それはだめ……かな？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "だめです。\\nラビットハウスが\\nハロウィン喫茶になってしまうじゃないですか。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "チノ",
          "original": "とにかく、じっとしてください。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "はい……。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "チノ",
          "original": "ここが引っかかってるんですね……。\\n何とか緩めて……。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "チノ",
          "original": "あ、緩んできました。\\nこのままいけば取れるかもしれません。\\nんしょ……えいっ……。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "シャロ",
          "original": "ココア、自分のことを姉だって言うけど、\\n今はどう見てもチノちゃんの方が面倒見てますね。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "リゼ",
          "original": "ああ。\\nまさに、だめな姉のフォローをする\\nしっかり者の妹だ。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "千夜",
          "original": "でも、とっても仲良しな姉妹よね。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "チノ",
          "original": "もう少しで取れそうです……。\\nここを引っ張って……えいっ！",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "チノ",
          "original": "いけました……！",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "ココア",
          "original": "やっと解放された～！\\nよかった、私、ハロウィンとさよならできるよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "チノ",
          "original": "本当に、ココアさんは手がかかりますね。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "ココア",
          "original": "チノちゃん、ありがとう！\\nお姉ちゃんは感激だよ、チノちゃんが\\n私のために頑張ってくれたんだから！",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "チノ",
          "original": "べ、別に、そういうのじゃありません。\\n苦しそうだったから放っておけなかっただけです。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "ココア",
          "original": "チノちゃん、大好き～！",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "チノ",
          "original": "わかりましたから、チラシ配りを再開しますよ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}