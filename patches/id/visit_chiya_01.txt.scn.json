          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "いいえ、違うわ！\\nあんこは愛に生きているのよ！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "どうしてそう頑なにこだわるんだ……？",
