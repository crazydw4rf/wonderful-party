{
  "identity": "flyer_chino_a2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "うーん……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "ココアさん、\\nサボってないでちゃんとチラシを配ってください。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "サボってるわけじゃないよ。\\nちょっと考え事をしてたんだ。\\nどうやったらもっと目立てるのかなーって。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "それでね、思ったんだけど、\\n違う路線で攻めてみるのはどうかな？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "たとえば、リゼちゃんみたいに\\n凛々しく配ってみるとか。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "凛々しくと言われましても……\\n具体的にどんなふうにすればいいんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "えっと……んー、おっほん！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "憩いのひと時を\\nラビットハウスで過ごしてみませんか？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "それが、ココアさんの\\n凛々しいというイメージなんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "あれ？\\nこういうのはチノちゃんの好みじゃない？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "いえ、そういうことではなくて――",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "じゃあ、シャロちゃんみたいに\\nお嬢様っぽくしてみるのはどうかな？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "チノ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "ラビットハウスをよろしくお願いしま～す♪",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "それって、シャロさんの真似を\\nしてるだけですよね？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "えへへ……。\\nお嬢様っぽい言葉遣いが\\nぱっと思いつかなかったから、つい。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "できないなら無理しないでください。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "でも、やっぱりインパクトって大事だと思うよ。\\n次は意表をついて、不良っぽくワイルドに\\n行ってみよう！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "……頑張ってください。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}