{
  "identity": "chiya_b04.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "メグ",
          "original": "うーん、なかなか見つからないねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "でも、この辺りにあるのは確かなはずよ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "諦めずに探せば、きっと見つかるよ！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "マヤ",
          "original": "なー、千夜。\\nお宝の目印はうさぎの刻印だったよな？\\nもしかして、これ？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "ええー！？\\nマヤちゃん、いつの間に見つけたの！？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "マヤ",
          "original": "へっへーん！\\nそこの植え込みがなんか匂うと思ってさ。\\n探したら、案の定、出てきたんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "うさぎの刻印が付いてるわ。\\n間違いないわね。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "メグ",
          "original": "マヤちゃん、すご～い！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "ああっ！\\n私としたことがマヤちゃんに負けるなんて～！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "マヤ",
          "original": "てってれ～！\\nココアに勝ってレベルアップだよ！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "うう……！\\nもはやここまで～！　がくっ！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "ふふふ、いつの間に勝負になってたのかしら。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "マヤ",
          "original": "ねえねえ、そんなことより\\n早く開けてみようよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "メグ",
          "original": "どきどきしてきた～！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "それじゃ、開けるよ！\\nよいしょ……！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "マヤ",
          "original": "あれ、紙が入ってる。\\nこれがお宝？　なんか地味じゃね？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "メグ",
          "original": "レシピなんだからおかしくないよ～。\\nこの紙に書いてあるんじゃないかな？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "千夜",
          "original": "あら……。\\nこれは、手書きの地図ね。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "ええっ！？　また？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "マヤ",
          "original": "またって？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "千夜",
          "original": "実はね、この前にも宝箱を見つけたのだけど、\\nそこには地図が入っていたの。\\nそれが示したのが、この宝箱なのよ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "千夜",
          "original": "地図に従って宝箱を見つけたら地図が入っていて、\\nさらにその地図に従って宝箱を見つけたら、\\nまた地図が入っていた……。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "これは、永遠に地図が見つかる流れね。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "地図の無限ループ！？\\nそんなの困るよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "メグ",
          "original": "あのね、ココアちゃん。\\n永遠っていうのは困るけど、あと何回かくらい\\nだったら、私、地図でもいいかなーって。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "マヤ",
          "original": "そうだよな！\\nココアたちともっと宝探ししたいよ。\\n一緒に冒険って楽しいじゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "メグ",
          "original": "ココアちゃんや千夜さんと一緒に\\nこうして遊んだこと、あんまりなかったし。\\nえへへ……。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "マヤちゃん、メグちゃん……！",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "千夜",
          "original": "そう言ってもらえると嬉しいわ。\\nそれじゃ、もう少し頑張ってみましょう、\\nココアちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "うんっ！\\n次の宝箱も一気に見つけちゃおう！",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "マヤ＆メグ",
          "original": "おーっ！",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "千夜",
          "original": "あ、でも、その前に……\\nそろそろお昼の時間じゃないかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "千夜",
          "original": "お弁当作ってきたから、これからに備えて\\nまずは腹ごしらえしましょ。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "あ、もうそんな時間なんだ。\\n私もお菓子持ってきたし、みんなで食べよっか。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "メグ",
          "original": "私たちもご馳走になっちゃっていいの？",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "千夜",
          "original": "ええ、たくさん作ってきたから大丈夫よ。\\nむしろ食べてもらえるならありがたいわ。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "マヤ",
          "original": "やりぃ～！\\nおべんとおべんと～♪",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "メグ",
          "original": "ありがとうございます！\\n千夜さんのお弁当、楽しみ～。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "千夜",
          "original": "それじゃ、公園に行って休憩にしましょ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}