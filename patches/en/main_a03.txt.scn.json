{
  "identity": "main_a03.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア（Ｍ）",
          "original": "（ここが喫茶店ラビットハウス。\\n　私の下宿先です。\\n　昼は喫茶店だけど、夜はバーになります）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア（Ｍ）",
          "original": "（ラビットハウスだけど、店員さんが\\n　うさ耳をつけていたりはしません）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "いつもよりかなり早くついたな。\\nチノ、驚くんじゃないか？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "うん！\\n思いっきりおどかしちゃおう。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "ただいまー！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "お疲れ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "あ……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "お帰りなさい、ココアさん。\\nお疲れ様です、リゼさん。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア（Ｍ）",
          "original": "（この子はチノちゃん。\\n　ラビットハウスのマスターのお孫さんで\\n　喫茶店の看板娘さん）",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア（Ｍ）",
          "original": "（そして、私の妹です！）",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "妹じゃないです。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "はっ！？\\nチノちゃん、私の心を読んだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "ココアさんがわかりやすいだけです。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "遠慮しなくてもいいんだよ？\\n私にとって、チノちゃんは\\nもう妹も同然なんだから！",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "それはココアさんが一方的に思っているだけです。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "リゼ",
          "original": "やれやれ、いつもながらの扱いだな。\\nココアもこれでめげないんだからすごいけど。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "マヤ",
          "original": "あははっ！\\nホントだよな～。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "メグ",
          "original": "お帰りなさい、ココアちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "あれっ！？\\nマヤちゃんとメグちゃん、来てたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "メグ",
          "original": "えへへ、お邪魔してます。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "マヤ",
          "original": "お邪魔してまーす！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア（Ｍ）",
          "original": "（メグちゃんとマヤちゃん。\\n　チノちゃんの同級生で、\\n　よくラビットハウスに遊びに来てくれます）",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア（Ｍ）",
          "original": "（そして、チノちゃんに続く私の妹たちです！）",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "ココアさん、今日はずいぶん早いですね。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "ふふーん、びっくりした？",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "はい、ちょっとびっくりしました。\\nどうしてこんなに早いんですか？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "チノ",
        "original": "はい、ちょっとびっくりしました。\\nどうしてこんなに早いんですか？",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "お姉ちゃんだから当然だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "いつも遅刻ばかりでごめんね？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "実は、時計を見間違えちゃったんだ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "お姉ちゃんだから当然だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "当然なら、いつもこうしてほしいです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "でも、ココアさんも\\n少しは年上の自覚を持ってきたんですね。\\nえらいです。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "やったー！\\n褒められちゃった！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "あのな……。\\n自覚でも何でもなくて、\\nただ時計を見間違えてただけじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "ああー！\\nリゼちゃん、言っちゃだめー！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "どういうことですか？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "止まってる時計を見て、\\n遅刻だと思い込んでたんだよ。\\nそれで走ってきたから早いんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "そういうことですか。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア（Ｍ）",
          "original": "（うう～。\\n　チノちゃんの視線が痛いよぉ）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "いつも遅刻ばかりでごめんね？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "バイトに限らず、\\n時間にルーズなのはよくないです。\\nもっとしっかりしてください。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "うん！\\nこれからは、チノちゃんに\\n心配かけないようにするからね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "あの、それで、どうしてこんなに早いんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "ああ、それはな？\\nココアが時計を見間違えたんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "時計を？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "止まってる時計を見て、\\n遅刻だと思って走ってきたから早いんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "そういうことですか。\\n謝って誤魔化そうとしたんですか、ココアさん。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "ええっ！？\\nそんなつもりはなかったよ！？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "実は、時計を見間違えちゃったんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "時計をですか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "うん、止まってる時計を見て\\n遅刻だって思い込んじゃったの。\\nだから走ってきた分、早いんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "そういうことでしたか。\\nでも、走ってきたら危ないです。\\n無理はしなくてもいいんですよ？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "ううん、無理なんかじゃないよ！\\nかわいい妹のチノちゃんに\\n寂しい思いをさせられないからね！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "だ、だから、妹じゃないです……。\\nでも、その……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "ん？　なに？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "……なんでもない、です。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "マヤ",
          "original": "時計を見間違えるなんて、\\nココアもそそっかしいな～。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "そういえば、メグちゃんとマヤちゃんは\\n今日はどうしたの？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "メグ",
          "original": "これからね、マヤちゃんと２人で\\n図書館に勉強に行くの。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "マヤ",
          "original": "その前に、一休みしていこうと思ってさ！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "おお、勉強しに行くんだ！\\nえらいね！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "何事も、そうやって\\nこつこつ身につけていくのが大切だからな。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "マヤ",
          "original": "でも、ぱぱっとレベルアップすれば\\n頭もよくなって、勉強しなくていいかもな～。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "どうしてこっちを見ながら言うんですか。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "マヤ",
          "original": "チノ！　レベルアップさせて～！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ティッピー",
          "original": "あわわわわわわ……。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "だから、ティッピーは魔物じゃありません！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア（Ｍ）",
          "original": "（ティッピーは、このお店の\\n　マスコットうさぎさん。\\n　もふもふ具合が格別です！）",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア（Ｍ）",
          "original": "（いつもチノちゃんの頭の上にいて、\\n　時々、ダンディな声で喋るけど\\n　チノちゃんの腹話術なんだ）",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "メグ",
          "original": "ねえねえ、マヤちゃん。\\nそろそろ行こう？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "マヤ",
          "original": "あ、そうだな。\\nんじゃ、私たちはこれで！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "リゼ",
          "original": "ああ。\\n勉強、頑張れよ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "マヤ＆メグ",
          "original": "はーい！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "またねー！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "メグ",
          "original": "またね、ココアちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "マヤ",
          "original": "ばいばーい！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "ココアさん、早く着替えてきてください。\\nそろそろバイトの開始時間ですよ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "あっ！\\nそうだね、急ごうリゼちゃん！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "リゼ",
          "original": "ああ。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "よーし！\\n今日もバイト頑張るぞ～！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}