{
  "identity": "flyerhap_chino_d.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "チノちゃん！\\nチラシ配り、一緒にやろう？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "構いませんが……\\n今日はみんな揃って\\n配ることができそうですし、そうしませんか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そうなの？\\nじゃあ、みんな揃ってやろうか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "どうぞ、ラビットハウスです。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア（Ｍ）",
          "original": "（そーっと、そーっと……）",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "ココアちゃん？\\nこそこそして、どうしたの？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "しーっ！\\nリゼちゃんがチラシ配りに夢中だから、\\nびっくりさせようと思って。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア（Ｍ）",
          "original": "（もうちょっと、もうちょっと……\\n　よし、今なら――）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "何者だ！？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "うわあ！？\\nて、敵じゃないよ！　味方だよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "なんだ、ココアか。\\n急に後ろに立つな、びっくりするだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア（Ｍ）",
          "original": "（むしろ私がびっくりしたんだけど……）",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア（Ｍ）",
          "original": "（リゼちゃんを驚かせるのは\\n　無理そうだから……チノちゃんにしよう！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "喫茶店ラビットハウスです。\\nよろしくお願いします。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア（Ｍ）",
          "original": "（私には気付いてないね。\\n　そーっとそーっと、後ろから近づいて――）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "だ～れだ！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "！？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "さてチノちゃん、問題です。\\n目隠しをしているのは一体誰でしょう？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "ココアさんです。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "大正解～！\\nさすがチノちゃん、お姉ちゃんのことは\\n声だけでわかるんだね。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "いえ、こんなことをするのは\\nココアさんしかいませんから。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "ええっ！？\\nそんな理由なの？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "それよりも、離してください。\\nチラシ配りが終わりません。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "はーい。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "さすがチノ、クールな反応だな。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "千夜",
          "original": "でも、楽しそうね。\\n私もやってみたくなっちゃった。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "……言っとくけど、私にやらないでよ？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア（Ｍ）",
          "original": "（チノちゃん私にはいつもツンツンだよね。\\n　もちろん、そんなところもかわいいけど）",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "え！？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "だーれだ？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア（Ｍ）",
          "original": "（これはもしかして……！？）",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "チノちゃんだね！\\nもしかしてさっきの仕返し？\\nも～、かわいいんだから～。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "千夜",
          "original": "残念、私でした～。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "あれ？　千夜ちゃんだったんだ。\\n絶対チノちゃんだと思ったのになぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "どうやったら\\n私と千夜さんを間違えるんですか……。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "きっと、チノちゃんだ、と言うより、\\nチノちゃんだといいなって思っちゃったのね。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "こうだって思い込むと、\\n他の可能性を思いつかなくなるってあるもんな。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "千夜ちゃんのだ～れだ、もよかったけど、\\nやっぱりチノちゃんにやって欲しかったな～。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "そんな、ねだるように言われても困ります。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "ああー！\\nチノちゃんがまたツンツンだよー！",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "チノ",
          "original": "だって……今は身長差があって大変なんです……。\\nココアさんと同じぐらいになったら……。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "ん？　何？\\n何か言った？",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "チノ",
          "original": "な、なんでもないです。\\n気にしないでください。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}