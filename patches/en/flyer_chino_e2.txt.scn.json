{
  "identity": "flyer_chino_e2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "喫茶店ラビットハウスです。\\nよろしくお願いします。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "うんうん。\\nチノちゃんもこの格好に慣れてきたみたいだね。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "そういうココアさんはサボリですか？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "ううん、お姉ちゃんとして、\\nチノちゃんの働いてる姿を見守ってたんだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "それよりも、チラシ配りを優先してください。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "はーい。\\n今のチノちゃんは厳しい教官みたいだね。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "ちょうどいいです。\\nこの格好に合っていますし。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "じゃあ、せっかくだから次は私の番ね！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "……あの、何がせっかくなのか\\n私にはさっぱり――",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "上官を呼ぶ時はサーを付けろ！",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "い、いきなりなんですか！？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "え？　リゼちゃんの真似だよ？\\nほら、チノちゃんも合わせてみて。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "合わせてと言われても、\\nいったいどうすれば……。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "だから、上官を呼ぶ時はサーって付けるんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "……サー、ココアさん？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "んー？\\nなんだかしっくりこないね。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "あ、それじゃ、お姉ちゃんでいってみよう。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "はい？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "上官を呼ぶ時はお姉ちゃんと呼べ！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "チノ",
          "original": "なんですかそれは！？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "どうした！\\n上官の命令が聞けないのか！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "ココアさんがそういうつもりなら……。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "チノ",
          "original": "申し訳ありません。\\n上官のことをお姉ちゃんなどとは呼べません。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "ええ！？\\n上官命令なんだから呼んでいいんだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "無理です。\\n失礼にあたりますので。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "じゃ、じゃあ私、上官じゃなくていいから！\\nむしろチノちゃんが上官でいいから、\\nお姉ちゃんって呼んでよ～！",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "なんだかもう滅茶苦茶ですね……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}