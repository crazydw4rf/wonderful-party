{
  "identity": "flyer_syaro_a1.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はシャロちゃんとチラシ配りをしようっと）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "……ココア？\\nさっきからなんなの？\\n妙に視線を感じるんだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "私を見ていてもチラシは減らないわよ。\\nちゃんと働きなさい。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "そうなんだけど……気になることがあって。\\nシャロちゃんの学校では、\\nやっぱりお嬢様ポーズの授業とかあるの？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "……やっぱりってなに？\\nそんなのあるわけないでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "えー？\\nシャロちゃんの学校ってお嬢様学校でしょ？\\n絶対あると思ったのにな。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "まあ、お嬢様学校っていうのは\\n否定しないけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "じゃあ、念のためにきいておくけど\\n社交ダンスの授業はあるよね？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "そんなのないわ。\\n体育で創作ダンスならやったけど。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "そんなのうちの学校でもあるよ！\\nじゃあ、頭に本を置いて歩く訓練は？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "……それに何の意味があるの？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "そうすると、きれいな姿勢で歩けるらしいよ？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "なんに影響受けてるのよ。\\n本は読む物で頭に乗せるものじゃないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "ええー！？\\nじゃあ、どんな授業をしてるの？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "普通の授業！\\nココアの学校と同じよ、きっと。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "え～、つまんないよ～。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "だから、あんたは『お嬢様』に期待しすぎ。\\nお嬢様学校っていったってそんなものよ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "まあ、授業は、だけど。\\n通ってる生徒はお嬢様ばかりだから\\n私は肩がこって仕方なくて……。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "あ、わかった！\\n同じような授業だけど、お嬢様言葉で\\nやったりしてるんだね！？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "なんでよ！\\n私もリゼ先輩も\\n普通の言葉でしゃべってるでしょ！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "それは仮の姿で、本性を隠してるんだね？\\n恐るべしシャロちゃん……！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "勝手に人のキャラを決めないでくれる！？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "シャロ",
          "original": "はあ、もう。\\nココアと一緒にいると\\n嫌でも肩から力が抜けるわ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}