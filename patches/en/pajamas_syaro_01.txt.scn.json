{
  "identity": "pajamas_syaro_01.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日は、シャロちゃんのお布団に\\n　お邪魔しちゃうぞ！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ううう……。\\nこのままじゃ、眠れないよぉ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "私もよ。\\nもう、千夜ったら。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "どうやったら眠れるのかな？\\nシャロちゃん、何かある？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "んー……。\\nベタに行くのなら、何かを数えるとか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "それだ！\\nシャロちゃん、一緒にうさぎを数えよう！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "うさぎ？\\nこういう時は羊じゃないの？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "ああ、羊さんのもこもこに\\nくるまれたら、今すぐに眠れるのに、\\nせめて、ここにティッピーかあんこがいればな～。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "やめて！\\nあいつのことなんて思い出させないで！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "……あ、そうだ！\\n温かいもこもこじゃなくても、\\n温かいミルクを飲めば眠れるかも。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "それ、なかなかいい案じゃない。\\n温まって、ほっとして、\\n怖さが溶けていきそうだわ。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "柔らかい白色のミルクに\\n白いお砂糖をたっぷり入れて、\\nよく溶かして、甘くして～。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "シュガーミルクもいいけど、\\nハチミツ入れてハニーミルクもいいわね。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "ハニーミルクも好きだよ！\\n匂いだけでも幸せになれるよね。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "しょうがも入れたらどう？\\nハニージンジャーって、ぽかぽかに温まるのよ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "――なんて、このまま話してると\\n余計に目が冴えちゃいそうね。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "とりあえず、目を閉じてじっとしてましょ。\\nそれでそのうち眠れると思うわ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "はーい。\\nそれじゃ、おやすみなさいシャロちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "おやすみ、ココア。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア（Ｍ）",
          "original": "（静かだ……。\\n　シャロちゃん、寝ちゃったのかな？）",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア（Ｍ）",
          "original": "（じゃあ、もしかして私だけが\\n　取り残されてるってこと！？\\n　そ、そんなのやだよ！　怖いよ～！）",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "ねえ、シャロちゃん。\\nもう寝ちゃった？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "起きてるけど……何？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "あ、あのね？\\nシャロちゃん、先に寝ないでね？\\n１人にしないで～！",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "シャロ",
          "original": "ええ？\\nそ、それはこっちだって……。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "じゃあ、おやすみなさい！",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "シャロ",
          "original": "あ、ちょっとココア！",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "ココア（Ｍ）",
          "original": "（あ……。\\n　眠くなってきた、これなら眠れそう……）",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "シャロ",
          "original": "ねえ、ココア？\\n起きてる？　寝ちゃったの？",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ココア",
          "original": "はうっ！\\nひどいよシャロちゃん、\\nもうちょっとで眠れそうだったのに。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "シャロ",
          "original": "だ、だって！\\n先に寝るなんてずるいじゃない！",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "リゼ",
          "original": "おーい、何騒いでるんだ？\\n早く寝ろよ。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "シャロ",
          "original": "あっ！\\nす、すみません、先輩！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}