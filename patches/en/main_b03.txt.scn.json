{
  "identity": "main_b03.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "チラシ配り、順調ね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "うん！\\nみんなの協力のおかげだよ。\\nありがとう、千夜ちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "気にしないで。\\n私だって、チノちゃんの誕生日を\\n祝ってあげたい気持ちは一緒だもの。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "だけど、時間が過ぎるのはあっという間だね。\\nこの前チラシ配りを始めたばかりだと思ってたのに、\\nチノちゃんの誕生日まで、あと２週間くらいかぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "なら、チラシ配りにばかり気を取られてないで、\\nそろそろ誕生日パーティーの準備を\\n進めた方がいいんじゃない？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "あれ、シャロちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "おかえりなさい、シャロちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "ただいま……っていうのも変な感じね、\\nこんなところで。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "うーん、誕生日パーティー……。\\nそうだよね、プレゼントのことだってあるし。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "プレゼントはもう決めたの？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ううん、まだなんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "これからもっと忙しくなるし、\\nさっさと買っておいた方がいいわよ。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "うん、そうだね。\\nプレゼントがない誕生日なんて\\n誕生日じゃないもんね。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "……あ、そういえば、\\n２人の誕生日っていつなの？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "え？\\nなに、急に。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "そういえば聞いてなかったなって思って。\\n私はね、４月１０日なんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "７月１５日だけど。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "千夜",
          "original": "私は９月１９日よ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "千夜",
        "original": "私は９月１９日よ。",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "私がちょっとだけお姉ちゃんだね！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "２人とももう過ぎちゃってたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "すごくそれっぽいね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "私がちょっとだけお姉ちゃんだね！\\n千夜ちゃん、シャロちゃん、\\n私のことをお姉ちゃんって呼んでいいんだよ？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "ブレないわねぇ、ココアは。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "うふふっ！\\nココアお姉ちゃん、なーんて。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "もう、千夜まで悪乗りして。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "ほら、シャロちゃんも遠慮せずに呼んでみて？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "呼ぶわけないでしょ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "それはひとまず置いておくとして、\\nこの中だと、１番近いのは\\nココアちゃんの誕生日になるのね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "２人とももう過ぎちゃってたんだ。\\n言ってくれたらよかったのに。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "自分からそんなこと言うなんて、\\nまるでプレゼントを欲しがってるみたいじゃない。\\nはしたないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "そうねぇ、ちょっと気が引けるかしら。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "うーん、そっかぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "でも、これでちゃんと覚えたからね！\\n千夜ちゃんが９月１９日で、\\nシャロちゃんが７月１５日っと。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "それで、ココアちゃんが４月１０日。\\nということは、この中だと\\n次はココアちゃんの誕生日が近いのね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "すごくそれっぽいね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "何よ、それっぽいって。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "千夜ちゃんの誕生日は季節で言うと秋でしょ？\\nこう、紅葉とか、ワビサビって感じで\\nそれっぽいなーと思って。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "ああ、それはわかる気がするわ。\\nなんとなく、だけど。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy4": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "そう？\\n２人に言ってもらえて、なんだか嬉しい。\\nならシャロちゃんは夏っぽいってこと？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "うん！　夏っぽい！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "……そう言われても。\\n私のどこが夏っぽいのよ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "うふふ、それはひとまず置いておくとして、\\nこの中だと、次は\\nココアちゃんの誕生日が近いのね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "近いって言っても、来年になっちゃうけどね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "大丈夫よ。\\n忘れずにちゃんと誕生日パーティーを企画するわ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "やったぁ！\\nえへへ、楽しみだなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "でも、次が必ずココアの番とは限らないでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "あ、そうだね。\\nリゼちゃんにも聞いてみないと。\\nマヤちゃんやメグちゃんや青山さんだっているし。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "もちろん、次が誰の誕生日だったとしても\\n私は全力でお祝いするからね！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "ココアちゃんらしいわ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "根っからのお祭り好きなのね、ココアって。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "シャロちゃんは、お祭り嫌い？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "別に嫌いじゃないけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "じゃあシャロちゃんのお誕生日の時も、\\n私、思いっきり頑張るからね！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "え……。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "わ、私のことよりも、\\n今はチノちゃんの誕生日でしょ！",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "私たちに手伝えることがあったら、\\nなんでも言ってね。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "うん、みんなで一緒に\\nチノちゃんの誕生日を盛り上げようね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}