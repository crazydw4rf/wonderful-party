{
  "identity": "syaro_a06.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "やれやれ。\\n勉強、あまり捗らなかったな。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "まあ、ココアがいる時点で\\nこうなるような気がしてましたけど。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "でも、構いません。\\n先輩と一緒に勉強ができて楽しかったです。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "そうか。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "あの、どうかしたんですか、先輩？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "えっ？　何がだ？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "それは……何か言いたそうに見えたので。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "ああ……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "先輩？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "なあシャロ、\\nもう少しだけ時間をくれないか？\\nシャロと話がしたいんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "え……ええええっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "（ど、どうしちゃったの、今日の先輩は？\\n　勉強に誘ってくれただけじゃなくて、\\n　私と話がしたいだなんて……）",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "（しかも、なんだか思いつめた顔をしてるし）",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "だめか？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "い、いえ！\\nそんなことないです、ご一緒します！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "リゼ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "シャロ",
          "original": "（本当にどうしちゃったのかしら、先輩？\\n　黙り込んで、いつもと雰囲気が違う）",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "（話がしたいって言ってたけど、\\n　こんな深刻な様子で何を……）",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "（ま、ま、まさか私に告白！？）",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "（なんてことはないと思うけど、\\n　こんな雰囲気だし、万が一ってことが……）",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "リゼ",
          "original": "なあ、シャロ。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "はひっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "リゼ",
          "original": "話っていうのはな、実は――",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "シャロ",
          "original": "じ、実は？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "リゼ",
          "original": "今朝、お前がココアと話しているのを\\n聞いてしまったんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "シャロ",
          "original": "……はい？",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "リゼ",
          "original": "今朝、道に迷ってるココアと会っただろう？\\nあの時、私もたまたま、すぐそばを\\n通りかかっていたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "リゼ",
          "original": "ココアがきょろきょろしながら歩いているから、\\nまた道に迷ったのかと思って\\n声をかけようとして――",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "リゼ",
          "original": "その前に、ココアがお前に声をかけて……\\nそんなつもりはなかったんだが、\\n成り行きで聞いてしまったんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "シャロ",
          "original": "……そうなんですか。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "シャロ",
          "original": "（あの時、ココアと話してたことっていうと……）",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "リゼ",
          "original": "すまなかった、シャロ。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "シャロ",
          "original": "えええっ！？\\nなんで先輩が謝るんですか！",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "リゼ",
          "original": "ココアも謝っていただろう。\\nお前の都合を考えずに、\\nパーティーのことを全部任せてしまったと。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "リゼ",
          "original": "私もそうだ。\\n手伝えることがあれば\\nなんでも言ってくれなんて言ったが――",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "リゼ",
          "original": "別に深い考えがあったわけではなくて……\\nむしろ、余計なプレッシャーに\\nなってしまったんじゃないか？",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "リゼ",
          "original": "だから……\\n勉強を口実に、お前の様子を窺っていたんだ。\\nいや、勉強を手伝う気もあったんだけどな？",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "リゼ",
          "original": "とにかく、すまなかった。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "シャロ",
          "original": "先輩……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "シャロ",
        "original": "先輩……。",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "私は、幸せ者ですね。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "告白じゃなかったんですね。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "私って、そんなに頼りなく見えますか？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "私は、幸せ者ですね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "千夜やココアやチノちゃん、\\nそして先輩に、こんな風に\\n心配してもらえるなんて、本当に幸せ者です。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "心配するのは当然だ。\\nみんな、シャロのことを\\n大切な友人だと思ってるんだから。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "そ、そんな風に言うのはやめてください。\\nその、照れるというか……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "はは、確かに。\\nだけどさ、こういうことは\\nはっきり言わないと伝わらないものだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "はい……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "と、とにかく、先輩たちが私のことを\\n心配してくれてるのは、よくわかりました。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "でも、大丈夫です。\\nみんなが思ってるほど忙しくはありませんし、\\n引き受けたからには、ちゃんとやり遂げてみせます。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "告白じゃなかったんですね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "は？　何だ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "あ、いえ、なんでもないです！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "（先輩が真面目な話をしてる時に、\\n　私ってば何を……！）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "ええと、ですね？\\n先輩たちが私のことを\\n心配してくれてるのは、よくわかりました。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "でも、大丈夫です。\\n私、引き受けたからには\\nちゃんとやり遂げてみせますから。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "私って、そんなに頼りなく見えますか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "そういう意味じゃないんだ！\\nただ、なんていうか……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "リゼ",
          "original": "お前は頑張りすぎるところがありそうだから、\\n変にプレッシャーをかけて\\n追いつめたんじゃないかと……。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "いいえ、そんなことないです。\\nむしろ期待に応えたいって、そう思いますから。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "そうか……。\\nシャロは強いんだな、私が思っている以上だよ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "そ、そうですか？\\nでも、本当に大丈夫なんですよ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "みんなが思ってるほど忙しくはありませんし、\\n引き受けたからにはやり遂げてみせます。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "そうか、わかった。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "だけど困った時は遠慮なく言ってくれ。\\nみんな、お前の力になりたいと思ってるんだから。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "はい、ありがとうございます！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}