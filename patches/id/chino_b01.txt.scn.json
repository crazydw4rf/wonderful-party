{
  "identity": "chino_b01.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "いらっしゃいませ！\\nこちらのお席へどうぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "はい、それでは少々お待ちください。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "チノちゃん、オーダーだよ。\\nエスプレッソとキリマンジャロ、お願いしまーす。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "あれ、チノちゃん？\\nチノちゃ～ん！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "はっ！？\\nな、なんですか？\\nココアさん、サボってないで働いてください。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "サボってないよ！？\\nちゃんとオーダー取ってきたよ！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "どうしたんだ、チノ。\\n疲れたのか？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "いえ、大丈夫です。\\nココアさん、オーダーですか？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "うん！\\nエスプレッソとキリマンジャロ、お願いしまーす。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "チノ",
          "original": "はい、わかりました。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "（またやってしまいました。\\n　昨日から、おもてなしの心のことが\\n　頭から離れなくて……）",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "（みんなをおもてなしするには、\\n　どうすればいいんでしょうか？）",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "チノ？\\nさっきから何をやって……。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "はっ！？\\nこ、これは……。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "またか！\\nなんで大量のココアを作るんだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "私は１人だよ！？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "いや、そっちじゃない！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "い、いつの間に……。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "大丈夫だよ、チノちゃん。\\nこれは私が全部、飲んであげるから。\\nいざっ！",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "こ、ココアさん！\\nお客さんの前で堂々と飲むのは……。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "リゼ",
          "original": "うーん、昨日、青山さんと話したことで\\n解決したのかと思ったが……\\nもしや別の問題が発生したのか？",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "すみません、リゼさん。\\nまたやってしまいました。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "リゼ",
          "original": "いや、そんなに謝らなくていいよ。\\nわざとやってるわけじゃないんだしな。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "チノ",
          "original": "……はい。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "リゼ",
          "original": "うん、それでいい。\\nチノがこんなに悩んでるんだ、\\nよっぽど大切なことなんだろう？",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "リゼ",
          "original": "だけど、仕事をしている時は集中だ。\\nぼーっとしているとケガをするかもしれない。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "チノ",
          "original": "はい、すみま――いえ、わかりました。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "ココア",
          "original": "２人とも、私がミスした時と反応が違うよ！？",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "リゼ",
          "original": "悩むことは間違ってない。\\n人間、悩みを乗り越えてこそ成長する。\\nだから大いに悩むことが大切なんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "そう、若いうちはいっぱい悩んでいいんだよ。\\n私が全部受け止めてあげるから！",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "チノ",
          "original": "ココアさんはいくつなんですか。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "リゼ",
          "original": "なんだか千夜みたいだな。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "ココア",
          "original": "ほらほら、言ってごらん？\\nお姉ちゃんがなーんでも解決するよ？",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "チノ",
          "original": "……ココアさんには内緒です。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "ココア",
          "original": "え～っ！？",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "チノ",
          "original": "（頑固だと思われるかもしれませんが、\\n　もう少し悩んでみたいんです。\\n　自分で納得するまで……）",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "女性客Ｂ",
          "original": "すみませ～ん。",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "ココア",
          "original": "あ、はーい！\\nただいま参りまーす！",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "リゼ",
          "original": "ああ、そうだ。\\n今は店も落ち着いているし、気分転換もかねて\\n散歩に行ってきたらどうだ？",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "チノ",
          "original": "え？　いいんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "リゼ",
          "original": "ココアもいるし、問題ないよ。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "チノ",
          "original": "（確かに、少し気分転換が必要そうです。\\n　それじゃ……）",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "チノ",
          "original": "ありがとうございます。\\nお言葉に甘えて、お店のことはお願いします。",
          "translation": "",
          "status": "untranslated"
        },
        "47": {
          "speaker": "リゼ",
          "original": "ああ、任せておけ。",
          "translation": "",
          "status": "untranslated"
        },
        "48": {
          "speaker": "チノ",
          "original": "では、失礼します。",
          "translation": "",
          "status": "untranslated"
        },
        "49": {
          "speaker": "ココア",
          "original": "オーダー取ってきたよー。\\nって、あれ？　チノちゃん、どこに行ったの？",
          "translation": "",
          "status": "untranslated"
        },
        "50": {
          "speaker": "リゼ",
          "original": "休憩だよ。",
          "translation": "",
          "status": "untranslated"
        },
        "51": {
          "speaker": "ココア",
          "original": "そっかぁ。\\nじゃあ、私も休憩に行こっかな～。",
          "translation": "",
          "status": "untranslated"
        },
        "52": {
          "speaker": "リゼ",
          "original": "お前は仕事だ。\\nほら、この大量のミルクココアを\\n全部飲んであげるんだろ？",
          "translation": "",
          "status": "untranslated"
        },
        "53": {
          "speaker": "ココア",
          "original": "はううっ！？\\nそ、そうだった……！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}