{
  "identity": "flyer_chino_f2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "ココアさん、どうかしたんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "え？　何が？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "空を見上げたまま、\\nぼーっとしているようだったので。\\n何か見えるんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "うん、ちょっと雲が出てきたなーって。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "ねえ、チノちゃん。\\nこの街のクリスマスってどんな感じ？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "え？　なんですか、急に。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "雲を見てて思ったんだ。\\nこの街、クリスマスに\\n雪が降ったりするのかなーって。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "ああ、そういうことですか。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "雪なら結構、降りますよ。\\nホワイトクリスマスも珍しくないです。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "ホワイトクリスマス！？\\nすっごーい！　素敵だねっ！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "チノ",
          "original": "お、落ち着いてください。\\n今年も降るとは限りませんし。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "でも、雪はよく降るんでしょ？\\n楽しみだなー、いっぱい積もるといいなー。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "雪だるまを作って、\\n雪うさぎも一緒に並べたりして、\\nもちろんかまくらを作ったりもして――",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "みんなで集まって雪合戦もいいよね？\\n雪まみれになって、そのあとに\\nお風呂で温まるところまで含めて楽しみだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "それから、ソリにも乗りたいな。\\nこの辺りで滑れるところってあるのかな？\\nみんなで競争とかできたらいいね。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "……色々やる気なんですね。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "うん！\\nもちろんチノちゃんも一緒にね。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "私もですか？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "当然だよ。\\nみんなで一緒に遊ぶから余計に楽しいんだもん。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "……そうですね。\\nそういうものかもしれません。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "あーあ、早く雪降ってこないかな～。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "チノ",
          "original": "あまり早く降ってこられても困ります。\\n雪かきをするのが大変ですし。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "チノちゃんは現実的だねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "ココアさんが夢見がちすぎるだけです。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "まあ、そういうところは\\n嫌いじゃありませんけど。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "え？　今なんて言ったの？",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "チノ",
          "original": "少し雲の様子が変わってきた、と言ったんです。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "あ、本当だ。\\n向こうの方とか、\\n雨が降りそうな雲になってきたね。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "チノ",
          "original": "早くチラシを配ってしまいましょう。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "ココア",
          "original": "雨が降ってきたら大変だもんね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}