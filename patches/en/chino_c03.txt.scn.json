{
  "identity": "chino_c03.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "おまたせ、チノちゃん。\\nさあ、どうぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "こ、これは……！\\nあんみつですか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "ええ、そうよ。\\nちょっと改良してみたの。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "と、いうか……\\nえっと、千夜さん、これは……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "これは試作だから、お代は気にしなくていいわ。\\nその代わり、食べたあとに\\nちゃんと感想を聞かせてね。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "でも……本当にいいんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "もちろんよ。\\nさあどうぞ、召し上がれ。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "はい。\\nでは、いただきます。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "あむっ……ん、ん……んっ！！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "（おいしい……！\\n　甘兎庵のあんこはしっかり甘くて、\\n　でも上品で、いくらでも食べられそう）",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "あむっ……ん、ん……。\\nあむ……んんん……。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "どうかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "おいしいです……！\\nさっきから、スプーンが止まりません。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "そう、よかった。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "（一口食べるごとに、悩みがすっと解けて\\n　幸せな気分に包まれていくようです）",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "（こんなにおいしくて素敵な甘味を作れる\\n　千夜さんなら、きっと……）",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "あら、あんこったら。\\nそれはチノちゃんのものなんだから、\\nおねだりしちゃだめよ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "いえ、せっかくですから、\\nあんこも少し食べますか？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "いいの？\\nよかったわね、あんこ。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "チノ",
          "original": "ふう……。\\nごちそうさまでした。\\nとってもおいしかったです。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "千夜",
          "original": "いえいえ、おそまつさまでした。\\nチノちゃん、もう大丈夫みたいね。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "えっ？　大丈夫って何がですか？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "今日、何か用事があってうちに来たんでしょう？\\nご用件はなにかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "！！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "（バレてる！\\n　というか、千夜さんから見たら、\\n　バレバレなのかもしれませんが……）",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "あ、あの……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "チノ",
        "original": "あ、あの……。",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "相談したいことがあるんです。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "お、おかわりが……欲しいです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "相談したいことがあるんです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "あら、そうだったの。\\n私でいいのかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "はい。\\nぜひ、千夜さんに聞いて欲しいことなんです。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "そんな風に言われるなんて……\\nなんだかココアちゃんに申し訳なくなるわね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "ど、どうしてそこで\\nココアさんが出てくるんですか。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "だって、ココアちゃん、\\n１番に相談してほしいって思っているはずだもの。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "それは充分わかっているんですが……\\n事情がありまして。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "そんなに言いにくいことなのかしら？\\nまさか……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "甘兎に、ライバルとして宣戦布告を！？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "ち、違いますっ！\\nそんなことじゃないんです！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "ふふふふ、冗談よ。\\n私はずっと待っているから、\\nゆっくり考えて言ってみて？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "はい……。\\nありがとうございます。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "お、おかわりが……欲しいです。\\nあんみつ、とってもおいしかったので……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "ありがとう。\\nでも、それは試作品だからお代わりはないの。\\nごめんなさい。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "うちの甘味を気に入って、\\nお腹いっぱい食べてくれるのは嬉しいけど――",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "チノちゃん、それだけでいいの？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "うっ……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "あ、あの……千夜さん。\\n私に、ケーキの作り方を教えてください！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "ケーキ？\\nそれって、お菓子の？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "はい、お菓子のケーキの作り方です。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "その、実は……今度のクリスマスパーティー、\\n手作りのケーキでみんなを\\nおもてなししたいと考えているんです。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "でも、マヤさんやメグさんと\\n一緒に作ってみても、上手くいかなくて。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "そんな時、千夜さんだったら\\n上手に作れるかもしれないと\\nマヤさんが思いついて……それで……。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "そうだったの。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "はい。\\n突然でご迷惑とは思いますが、\\nどうかお願いします。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "うーん……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "……やっぱり無理でしょうか？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "千夜",
          "original": "ううん、そんな。\\n無理なんてことはないし、\\n頼ってくれたのもとっても嬉しいの。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "ただ、１つ問題があって。\\n私、和菓子は得意だけど\\n洋菓子は人に教えられるほどじゃないの。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "そ、そうなんですか！？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "で、ですが、同じお菓子なので\\n基本は同じなのではないでしょうか？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "もう、頼れるのは千夜さんだけなんです。\\n無理を承知でお願いします。\\n私にケーキ作りを教えてください。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "私に、どうか……\\nおもてなしをさせてください！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "チノちゃん……！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "千夜",
          "original": "わかったわ。\\n私でよければ協力させて。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "千夜さん……！\\nありがとうございます！",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "千夜",
          "original": "でも、私もまだまだなところがあるから、\\n一緒に修行ね。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "大丈夫です。\\nどんな修行にも耐えるつもりです。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "千夜",
          "original": "その心意気よ！\\nこれから一緒に鍛練に鍛練を重ねて、\\n最高のケーキを作り出しましょう！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "そうと決まれば、今日から修行開始よ！\\n覚悟はいいかしら、チノちゃん？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "はい！\\n千夜さん、よろしくお願いします！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}