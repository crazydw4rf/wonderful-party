    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "でしょ？\\n朝食はしっかり食べないと、\\n１日保たないって言うしね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "栄養つけて、悩みも吹き飛ばして、\\n今日も頑張ろうね、チノちゃん。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "ありがとうございます。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "やだな～、そんなに真面目にお礼なんて\\n言わなくていいよ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "これは姉として当然のことをしてるだけだからね。\\nだから、じゃんじゃん頼ってもらっていいんだよ？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "早起きさせて、すみません。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "えっ？\\nどうして謝るの？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "その、わざわざパンを焼くために\\nココアさんに早起きをさせてしまったので。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "う、ううん、気にしないで！\\n今日は、その、ほら、\\nたまたま早く目が覚めちゃっただけだから。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "ココアさん……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "（ココアさんの気遣いに応えるためにも、\\n　パーティーは絶対、成功させなくちゃ）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "（だからこそ、ココアさんには相談できません。\\n　……ごめんなさい）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "ココアさんも早く食べないと遅刻しますよ？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "あっ、いっけない！\\nいだきまーす！\\nあむあむあむ……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "そんなに急いで食べたら、喉に詰まりますよ。\\n牛乳を用意しますね。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "うん！\\nありがとう、チノちゃん。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
