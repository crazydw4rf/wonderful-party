{
  "identity": "syaro_a03.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "シャロちゃん、忘れ物はない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "大丈夫よ。\\n子どもじゃないんだから、そんな心配しないで。\\nじゃあね。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "ええ。\\nそれじゃ、いってらっしゃい。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "（もう、千夜ってば、本当にお節介なんだから。\\n　……それがいいところではあるんだけど）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "（それにしても、リゼ先輩だけじゃなくて\\n　千夜にまであんな風に言われちゃったんだから、\\n　しっかりしなきゃね）",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "（とりあえず、クリスマスまでは\\n　毎日、何かしらのバイトが入ってるのよね）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "（それが終わって家に帰ってから試験勉強……\\n　なんてしてると、パーティーのことを\\n　考えてる余裕がないわ）",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "（かと言って、バイト中に考え事をして\\n　ミスをしたら大変だし……）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "（いっそ、学校の休み時間や昼休みを\\n　試験勉強にあてるべきね）",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "（それで、家に帰ってからの時間で\\n　パーティーでやることを考える）",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "（期末試験さえ終われば、\\n　ある程度は時間に余裕ができるし、\\n　実際に準備に取りかかるのはそれからでも――）",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "……大丈夫かしら？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "ううん、きっと大丈夫。\\nこれならギリギリいけるはずよ。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "あっ！　シャロちゃんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "シャロ",
          "original": "えっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "おっはよー、シャロちゃん！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "（ココア！？\\n　ま、まさか、今の、聞かれてた！？）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "シャロ",
        "original": "（ココア！？\\n　ま、まさか、今の、聞かれてた！？）",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "もしかして、今の、聞いてた！？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "なんでいるのよ！？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "（ご、誤魔化さないと！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "もしかして、今の、聞いてた！？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "今のって？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "べ、別にパーティのことで\\n無理してるわけじゃないの！\\n効率のいい時間のやりくりを考えてただけだから！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "え？　え？　何のこと？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "……あれ？\\nココア、もしかして何も聞いてなかったの？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "私、シャロちゃんの姿が見えたから\\n声をかけただけだよ？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "……そ、そう。\\nだったらいいんだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "あ、そうだ、挨拶がまだだったわね。\\nおはよ、ココア。朝から元気ね。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "うん！\\n朝からシャロちゃんに会えて、\\nますます元気になっちゃったよ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "ところで？\\nなんでココアがこんなところにいるわけ？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "なんでいるのよ！？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "え？　なんでって……\\nシャロちゃんが見えたから\\n朝の挨拶をしようかなって。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "はっ！？\\nもしかしてシャロちゃん、\\n今、何かの極秘任務中だったの？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "へっ！？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "そっか……。\\nリゼちゃんに続いて、シャロちゃんも\\nスパイ活動をするようになったんだね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "ま、まさか、シャロちゃんたちの学校って、\\nお嬢様学校は仮の姿で、本当は\\nスパイ養成学校だったりするの！？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "勝手に想像を広げてるんじゃないわよ！\\n普通の学校よ、普通の！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "そっかぁ。\\nだったら面白かったのになぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "（この様子じゃ、私の独り言は\\n　聞いてなかったみたいね）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "でも、本当に、なんでここにいるの？\\nココアの学校ってこっちじゃないでしょ？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "（ご、誤魔化さないと！\\n　何か他に、ココアの興味を引きそうなことを……\\n　そうだわ！）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "ごきげんよう、ココアさん。\\n今日もいい天気ですわね～、ほ、ほほほほほほ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "（いつも、私の学校が\\n　お嬢様学校だとか言ってるし、\\n　これなら食いついてくるでしょ！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "おおっ！？\\nシャロちゃんがお嬢様な挨拶を？\\nじゃあ、私も！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "ごきげんよう、シャロさん。\\n朝から爽やかな風が吹いてますですわね。\\n今日も元気に参りましょうですわ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "なんかおかしなことになってるわよ、語尾が。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "あれれ？\\nお嬢様っぽくするのは難しいねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "それに比べて、さすがシャロちゃん！\\n放ってるオーラが違うよ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "（よしっ！\\n　このまま話をずらしちゃえばいいわね）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "それよりも、なんでココアがここにいるの？\\nあんたの学校はこっちじゃないでしょ？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "えへへ～。\\n実はちょっと迷子になっちゃって。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "迷子？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "最近、クリスマスの飾りつけの準備が\\n街中で始まってるでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "その様子がすっごく楽しそうで、\\n見て歩いてたら、いつの間にか\\n学校とは違う方向に来ちゃったみたい。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "はあ、そういうことなのね。\\nココアらしいわ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "でも、ちょうどよかった！\\n私、シャロちゃんに\\n謝らなくちゃって思ってたから。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "え？　謝るって何を？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "昨日のことだよ。\\nごめんね、クリスマスパーティーの準備を\\n任せる形になっちゃって。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "え……？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "ラビットハウスに帰ったあと、\\nチノちゃんに言われて気づいたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "シャロちゃんはバイトで忙しいから、\\nパーティーの準備のために時間を作るのが\\n大変なはずだって。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "だから、もっと強く『お手伝いするよ』って\\n言った方がよかったんじゃないかって。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "あ……それは……。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "私、シャロちゃんがどんなパーティーを\\n開いてくれるのか、そればかり楽しみで\\n任せちゃったけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "シャロちゃんの都合だってあるんだから、\\n全部任せちゃうっていうのは――",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "大丈夫よ。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "うん、やっぱり大変だよね。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "ちがーう！\\n何を聞いてたのよ、大丈夫って言ったの！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "えっ？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "（もう……。\\n　リゼ先輩や千夜だけじゃなく、ココアや\\n　チノちゃんにまで心配されるなんて……）",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "言ったでしょ？\\nなんとかしてみせるって。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "１度言ったことにはきちんと責任を持つわ。\\n予定通り、パーティーの準備は私に任せなさい。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "でも……。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "シャロ",
          "original": "大丈夫よ。\\n伊達に、普段から色々なバイトを\\n掛け持ちしてないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "シャロ",
          "original": "まあ、確かに、クリスマスまでは\\nいつもよりちょっと忙しいけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "やっぱり忙しいんだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "シャロ",
          "original": "しつこいわね。\\nそれも考えた上で、大丈夫だって言ってるの。\\n少しは私を信頼しなさい。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "シャロちゃん……。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "うん、わかった。\\nじゃあ、パーティーのことは\\nシャロちゃんに任せるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "でも、もし無理そうだったら\\nいつでも言ってね？",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "シャロ",
          "original": "はいはい、わかったから。\\n用件がそれだけなら、もう学校に行きなさい。\\n遅刻するわよ。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "ココア",
          "original": "はーい。\\nシャロちゃんも遅刻しちゃだめだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "シャロ",
          "original": "言われるまでもないわよ。\\nじゃあね。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "ココア",
          "original": "あ……！",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "シャロ",
          "original": "何？　どうかした？",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "ココア",
          "original": "え、えーっと……\\nシャロちゃん、私の学校って\\nどっちに行けばいいのかな？",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "シャロ",
          "original": "あー、もう、仕方ないわねぇ。\\n教えてあげるから、もう迷うんじゃないわよ？",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "ココア",
          "original": "はーい。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}