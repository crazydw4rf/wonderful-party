{
  "identity": "flyer_chino_g3.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "ねえチノちゃん、いいもの見つけちゃった。\\nほら！　今の私たちの格好に\\nぴったりだと思わない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "ジャック・オー・ランタンですか。\\n確かにそう思いますけど、\\nどうしてこんなところにあるんでしょう。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "誰かが、飾ったまま片付けを\\n忘れてるんじゃないかな？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "無責任な人ですね。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "ねえねえ、チノちゃん。\\nカボチャって言えば、どんなお料理を想像する？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "……ココアさん、\\nもしかしてお腹空いたんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "ううん、そういうわけじゃないけど――",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "ちょっと寒いからかな？\\nふっと、温かいカボチャのスープが\\n食べたいなって思ったの。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "チノ",
          "original": "カボチャのスープ、いいですね。\\n季節のものですし、\\n甘くておいしいのが作れそうです。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "じゃ、帰りに、ハロウィンぽく\\nジャック・オー・ランタンを買っていこっか。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "……え？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "ん？\\n私、何かおかしなこと言った？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "あの、ココアさん。\\n念のため言っておきますけど――",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "ジャック・オー・ランタンというのは\\nカボチャで作ったこの飾りのことですよ？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "うん。\\nカボチャでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "……ココアさん、これは中に火を灯して\\nランタンとして使うものであって\\n食べられませんよ？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "ええ！？　そうなの？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "カボチャである以上、食べようと思えば\\n食べられるのかもしれませんが……\\n食用に向いているものではないと思います。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "そうなんだぁ……。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "じゃあ、この子は余計に可哀想だね。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア",
          "original": "だって、こんなふうに置いたままにされて\\n食べてももらえないなんて――",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "あ、そうだ。\\nねえチノちゃん、私たちで\\nこの子を飾った人を捜してみない？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "……見つかるとは限りませんよ？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "でも、このままにしておけないよ。\\nだめかな？",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "チノ",
          "original": "……いいですよ。\\n気分転換に少しくらいなら。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "ありがとう、チノちゃん！",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "チノ",
          "original": "本当にもう、ココアさんは……。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "ん？　何？",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "チノ",
          "original": "なんでもありませんよ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}