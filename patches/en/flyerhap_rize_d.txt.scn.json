{
  "identity": "flyerhap_rize_d.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "リゼちゃん！\\nチラシ配り、一緒にやらない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "ああ、それなんだが、\\n今日はみんな揃って配ることができそうだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "じゃあ、せっかくだし、みんなでやろうか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "ない、ない、ないっ！\\nどこにもなーいっ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "どうした、ココア？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "大変だよ、チラシのストックがないの！\\nここに置いてあったはずなのに、なくなってる！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "ええっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "まさか、誰かが盗んでいったの？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "うん、これは事件だよ！\\nこの平和な街に巻き起こった凶悪犯罪だよ！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "犯罪なのは確かだけど、さすがに大げさでしょ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "だが、事件を解決しなければチラシは戻ってこない。\\nよしみんな、力を合わせてチラシを取り戻すぞ！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "おー！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "ああ、先輩がノリノリに……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "うーん……。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "ココア、チラシのストックは\\n確かにこのベンチの上に置いたんだな？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "はいであります、サー！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "もしかして、何者かが私たちのチラシ配りを\\n邪魔しようとしたのでしょうか。\\nそれでストックを持ち去った……？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "しかし、私たちの誰にも気付かれず\\nストックをすべて持っていくのは不可能だろう。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "ふっふっふ！\\nこの事件の真相、私にはもふっとお見通しだよ！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "リゼ",
          "original": "なんだと！？\\nまさか、もう犯人の目星がついたのか？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "シャロ",
          "original": "ていうか、もふっとって何？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "いいところに気がついたね、シャロちゃん。\\nこの事件の重要なポイントは、\\nずばり、もふもふなんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "ど、どういうことですか？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "つまり、もふもふな野良うさぎが犯人なのです！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "ええ～っ！？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "そう思う理由は当然、あるんだな？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "もちろん！\\nまず、この街はたくさん野良うさぎがいるよね。\\n風景として、誰も気に留めないほどに。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "よって、私たちの監視をかいくぐって\\nチラシを持ち出せたのは、\\n野良うさぎ以外にいないのです！",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "リゼ",
          "original": "……ココア。\\nそれ、推理としては悪くないが――",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "リゼ",
          "original": "ストックのチラシは結構な枚数があったんだぞ？\\nうさぎが持ち去れると思うか？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "ココア",
          "original": "あ……。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "チノ",
          "original": "ココアさんに期待した私がばかでした。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "リゼ",
          "original": "ああ、推理は振り出しに戻ったな。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "あっ！\\nじゃ、じゃあ、鳥だよ！\\nカラスとか、鳥が持っていったんだよ！",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "リゼ",
          "original": "カラスが狙うのは光り物だぞ？\\nチラシは持っていかないだろ。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "シャロ",
          "original": "あの、先輩？\\nストックはまだラビットハウスにあるんだし、\\nそこまで追求しなくてもいいのでは……。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "リゼ",
          "original": "いや、犯行が繰り返される可能性もある。\\nきちんと解決しなくては――",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "リゼ",
          "original": "うわっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "ココア",
          "original": "あ、あああああ～！\\nチラシが、チラシが風にさらわれたー！",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "千夜",
          "original": "ご、ごめんなさいっ！\\n実は私、さっき、チラシが飛んでいくのを見たの！",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "千夜",
          "original": "でもリゼちゃんもココアちゃんも\\n楽しそうだから言い出せなくって……！",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "リゼ",
          "original": "そうだったのか！？",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "千夜",
          "original": "私が、私がもっと早く言っていれば～！\\nよよよよ……。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "シャロ",
          "original": "落ち込んでないで、チラシを拾いに行くわよ！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}