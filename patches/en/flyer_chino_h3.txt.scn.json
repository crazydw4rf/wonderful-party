{
  "identity": "flyer_chino_h3.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "女の子Ｅ",
          "original": "あー、怪盗ラパンだぁ！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "女の子Ｅ",
          "original": "わーい！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "ひゃっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "びっくりしたぁ。\\n急に飛びついてきたら危ないよ？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "女の子Ｅ",
          "original": "ごめんなさーい。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "チノ",
          "original": "どうしたんですか、ココアさん？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "女の子Ｅ",
          "original": "あれぇ？\\nラパンがもう１人いるよ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "この子、怪盗ラパンのファンみたいなんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "女の子Ｅ",
          "original": "ねえねえ、どっちが本物のラパンなの？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "ふっふっふ……",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア",
          "original": "本物のラパンは私だぁ☆",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "女の子Ｅ",
          "original": "わー、かっこいい♪",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "チノちゃんも、早く。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "女の子Ｅ",
          "original": "じー……。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "ほら、期待してるみたいだから。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "ですが、なんて言えば……。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "じゃあね、ごにょごにょ……。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "わかりました。\\nええと……。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "わ、私こそが、本物のラパンだ！",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "女の子Ｅ",
          "original": "んー？\\nなんだかラパンぽくないよ？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "うっ……。\\nそんなことはありません。\\n決めポーズの、この肘の角度を見てください。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "女の子Ｅ",
          "original": "あ、ポーズはこっちのラパンの方がかっこいい！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "どうです、ココアさん。\\n私もなかなかのものでしょう。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "女の子Ｅ",
          "original": "ねえねえ、ロイヤルフラッシュアタック見せて！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "チノ",
          "original": "いいですよ。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "チノちゃん、\\nどこからトランプなんて出したの！？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "たまたまポケットの中に入っていたんです。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア（Ｍ）",
          "original": "（たまたま入ってるようなものじゃないと\\n　思うんだけど……）",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "いいですか？\\nしっかり見ていてくださいね。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "女の子Ｅ",
          "original": "うん！",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "女の子Ｅ",
          "original": "お姉ちゃんたち、ばいばーい！",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "ばいばーい！\\n気をつけて帰ってね！",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "チノ",
          "original": "結局、最後には２人とも偽者だと\\nバレてしまいましたね。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "ココア",
          "original": "仕方ないよ。\\n本物みたいになんでもできるわけじゃないんだし。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ココア",
          "original": "でもチノちゃん、\\n結構ラパンになりきってたよね？",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "チノ",
          "original": "そ、それは……\\nあの子が喜んでくれるから、つい……。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "ココア",
          "original": "ねえ、もう１回やってみせてよ、決め台詞。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "チノ",
          "original": "嫌です！",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "ココア",
          "original": "えー、さっきはすごくノリノリだったのに。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "チノ",
          "original": "忘れてください！",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "ココア",
          "original": "それは無理だよ。\\nもう脳内にしっかり記憶しちゃった。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "チノ",
          "original": "うー……。\\nもうココアさんなんて知りません！",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}