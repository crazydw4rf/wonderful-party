{
  "identity": "syaro_d05.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "シャロちゃん、どうかしら？\\n制服、似合ってる？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "シャロちゃん？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "はあ……。\\nリゼ先輩といい千夜といい、どうして……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "どうしたの、溜め息なんてついて。\\nそんなに似合ってないかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "いいえ。\\nとっても似合ってるわよ、ええ、とっても。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "あら、そう？\\nうふふふ、ありがとう。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "あ、お客さんが来たわね。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "まかせて。\\n私が行ってくるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "いらっしゃいませ～。\\nフルール・ド・ラパンへようこそ。\\n１名様ですね、こちらのお席へどうぞ。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "（へえ……。\\n　まかせろって言うだけあって、\\n　なかなかスムーズな接客じゃない）",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "お困りでしたら、\\nおすすめのハーブティをお選びしますよ？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "千夜",
          "original": "そうですね、リフレッシュしたい時には\\nレモングラスがおすすめです。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "はい、では、レモングラスをお持ちいたします。\\n少々お待ちください。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "千夜",
          "original": "シャロちゃん。\\n今の接客、どうだったかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "驚いたわ。\\n挨拶も自然だったけど、\\nハーブティのこともちゃんと覚えてきたのね。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "ええ、シャロちゃんのお手伝いをするって\\n決まってから、しっかり勉強したの。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "真面目ねぇ。\\nまあ、すごくありがたいけど。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "ふふふ！\\nだってね、私、ずっと楽しみだったから。\\nこういう時間が夢だったのよ。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "（え？　夢ってどういうこと？）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "シャロ",
        "original": "（え？　夢ってどういうこと？）",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "それってもしかして……。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "フルールで働きたかったの？",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "ハーブに興味があったの？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "それってもしかして……\\n私と一緒に働いてみたかった、とか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "なんて、冗談――",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "あら、どうしてわかったの？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "えっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "そうなの。\\n私ね、いつかシャロちゃんと同じ制服を着て\\n一緒に働いてみたかったの。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "あ……そ、そうだったの？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "そ、それくらいのことなら、\\nいつでも言ってくれたらよかったのに。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "フルールで働きたかったの？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "うーん、別に、ここじゃなくても\\nよかったのだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "え？　だったら、どういう意味？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "私はね、こうして\\nシャロちゃんと一緒に働いてみたかったの。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "え……。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "もう、わざわざ言わせるなんて。\\nシャロちゃんはいじわるねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "あ、あ、あ、だって、全然、\\n気がついてなかったから……。\\n言ってくれたらよかったのに。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "ハーブに興味があったの？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "いいえ、\\nそれほど興味があるわけじゃないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "じゃあ、その夢って何よ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "もう、シャロちゃん、\\n気がついてもくれないのね。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "そんなこと言われても……。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "私ね、いつかこうして\\nシャロちゃんと一緒に働くのが夢だったのよ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "えっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "千夜",
          "original": "こんな形で夢が叶うなんて思わなかったわ。\\n甘兎で一緒に、だったら、なおよかったのだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "……そ、そう、なんだ。\\n言ってくれたらよかったのに。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "忙しくない時なら、\\n少しくらい手伝ってあげても……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "本当に？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "……ええ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "それじゃ、今度、お願いするわ。\\nその時はよろしくね。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "……わかった。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}