      "texts": {
        "0": {
          "speaker": "ココア（Ｍ）",
          "original": "（ふう～、いいお湯だったな～）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア（Ｍ）",
          "original": "（あとは寝るだけだけど、その前に……）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア（Ｍ）",
          "original": "（チノちゃんのお誕生日のこと、\\n　みんなにメールしよっと！）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア（Ｍ）",
          "original": "（チノちゃんのお誕生日をお祝いしたいから\\n　協力してください――）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア（Ｍ）",
          "original": "（送るのは、リゼちゃんと千夜ちゃんと\\n　シャロちゃんと、それに\\n　マヤちゃんとメグちゃんかな）",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア（Ｍ）",
          "original": "（これでよしっと！\\n　みんな、きっと協力してくれるよね）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア（Ｍ）",
          "original": "（わわっ！？　もう返事が来た！？）",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ココア（Ｍ）",
          "original": "（あ、シャロちゃんだ！\\n　もちろん協力するって……やったぁ！）",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア（Ｍ）",
          "original": "（他のみんなも、こんなに早く\\n　返事をくれるなんて……！）",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア（Ｍ）",
          "original": "（感激だよぉ～！\\n　チノちゃんがこんなに愛されてて\\n　お姉ちゃん嬉しいっ！）",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア（Ｍ）",
          "original": "（これは、ますます頑張らなくちゃ！\\n　みんなの想いを無駄になんて\\n　絶対できないよっ！）",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア（Ｍ）",
          "original": "（お誕生日と言えば、まずはプレゼントかな？\\n　うーん、何がいいかな？）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
