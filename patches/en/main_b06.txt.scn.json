{
  "identity": "main_b06.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "ココアちゃん、何か見つかった？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "うん。\\nとりあえず、これにしようかなっていうのは\\n見つけたよ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "でも、ごめんね千夜ちゃん。\\nわざわざ付き合わせちゃって。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "いいのよ、これくらい。\\n私も、そろそろチノちゃんへのプレゼントを\\n買わないとって思っていたから。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "チノちゃんの誕生日、もう今週末なんだよね。\\nなんだか、あっという間だったなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "ココアちゃんは、誕生日パーティーの準備とか\\nチラシ配りで忙しそうだったものね。\\nそう感じるのも無理ないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "うーん。\\nチノちゃん、喜んでくれるかな？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "千夜",
          "original": "大丈夫！\\nココアちゃんの気持ちはちゃんと伝わるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "えへへ～。\\nだといいんだけどな。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "何が、だといいんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "何ってチノちゃんが――",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "こ、ココアちゃんっ！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "ココア",
          "original": "むぐっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "チノ",
          "original": "どうかしたんですか、千夜さん？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "マヤ",
          "original": "いきなりココアの口を押さえて……なんか変だぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "メグ",
          "original": "ココアちゃん、苦しそう～。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "な、なんでもないのよ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "ふぅ～！\\nああ、びっくりした。\\nチノちゃんたち、どうしてこんなところにいるの？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "バイトの時間まで、マヤさんとメグさんと\\n一緒に街をぶらついていただけです。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "チノ",
          "original": "ココアさんこそ、\\nこんなところで何をしてるんです？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "わ、私たちもぶらついてただけだよね～？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "千夜",
          "original": "ね～？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "マヤ",
          "original": "でも今、チノの名前を呼んでたよな？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "き、気のせいじゃないかな。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "マヤ",
          "original": "気のせいなんかじゃないって。\\n絶対言ってた。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "うっ……。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ＆マヤ＆メグ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア（Ｍ）",
          "original": "（す、すっごく疑われてる！？\\n　なんとかしなくちゃ！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
