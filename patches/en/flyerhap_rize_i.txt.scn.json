{
  "identity": "flyerhap_rize_i.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "リゼちゃん！\\nチラシ配り、一緒にやらない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "ああ、それなんだが、\\n今日はみんな揃って配ることができそうだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "じゃあ、せっかくだし、みんなでやろうか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "メグ",
          "original": "うわぁ～！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "マヤ",
          "original": "うおお！\\nこれはすごい……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "あれ、マヤにメグじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "今帰りなの？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "マヤ",
          "original": "そうなんだけど……。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "メグ",
          "original": "なんだか落ち込んじゃうね……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "リゼ",
          "original": "はっ？\\nいきなりなんでだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "あれ？\\nマヤさん、メグさんも。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "チラシ、受け取りに来てくれたの？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "マヤ",
          "original": "よう、チノ！",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "メグ",
          "original": "ふう、ちょっと安心した～。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "安心？\\nどうかしたんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "メグ",
          "original": "あのね、リゼさんもだけど、\\nココアちゃんも結構大きいんだな～って思って。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "マヤ",
          "original": "それで、チノとシャロを見て安心したって言うか。\\nあはは！",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "……そういうことですか。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "……すごーく複雑なんだけど。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "マヤ",
          "original": "なあ、リゼ。\\nどうやったら、そんな風に大人っぽくなれるんだ？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "メグ",
          "original": "私も知りた～い！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "私も興味があります。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "ま、待って！\\nどうしてお姉ちゃんじゃなくて\\nリゼちゃんに聞くの！？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "マヤ",
          "original": "だって、リゼに聞いた方がいいもーん。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "メグ",
          "original": "千夜さんでもいいかも～。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "チノ",
          "original": "確かに……\\nココアさんより大人っぽいですから。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ココア（Ｍ）",
          "original": "（ががーん！\\n　妹たちに尊敬されてないの、私！？）",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "千夜",
          "original": "私は、ココアちゃんと同い年よ？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "私だって１つ上なだけだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "マヤ",
          "original": "でも、ココアにないものがあるからさ。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "ええー！？\\n私、何が足りないの！？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "シャロ",
          "original": "フルール・ド・ラパンをよろしくお願いしまーす。\\nフルール・ド・ラパンでーす。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "シャロちゃーん！\\n私に足りないものってなに！？",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "シャロ",
          "original": "うるさーい！\\n私のことはほっといてよー！",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "なんで怒るの！？\\nあ、じゃあ、リゼちゃん！\\n私に足りないものってなんなの！？",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "リゼ",
          "original": "うーん、思いつくことはあるが、\\nまず自分で考えてみたらどうだ？\\n自身を省みることは大切じゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "ココア（Ｍ）",
          "original": "（私に足りないもの、足りないもの。\\n　リゼちゃんや千夜ちゃんにあって\\n　私に足りないもの……）",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ココア",
          "original": "落ち着き、かなぁ？",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "リゼ",
          "original": "……年齢とか言い出すかと思ったんだが、\\n意外としっかり分析したな。\\n正直、驚いた。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "ココア",
          "original": "えへへ、よく言われるんだ。\\nココアさんは落ち着きが足りません、って。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "リゼ",
          "original": "ああ、チノに言われてるのか。",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "ココア",
          "original": "そうなんだよー！\\nお姉ちゃんに意見する妹ってのもまたかわいくて。\\nそういうことができるのは仲良し姉妹の証だよね。",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "千夜",
          "original": "ココアちゃんはどんな時も前向きね。\\nそこは、私にはないところだと思うわ。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "チノ",
          "original": "千夜さん、下手に褒めないでください。\\nあとが大変なので。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "マヤ",
          "original": "でさ、ココアはともかくとして、\\nリゼみたいになるのにはどーすんの？",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "リゼ",
          "original": "そうだな……。\\n私のような身のこなしを手に入れるには\\n訓練あるのみだな。",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "メグ",
          "original": "訓練あるのみ……。\\nうん、きっと成長に対する\\nストイックな精神が重要なんだね。",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "マヤ",
          "original": "ええー。\\n大人っぽくなるのは大変そうだなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "チノ",
          "original": "こつこつ頑張るしかありませんね。",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "リゼ",
          "original": "ああ。\\n頑張れよ、チマメ隊。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "シャロ",
          "original": "私だって頑張ってるのに……。\\n牛乳だって飲むようにしてるし……。\\nなのにどうして……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}