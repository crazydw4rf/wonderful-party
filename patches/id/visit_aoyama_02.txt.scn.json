{
  "identity": "visit_aoyama_02.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "青山",
          "original": "今日もお邪魔しますね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "青山さん、こんにちは！\\n今日も小説のアイディア探しですか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "青山",
          "original": "ええ、そうです。\\nここに来ると、落ち着いて考えられますし。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "落ち着いて……ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "え？　なんで私を見るの？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "こんにちは。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "チノ",
          "original": "いらっしゃいませ。\\n今日のお仕事は終わったんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "千夜",
          "original": "ええ。\\nだから、ちょっとお茶しようかと思って\\n寄らせてもらったの。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "青山",
          "original": "千夜さん、こんにちは。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "あら、青山さん。\\n姿が見えないと思ったら、\\n今日はラビットハウスさんだったのね。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "青山",
          "original": "ええ。\\nいつも長時間居座ってしまい、申し訳ありません。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "千夜",
          "original": "いえいえ。\\nまたいつでも来てくださいね。\\nところで、今日も小説のアイディア探し？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "青山",
          "original": "そうなんですが……\\nなかなか思い浮かばずに脱線してしまいました。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "千夜",
          "original": "まあ、かわいい絵。\\nこれはココアちゃんかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "えっ？　私？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "青山",
          "original": "小説のアイディアを書いていくつもりが、\\nついラビットハウスのみなさんを\\n描いてしまいました。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "原稿用紙に何してるんだ！？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "脱線というレベルじゃないです……！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "その隣の、お店の間取りの絵は何かしら？",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "青山",
          "original": "これは、私がラビットハウスを経営するなら、\\nどんなお店にするかを想像して……。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "ま、まさかの乗っ取り！？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "ティッピー",
          "original": "この店は渡さんぞ！！",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "青山",
          "original": "お店にラビットとつくので、白を基調に\\n壁紙を変えるのもいいかもしれません。",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "青山",
          "original": "そして、家具ももう少しポップな物に変えて、\\nかわいらしい空間を演出したいですね。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "千夜",
          "original": "まあ、素敵なお店になりそう。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "確かに、かわいくていいかも～。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "ココアさん！\\n簡単に寝返らないでください！",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "青山",
          "original": "他にも、うさぎをかたどった\\nオムライスを用意したり――",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "青山",
          "original": "みなさんの制服を、思い切ってバニーガールに\\nしてしまうのもよいかもしれませんね。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "青山",
          "original": "それに、店員さんにも二つ名をつけたら\\nぐっと盛り上がりそうです。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "千夜",
          "original": "テーマパークのキャストみたいな感じ？",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "青山",
          "original": "ええ。\\n訪れる人に親しみを持ってもらえる\\n二つ名があったらいいですね。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ココア（Ｍ）",
          "original": "（二つ名かぁ……）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "ココア",
        "original": "（二つ名かぁ……）",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "二つ名とか、なんかプロっぽい！",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "私も自分で考えてみようかな。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "二つ名は考えるものじゃないですよ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "二つ名とか、なんかプロっぽい！\\nぜひ、つけてください！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "青山",
          "original": "では……そうですねぇ……\\nココアさんはいつも元気で明るいから――",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "青山",
          "original": "きらめく太陽の恵み、なんてどうでしょう？",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "いいわね。\\nココアちゃんにぴったりだわ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "きらめく太陽の恵み……。\\nみんなに明るさを振りまく存在ってことだよね！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "青山",
          "original": "ええ、まさにその通りです。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "私は、野菜ジュースのキャッチコピーのような\\n印象ですが……いいんでしょうか？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ティッピー",
          "original": "本人が喜んでいるならいいじゃろ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "私も自分で考えてみようかな。\\n例えば――",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "焼き立ての香る小麦粉のココア！　とか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "青山",
          "original": "的確にココアさんを表していますね。\\n優しい雰囲気も感じられて、素晴らしいです。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "でも、小麦粉なんだかココアなんだか\\nよくわからない名前だな。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "じゃあ、リゼちゃんはどうなの？",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "わ、私か？\\nえっと、そうだな……。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "リゼ",
          "original": "戦場を舞う……勇敢なる風、とかどうだろう？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ティッピー",
          "original": "統一感がないのう。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "リゼ",
          "original": "ち、チノ！",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "すみません。\\n……私が言ったのではありませんが。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ココア",
          "original": "あ、こんなのどう？\\n魔眼の二丁拳銃！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "おお！　それもいいな！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "二つ名は考えるものじゃないですよ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "青山",
          "original": "どういうことでしょう？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "本人が知らないうちに付けられて\\n広まっているのが、なんか格好いいんです！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "青山",
          "original": "ああ……！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "確かに……！\\n本当の戦士は、自分で二つ名を\\n名乗ったりはしない！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "青山",
          "original": "今日はココアさんに教えられました。\\nありがとうございます。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "でも、いろんなアイディアが出て楽しいね。\\n実現したら、ラビットハウスは\\nもっと人気が出るかも！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "ねえねえ、チノちゃんのお父さんに\\n頼んでみようか？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ティッピー",
          "original": "なんじゃと！？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "せ、制服は……これも気に入っているから、\\n日替わりでどうだ？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "私も微力ながら協力するわ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "青山",
          "original": "私もです。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "チノちゃんも賛成だよね？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "いいえ、却下です。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "みんな",
          "original": "ええっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "ココア",
          "original": "なんで～！？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ティッピー",
          "original": "当たり前じゃ。\\nこの店を何だと思っとる。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ティッピー",
          "original": "この店は、息詰まる社会を生きる人々の癒しの場で\\nあるべきじゃ。１杯のコーヒーと静かに\\n向き合う時間を提供することこそ重要であり――",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "チノが語り出した！？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "青山",
          "original": "ふふふ。\\nまるでマスターのようです。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}