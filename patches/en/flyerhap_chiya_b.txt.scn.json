{
  "identity": "flyerhap_chiya_b.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "千夜ちゃん！\\nチラシ配り、一緒にやろっか。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "もちろんいいのだけど、\\n今日はみんな揃って\\n配ることができそうだから、そうしない？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "そうなんだ！\\nじゃあ、せっかくだしみんな揃ってやろう。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "うーん……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "千夜ちゃん、どうしたの？\\n難しい顔してるよ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "ちょっと思い出せないことがあって。\\n占いの名前で、チノちゃんが得意な……\\nカフェ・ド・マンサーだったかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "カフェ・ド・マンシーです。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "チノちゃんのカフェ・ド・マンシーは\\nよく当たるんだよね。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "いえ、私はカプチーノでしか当てられないので。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "それでもすごいわ。\\nでも実はね、私も占いが得意なの。\\n手相なんだけど、チノちゃんをみてもいいかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "はい、ぜひ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "それじゃ……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "千夜",
          "original": "ふんふん……。\\nチノちゃんには、素敵なお姉さんができる\\n相が出てるわね。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "チノ",
          "original": "え……。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "それ、当たりだよ！\\nさすが千夜ちゃんだね。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "へえ、手相って\\nそんな細かいことまでわかるのか。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "リゼ先輩。\\n千夜の言うことを本気にしちゃだめです。\\nあれ、ココアに合わせてるだけですから。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "私も、千夜ちゃんに教えてもらったから\\n少しは手相占いができるんだよ？\\nチノちゃん、見てあげる！",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "チノ",
          "original": "遠慮します。",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "ココア",
          "original": "いいから、いいから。\\nはい、手を出して？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "チノ",
          "original": "はあ……。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "ココア",
          "original": "ほあ～。\\nチノちゃんの手はちっちゃくてかわいいねぇ～。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "チノ",
          "original": "占いは！？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ココア",
          "original": "あ、そうだった。\\nふむふむ、チノちゃんには\\n素敵なお姉ちゃんに甘えるといい相がでてるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "え……。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "さあ、チノちゃん。\\nお姉ちゃんに甘えていいよ？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "チノ",
          "original": "シャロさん。\\n宿題でわからないところがあるので、\\nあとで教えてください。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "シャロ",
          "original": "任せて。\\nチノちゃんは飲み込みが早いから\\n教えるのも楽しいわ。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ココア",
          "original": "そっちのお姉ちゃんじゃないよ～！？",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "千夜",
          "original": "でも当たってるわ。\\nすごいわね、ココアちゃん。\\n私の手相も見てくれないかしら？",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "いいよ。\\nどれどれ、千夜ちゃんの手相は……。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "おお、あずきに愛される相が出てる！\\nまさに甘兎庵を盛り上げるために\\nあるような相だよ。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "千夜",
          "original": "まあ、あずきに愛されるだなんて。\\n考えてもいなかったわ。",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "ココア",
          "original": "道理で、甘兎のお菓子が\\nあんなにおいしいわけだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "千夜",
          "original": "ふふ、そう？\\nありがとう。",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "ココア",
          "original": "あ、あとね、私たちがずーっと仲良しな相も\\n出てるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "千夜",
          "original": "それは、手相を見てもらう前から\\nわかっていたわよ？\\n私たち、親友だものね。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "ココア",
          "original": "えへへ……。\\nじゃあ、次はリゼちゃんを見てあげようかな！",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "リゼ",
          "original": "いや、遠慮しとくよ。\\nていうか、お前は占い、やめておいた方がいいぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "ココア",
          "original": "え？　どうして？",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "リゼ",
          "original": "なんというか……\\nその、あれだ、当たりすぎるからだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "リゼ",
          "original": "今みたいないいことだけなら問題ないけど……\\n自分の身は大切にしろよ。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "ココア",
          "original": "うん？　そうなの？\\nよくわかんないけど、\\n心配してくれてありがとう、リゼちゃん。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}