{
  "identity": "syaro_b04.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "（今日も遅くなっちゃった。\\n　まあ、試験勉強をする必要がなくなったから、\\n　今までよりは時間に余裕があるけど）",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "（でも今日は、なんだかすごく疲れてるのよね。\\n　早く寝たいかも……）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "（って、いけないいけない。\\n　これ以上遅れたら、\\n　本当にどうしようもなくなっちゃう）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "（とりあえず、帰ったら夕食をすませて、\\n　すぐにパーティーのことを――）",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "あっ！\\n夕食、買ってくるの忘れてた！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "（だめね、なんだかボーッとしちゃってる。\\n　とにかく何か買いに――）",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "お帰りなさい、シャロちゃん。\\n遅くまでバイトお疲れ様。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "千夜？\\nどうしたのよ、こんなところで何してるの？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "偶然ね、窓の外に目をやったら、\\nシャロちゃんが帰ってくるところが見えたから\\nお出迎えしてあげようと思って。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "嘘おっしゃい。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "千夜",
          "original": "きゃっ！？\\nどうしたの、急に？\\n私の頬に何かついてた？",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "とぼけるんじゃないの。\\nすっかり体が冷えてるじゃない。\\nわざわざ外で待ってたんでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "千夜",
          "original": "……バレちゃった。\\nふふ、シャロちゃんの手、温かいわ。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "シャロ",
          "original": "それで、何か用？",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "千夜",
          "original": "あ、ちょっと待ってて。\\n店の中に置いてあるから取ってくるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "（取ってくるって？\\n　何か渡すものがあるってことかしら？）",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "千夜",
          "original": "お待たせ。\\nはい、これ、持っていって。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "え？　なにこれ、なんでお重？",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "千夜",
          "original": "夕食、まだでしょう？\\n作りすぎちゃったから、\\nよければ食べてもらおうと思って。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "え……。",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "千夜",
          "original": "中はね、シャロちゃんの好きな物ばかりかも\\nしれないけれど、たまたまなの。\\n私が食べたいなって思ったから作っただけ。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "シャロ",
          "original": "千夜……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "シャロ",
        "original": "千夜……。",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "……ありがと。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "千夜はとぼけるのが下手ね。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "受け取れない。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "……ありがと。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "（作りすぎちゃったなんて\\n　嘘なのがバレバレだけど、\\n　ここは黙って受け取るべきよね）",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "（だって、千夜は\\n　私を心配してくれてるんだから……）",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "本当にありがとね、千夜。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "そんな、余り物なのに感謝されたら困っちゃうわ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "いいじゃない。\\nこの前だって、朝食を作ってもらったし。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "ふふふ、そういえばそうだったわね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "千夜はとぼけるのが下手ね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "え？　なんのこと？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "私の好物ばかり入れておいて、\\n作りすぎちゃったも何もないでしょ？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "それは……。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "だって、作っておいた、なんて言ったら\\nシャロちゃんが遠慮するかもしれないと思って。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "遠慮はしたいけど――",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "そんな余裕はないっていうか。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy3": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "あらあら、そうみたいね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "仕方ないじゃない。\\n夕食買ってくるの、忘れちゃったんだもの。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "じゃあ、受け取ってくれる？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "……うん。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "よかったわ、無駄にならなくて。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "悪いわね。\\nこの前だって、朝食を\\nご馳走になったばかりなのに。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "ああ、そういえばそうね。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "受け取れない。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "千夜",
          "original": "どうして？\\n遠慮なんてしなくていいのよ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "でも、この前だって朝食をご馳走になったし、\\nさすがに悪いわ。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "私とシャロちゃんは、そんなことを\\n気にするような仲じゃないでしょう？",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "千夜",
          "original": "さあ、受け取って？\\nせっかく作ったんだから。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "シャロ",
          "original": "……やっぱり、\\n私のためにわざわざ作ったんじゃない。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "千夜",
          "original": "あら……。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "千夜",
          "original": "細かいことは気にしなくていいの。\\nお腹、空いてるんでしょう？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "シャロ",
          "original": "……わかった。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "千夜",
          "original": "こうして食事の差し入れをしていると、\\nなんだか私、シャロちゃんの通い妻に\\nなったみたいね。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "な、何をばかなこと言ってるのよっ！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "千夜",
          "original": "まあ、シャロちゃんってば照れてるの？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "違うわ、呆れてるだけ！",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "まったくもう。\\n素直に感謝もさせてくれないんだから。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "千夜",
          "original": "だって、面と向かってお礼なんて言われたら、\\n私だってはずかしいもの。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "千夜",
          "original": "なんでもないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "千夜",
          "original": "それじゃ、また明日ね。\\nお重は洗わずに返してくれていいから。\\nおやすみなさい、シャロちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "シャロ",
          "original": "あ、うん。\\nおやすみなさい。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "…………。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "シャロ",
          "original": "（お重、まだ温かい。\\n　私の帰る時間に合わせて作ってくれたんだ。\\n　本当にもう、千夜ってば……）",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "……ありがと。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}