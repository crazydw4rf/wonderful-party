{
  "identity": "visit_syaro_02.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "こんにちは。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "ココア",
          "original": "いらっしゃいませ、シャロちゃん。\\nこちらのお席にどうぞ！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "ありがと。\\n……リゼ先輩は何をしてるんですか？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "リゼ",
          "original": "コーヒー豆を挽いてるんだよ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "そうなんですか。\\nあの、ちょっと見せてもらっててもいいですか？\\n気になるので。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "ああ、いいぞ。\\nうちは１杯ずつ、手挽きのミルでやってるんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "ふうん、機械じゃなくて\\n手でハンドルを回して挽くんですね。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "ティッピー",
          "original": "そう、こうして手で挽くことで、\\nより深いコーヒーの旨味を\\n引き出すことができるのじゃ。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "チノちゃんが熟年の職人みたいなことを\\n言い始めたよ！？",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "リゼ",
          "original": "まあ、機械でも\\nおいしいコーヒーはできると思うけど、\\nそれだと少し味気ない気はするよな。",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "シャロ",
          "original": "わかります！\\n手をかけた分だけ愛着が湧きますよね。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "リゼ",
          "original": "それに、こうして豆を挽くと、いい香りが\\n辺りに広がって……とても贅沢な時間を\\n過ごしているって感じられるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "シャロ",
          "original": "素敵ですね……！\\nあ、あの、リゼ先輩、\\n私もやってみていいですか？",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "リゼ",
          "original": "ああ、構わないぞ。\\nいいよな、チノ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "チノ",
          "original": "はい、構いません。\\nシャロさんがコーヒーに\\n興味を持ってくださって嬉しいです。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "シャロ",
          "original": "それじゃ、さっそく……。\\nんしょ……！",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "リゼ",
          "original": "そうそう、上手だぞ。\\nそのままゆっくりハンドルを回すんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "これ、結構、力がいるんですね。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "慣れるまでは力のかけ方が難しいよな。\\nほら、手伝ってやるよ。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "シャロ",
          "original": "あっ……！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "シャロ",
          "original": "リリリ、リゼ先輩が私に密着して……！\\n後ろから抱きかかえられてるみたいに！\\nやだ、どうしよう！　こ、心の準備が～！",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "リゼ",
          "original": "こんな風にして……\\nそうそう、うん、いい感じに挽けたな。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "シャロ",
          "original": "ほ、本当ですか？\\nありがとうございますっ！",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "リゼ",
          "original": "あ、そうだ、せっかくだし、\\n私がやったのとシャロが挽いたのを\\n飲み比べてみないか？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "ココア",
          "original": "はいはーい！\\nコーヒーの味の批評なら\\n神の舌を持つ私に任せてよ！",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "リゼ",
          "original": "おい、いつからそんな設定がついたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "では、淹れるのは私がやります。\\nちょっと待っていてください。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "リゼ",
          "original": "どうだった、ココア。\\n味の違い、わかったんだろうな？",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "ココア",
          "original": "もちろんだよ。\\n結果は――",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummyselect1": {
      "select_prompt": {
        "speaker": "ココア",
        "original": "もちろんだよ。\\n結果は――",
        "translation": "",
        "status": "untranslated"
      },
      "choices": {
        "*sel_0101": {
          "original": "リゼちゃんの方がおいしかったよ。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0102": {
          "original": "どっちもおいしかったよ。",
          "translation": "",
          "status": "untranslated"
        },
        "*sel_0103": {
          "original": "シャロちゃんも飲んでみて！",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0101": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "リゼちゃんの方がおいしかったよ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "それは当然よ。\\nかじった程度の私がリゼ先輩に敵うわけないわ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "いや、あくまでココアの意見だからな。\\n私はおいしいと思うよ。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "シャロ",
          "original": "あ……いいんです、気にしてませんから。\\nでも、お気遣いありがとうございます。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "あの、リゼ先輩、ありがとうございます。\\nコーヒーは飲めないけど、いい経験になりました。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "シャロ",
          "original": "先輩に、手取り足取り\\n指導してもらっちゃったし……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0102": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "どっちもおいしかったよ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "シャロ",
          "original": "そ、そう？\\nでも、リゼ先輩にはまだ及ばないわよ。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "でも、初めてなのに手つきもなかなかだったし、\\nいつでもうちで働けるな。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "シャロさんでしたら大歓迎です。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "シャロ",
          "original": "ありがと、チノちゃん。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "な、なんだかいい雰囲気になってる！？\\nチノちゃんは私の妹なんだからね！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "チノ",
          "original": "だから、妹じゃありません。",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "あの、リゼ先輩、ありがとうございます。\\nコーヒーは飲めないけど、いい経験になりました。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "先輩に、手取り足取り\\n指導してもらっちゃったし……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_0103": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "シャロちゃんも飲んでみて！",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "はっ！？\\nなんで私を酔わせようとするのよ！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "でも、せっかく自分で挽いた豆なんだし\\n味わってみたいでしょ？\\nほらほら！",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ティッピー",
          "original": "お前は無理やり飲ませたがるオヤジか。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "チノ",
          "original": "これからココアさんのことは\\nお姉ちゃんではなくてオヤジさんと呼びましょう。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ココア",
          "original": "ええええ！？\\nそれは勘弁してー！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "シャロ",
          "original": "あの、リゼ先輩、ありがとうございます。\\nコーヒーは飲めないけど、いい経験になりました。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "シャロ",
          "original": "先輩に、手取り足取り\\n指導してもらっちゃったし……。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*sel_01_join": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "じゃあ、今度、人が足りなくなったら\\nシャロを助っ人に呼ぶか。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "はい、きっとココアさんよりも\\nいい働きをしてくれると思います。",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "ええーっ！？\\nもしかして私、リストラの危機！？",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}