{
  "identity": "flyerhap_rize_e.txt.scn",
  "scenes": {
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "リゼちゃん！\\nチラシ配り、一緒にやらない？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "リゼ",
          "original": "ああ、それなんだが、\\n今日はみんな揃って配ることができそうだぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "じゃあ、せっかくだし、みんなでやろうか。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "ココア",
          "original": "やっぱり軍服姿はリゼちゃんが１番だね。\\nぴしっとしてて、とっても似合うよ。",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy2": {
      "texts": {
        "0": {
          "speaker": "リゼ",
          "original": "そ、そうか？",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "シャロ",
          "original": "はいっ！\\nホント、今の先輩は輝いています！",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "チノ",
          "original": "同じ服なのに、私たちとは違う気がしますね。",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "千夜",
          "original": "ええ。\\n間違いなく、階級が高く見えるわ。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "では今から、リゼちゃんが\\n我々の司令官であります、サー！",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "リゼ",
          "original": "わ、私が司令官か！？\\nよし、では――びしびし行くぞ！",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "ではさっそく、チラシ配りの作戦を\\n教えてください、サー！",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "リゼ",
          "original": "ええっ？\\nそ、それは……。",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア＆チノ＆千夜＆シャロ",
          "original": "じーっ……。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "リゼ",
          "original": "そ、そうだな……。\\nでは――",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "リゼ",
          "original": "最もチラシを配った者に、勲章を授与する！",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "勲章？\\nそれってよく頑張ったっていうご褒美だよね？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "リゼ",
          "original": "まあ、かみ砕いて言うとそういう感じだな。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "ご褒美！\\nやった、楽しみだなぁ。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "リゼ",
          "original": "そうか？\\nそんなに嬉しいか？",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "千夜",
          "original": "ええ、１番頑張ったんだって\\n褒められるんだから、嬉しいものよ？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "私も、リゼさんの勲章、欲しいです。\\nココアさんには負けません。",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "シャロ",
          "original": "ココアにも千夜にも、チノちゃんにだって\\nリゼ先輩の勲章は渡さないわ……！",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "リゼ",
          "original": "よし！　みんな、気合が入ったようだな。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "リゼ",
          "original": "では、今から１時間で\\nどれだけチラシを配ったかを競うことにする。\\n１時間後、ここに戻ってくるように！",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "リゼ",
          "original": "よし、それじゃ、結果を見させてもらおう。\\nまずチノは……\\nおお、なかなか減ってるじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "本当はもっと配りたかったのですが……\\n上手くいきませんでした。",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "リゼ",
          "original": "千夜は……\\nあれ、チノより残り枚数が多いぞ？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "千夜",
          "original": "張り切りすぎて、途中で疲れちゃって……\\nここまで歩いてくるのも大変だったわ。",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "リゼ",
          "original": "次はシャロか。\\nへえ、もう残りわずかじゃないか。",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "シャロ",
          "original": "はい、全力で配りました！\\nこれでリゼ先輩の勲章は私のものですね。",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "リゼ",
          "original": "まだわからないぞ？\\nココアがいるからな。\\nよしココア、見せてみろ。",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "じゃーん。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "シャロ",
          "original": "って、何？\\nなんで手を広げて……。",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "全部、配り終わりました～！",
          "translation": "",
          "status": "untranslated"
        },
        "30": {
          "speaker": "シャロ",
          "original": "ええええええ～！？",
          "translation": "",
          "status": "untranslated"
        },
        "31": {
          "speaker": "チノ",
          "original": "す、すごいです、ココアさん！",
          "translation": "",
          "status": "untranslated"
        },
        "32": {
          "speaker": "千夜",
          "original": "シャロちゃん、残念だけど\\nココアちゃんの勝ちみたいね。",
          "translation": "",
          "status": "untranslated"
        },
        "33": {
          "speaker": "シャロ",
          "original": "ううう……。\\nリゼ先輩の勲章が……。",
          "translation": "",
          "status": "untranslated"
        },
        "34": {
          "speaker": "リゼ",
          "original": "よし、ココアには約束通り勲章を渡そう。\\n気に入ってもらえるかわからないが……。",
          "translation": "",
          "status": "untranslated"
        },
        "35": {
          "speaker": "ココア",
          "original": "うわあ～！\\nこれってコサージュ？\\n１時間で作っちゃったの？",
          "translation": "",
          "status": "untranslated"
        },
        "36": {
          "speaker": "リゼ",
          "original": "あ、ああ。\\nそこの花屋で花を買って\\n即席で作ったんだが……どうだ？",
          "translation": "",
          "status": "untranslated"
        },
        "37": {
          "speaker": "ココア",
          "original": "きれいでかわいい～！\\n頑張ったかいがあったよ。",
          "translation": "",
          "status": "untranslated"
        },
        "38": {
          "speaker": "シャロ",
          "original": "ホント、かわいい……。\\n私も欲しかった……。",
          "translation": "",
          "status": "untranslated"
        },
        "39": {
          "speaker": "チノ",
          "original": "私もです……。",
          "translation": "",
          "status": "untranslated"
        },
        "40": {
          "speaker": "千夜",
          "original": "ええ、残念ねぇ。",
          "translation": "",
          "status": "untranslated"
        },
        "41": {
          "speaker": "リゼ",
          "original": "あの、それでな？\\n実は努力賞も用意したんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "42": {
          "speaker": "シャロ",
          "original": "努力賞ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "43": {
          "speaker": "リゼ",
          "original": "３人のコサージュも用意してあるんだ。\\nほら、受け取ってくれ。",
          "translation": "",
          "status": "untranslated"
        },
        "44": {
          "speaker": "チノ",
          "original": "えっ……！\\nあ、ありがとうございます。",
          "translation": "",
          "status": "untranslated"
        },
        "45": {
          "speaker": "千夜",
          "original": "まあ、緑と白の花の組み合わせだなんて。\\nかわいいわ、ありがとう。",
          "translation": "",
          "status": "untranslated"
        },
        "46": {
          "speaker": "シャロ",
          "original": "リゼ先輩……！\\nありがとうございますっ！",
          "translation": "",
          "status": "untranslated"
        },
        "47": {
          "speaker": "リゼ",
          "original": "ココア。\\nなんていうか……悪いな。\\n結局、全員に渡すことになってしまって。",
          "translation": "",
          "status": "untranslated"
        },
        "48": {
          "speaker": "ココア",
          "original": "ううん、みんな頑張ったんだから\\nみんながもらっていいんだよ。\\nさすが、リゼちゃんは優しいね。",
          "translation": "",
          "status": "untranslated"
        },
        "49": {
          "speaker": "リゼ",
          "original": "ありがとう、ココア。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}