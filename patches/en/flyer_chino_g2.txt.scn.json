{
  "identity": "flyer_chino_g2.txt.scn",
  "scenes": {
    "*start": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "（今日はチノちゃんと\\n　姉妹でチラシ配りをしようっと！）",
          "translation": "",
          "status": "untranslated"
        }
      }
    },
    "*dummy1": {
      "texts": {
        "0": {
          "speaker": "ココア",
          "original": "じー……。",
          "translation": "",
          "status": "untranslated"
        },
        "1": {
          "speaker": "チノ",
          "original": "……なんですか、ココアさん？",
          "translation": "",
          "status": "untranslated"
        },
        "2": {
          "speaker": "ココア",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "3": {
          "speaker": "チノ",
          "original": "チラシも配らないで、\\nさっきからずっとこっちを\\n見ているじゃないですか。",
          "translation": "",
          "status": "untranslated"
        },
        "4": {
          "speaker": "ココア",
          "original": "違うの。\\nチノちゃんじゃなくて、ティッピーを見てたんだ。",
          "translation": "",
          "status": "untranslated"
        },
        "5": {
          "speaker": "ティッピー",
          "original": "わしか？",
          "translation": "",
          "status": "untranslated"
        },
        "6": {
          "speaker": "ココア",
          "original": "チノちゃんの格好に、\\nティッピーがよく似合ってるなと思って。",
          "translation": "",
          "status": "untranslated"
        },
        "7": {
          "speaker": "チノ",
          "original": "え？",
          "translation": "",
          "status": "untranslated"
        },
        "8": {
          "speaker": "ココア",
          "original": "ほら、この衣装って魔女みたいでしょ？\\nそれで、魔女にはお供の動物がよくいるよね。",
          "translation": "",
          "status": "untranslated"
        },
        "9": {
          "speaker": "チノ",
          "original": "ああ、なるほど。\\nティッピーが私の使い魔に見えるんですね？",
          "translation": "",
          "status": "untranslated"
        },
        "10": {
          "speaker": "ティッピー",
          "original": "従僕扱いとは心外じゃ。",
          "translation": "",
          "status": "untranslated"
        },
        "11": {
          "speaker": "ココア",
          "original": "えー？\\n使い魔ってかっこいいよ？",
          "translation": "",
          "status": "untranslated"
        },
        "12": {
          "speaker": "チノ",
          "original": "かっこいいかはともかく、\\n定番であることは確かですね。",
          "translation": "",
          "status": "untranslated"
        },
        "13": {
          "speaker": "ココア",
          "original": "私も欲しいなぁ、使い魔。",
          "translation": "",
          "status": "untranslated"
        },
        "14": {
          "speaker": "ココア",
          "original": "あ、そうだ！\\nこの子になってもらおうっと。",
          "translation": "",
          "status": "untranslated"
        },
        "15": {
          "speaker": "ココア",
          "original": "いい子いい子～。\\nちょーっと大人しくしててね？",
          "translation": "",
          "status": "untranslated"
        },
        "16": {
          "speaker": "チノ",
          "original": "ココアさん、何をするんです？",
          "translation": "",
          "status": "untranslated"
        },
        "17": {
          "speaker": "ココア",
          "original": "チノちゃんの真似をして、\\n頭に乗せてみようと思って。",
          "translation": "",
          "status": "untranslated"
        },
        "18": {
          "speaker": "チノ",
          "original": "いえ、相手は野良うさぎですから\\nそれは難しいんじゃ……。",
          "translation": "",
          "status": "untranslated"
        },
        "19": {
          "speaker": "ココア",
          "original": "ああっ！？",
          "translation": "",
          "status": "untranslated"
        },
        "20": {
          "speaker": "ティッピー",
          "original": "ほぇぇい！？",
          "translation": "",
          "status": "untranslated"
        },
        "21": {
          "speaker": "チノ",
          "original": "ココアさん！\\n大丈夫ですか？",
          "translation": "",
          "status": "untranslated"
        },
        "22": {
          "speaker": "ココア",
          "original": "平気だよ！\\n飛び跳ねて逃げられちゃっただけだから。\\nやっぱり乗せるのは無理があったかな？",
          "translation": "",
          "status": "untranslated"
        },
        "23": {
          "speaker": "ココア",
          "original": "……あれ？\\nチノちゃん、ティッピーは？",
          "translation": "",
          "status": "untranslated"
        },
        "24": {
          "speaker": "チノ",
          "original": "そういえば――",
          "translation": "",
          "status": "untranslated"
        },
        "25": {
          "speaker": "ティッピー",
          "original": "あ”あ”あ”あ”あ”あ”っ！！",
          "translation": "",
          "status": "untranslated"
        },
        "26": {
          "speaker": "チノ",
          "original": "ティッピー！？",
          "translation": "",
          "status": "untranslated"
        },
        "27": {
          "speaker": "ココア",
          "original": "あの子に追われてるねー。\\n使い魔対決だ。",
          "translation": "",
          "status": "untranslated"
        },
        "28": {
          "speaker": "チノ",
          "original": "のんきなことを言ってないで、\\n助けに行きますよ！",
          "translation": "",
          "status": "untranslated"
        },
        "29": {
          "speaker": "ココア",
          "original": "はーい。",
          "translation": "",
          "status": "untranslated"
        }
      }
    }
  }
}